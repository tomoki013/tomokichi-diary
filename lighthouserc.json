{
  "ci": {
    "collect": {
      "staticDistDir": "apps/web/dist",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/posts.html",
        "http://localhost/posts/chagee-menu-explained.html",
        "http://localhost/destination/japan.html",
        "http://localhost/destination/japan/kyoto.html",
        "http://localhost/collections/paris-2025-02.html"
      ],
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".artifacts/ci/lighthouse"
    }
  }
}
