---
import type { CollectionId, Route } from "@tomokichi/domain";
import { buildBreadcrumbJsonLd, buildPageMetadata } from "@tomokichi/seo";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Picture from "../components/Picture.astro";
import SeriesMusic from "../components/SeriesMusic.astro";
import { content } from "../lib/content";
import { collectionTrail } from "../lib/navigation";
import { seriesMusicOf } from "../lib/series-music";
import { mediaUrl, seoConfig } from "../lib/site";

interface Props {
  route: Route;
}

const { route } = Astro.props;
const collectionId = (route.targetId ?? "") as CollectionId;
const collection = content.collection(collectionId);
const members = content.membersOf(collectionId);
const cover =
  content.snapshot.media.find((media) => media.id === collection?.coverMediaId) ??
  members.find((member) => member.cover)?.cover?.asset ??
  null;

const title = collection?.title ?? "";
const seriesMusic = collection ? seriesMusicOf([collection]) : [];
const trail = collectionTrail(route, title);
const period =
  collection?.startDate &&
  (collection.endDate && collection.endDate !== collection.startDate
    ? `${collection.startDate} 〜 ${collection.endDate}`
    : collection.startDate);

const kindLabel = collection?.kind === "journey" ? "旅程コレクション" : "テーマコレクション";
const places = [
  ...new Set(
    members.flatMap((view) =>
      view.locations.map(({ location }) => content.locations.nameOf(location.id, "ja")),
    ),
  ),
].slice(0, 6);

// A search result shows about 120 characters. A one-line description written
// for the page heading says too little there, so it is followed by what the
// collection holds: when the trip was, where it went, how many articles.
const written = collection?.description?.replace(/\s+/g, " ").trim() ?? "";
const month = (date: string) => `${Number(date.slice(0, 4))}年${Number(date.slice(5, 7))}月`;
const placeList = places.slice(0, 3).join("・");
const facts =
  collection?.kind === "journey"
    ? [
        collection.startDate ? `${month(collection.startDate)}の旅で、` : "",
        placeList ? `${placeList}を巡った` : "",
        `${members.length}本の記事をまとめています。`,
      ].join("")
    : places.length === 1 && members.length === 1
      ? `${placeList}の記事を1本まとめています。`
      : `${placeList ? `${placeList}など、` : ""}${members.length}本の記事をまとめています。`;
const description =
  written.length >= 70
    ? written
    : `${written}${written && !/[。！？]$/.test(written) ? "。" : ""}${facts}`;

const metadata = buildPageMetadata(seoConfig, {
  title,
  description,
  route,
  imageUrl: cover ? mediaUrl(cover.storageKey) : null,
  // A collection with no published article yet is reachable but kept out of
  // search until it has something to read (the sitemap applies the same rule).
  noindex: route.noindex || members.length === 0,
});
const otherCollections = content.snapshot.collections
  .filter((item) => item.id !== collectionId && item.kind === collection?.kind)
  .flatMap((item) => {
    const itemRoute = content.routes.canonicalFor(item.kind, item.id);
    const count = content.membersOf(item.id).length;
    return itemRoute && count > 0 ? [{ item, route: itemRoute, count }] : [];
  })
  .slice(0, 3);
---

<BaseLayout metadata={metadata} jsonLd={[buildBreadcrumbJsonLd(seoConfig, trail)]}>
  <div
    class:list={[
      "collection-detail",
      collection?.kind === "journey" ? "collection-detail--journey" : "collection-detail--series",
    ]}
  >
    <Breadcrumbs trail={trail} />
    <header class:list={["collection-detail__hero", !cover && "collection-detail__hero--plain"]}>
      {cover && (
        <Picture
          storageKey={cover.storageKey}
          alt={title}
          sizes="(max-width: 760px) 100vw, 1100px"
          loading="eager"
          fetchpriority="high"
        />
      )}
      <span class="collection-detail__shade"></span>
      <div class="collection-detail__copy">
        <small>{kindLabel}</small>
        <h1>{title}</h1>
        {collection?.description && <p>{collection.description}</p>}
        <div>
          {period && <span>{period.replaceAll("-", ".")}</span>}
          <span>{members.length}本の記事</span>
        </div>
      </div>
    </header>

    {seriesMusic.length > 0 && <SeriesMusic entries={seriesMusic} pageType="collection" />}

    <section class="collection-overview" aria-label="コレクション概要">
      <div>
        <small>このコレクションについて</small>
        <p>
          {collection?.kind === "journey"
            ? "旅の始まりから終わりまで、実際に歩いた順番で読めます。移動や失敗も含めて、一つの旅としてまとめました。"
            : "同じテーマで心に残った景色や体験を、国や時期を越えて集めています。"}
        </p>
      </div>
      {places.length > 0 && (
        <div class="collection-overview__places">
          <>
            <small>登場する旅先</small>
            <p>{places.join("、")}</p>
          </>
        </div>
      )}
    </section>

    <section class="collection-members" aria-labelledby="collection-members-heading">
      <div class="collection-members__heading">
        <div>
          <small>{collection?.kind === "journey" ? "旅の順路" : "収録記事"}</small>
          <h2 id="collection-members-heading">
            {collection?.kind === "journey" ? "この旅を順番に読む" : "テーマを深く読む"}
          </h2>
        </div>
        <span>{members.length} posts</span>
      </div>
      <ol>
        {members.map((view, index) => {
          const location = content.primaryLocationOf(view.article.id);
          return (
            <li>
              <span class="collection-member__number">{String(index + 1).padStart(2, "0")}</span>
              <a
                href={view.route.path}
                class="collection-member__media"
                tabindex="-1"
                aria-hidden="true"
              >
                {view.cover && (
                  <Picture
                    storageKey={view.cover.asset.storageKey}
                    alt={view.cover.usage.alt}
                    sizes="(max-width: 760px) 42vw, 320px"
                    loading={index < 2 ? "eager" : "lazy"}
                  />
                )}
              </a>
              <div class="collection-member__copy">
                <small>
                  {location ? content.locations.nameOf(location.id, "ja") : `第${index + 1}話`}
                  {view.article.publishedAt &&
                    ` · ${view.article.publishedAt.slice(0, 10).replaceAll("-", ".")}`}
                </small>
                <h3>
                  <a href={view.route.path}>{view.revision.title}</a>
                </h3>
                <p>{view.revision.summary}</p>
                <a href={view.route.path}>記事を読む</a>
              </div>
            </li>
          );
        })}
      </ol>
      {members.length === 0 && (
        <p class="collection-members__empty">このシリーズの記事は準備中です。</p>
      )}
    </section>

    {otherCollections.length > 0 && (
      <section class="collection-next">
        <>
          <small>ほかのコレクション</small>
          <h2>次は、どの旅をたどる？</h2>
          <div>
            {otherCollections.map(({ item, route: itemRoute, count }) => (
              <a href={itemRoute.path}>
                <strong>{item.title}</strong>
                <span>{count}本の記事</span>
              </a>
            ))}
          </div>
        </>
      </section>
    )}
  </div>
</BaseLayout>
