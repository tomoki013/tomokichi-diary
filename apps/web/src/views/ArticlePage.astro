---
import { buildKnowledgeCatalog, type ArticleView } from "@tomokichi/application";
import { publicModifiedAt, type Route } from "@tomokichi/domain";
import { buildArticleJsonLd, buildArticleMetadata, buildBreadcrumbJsonLd } from "@tomokichi/seo";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ArticleBody from "../components/ArticleBody.astro";
import AdAssignment from "../components/AdAssignment.astro";
import AffiliateBlock from "../components/AffiliateBlock.astro";
import { buildAffiliatePlan, buildAdPlan } from "../lib/monetization";
import ArticleAd from "../components/ArticleAd.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Picture from "../components/Picture.astro";
import { content } from "../lib/content";
import { articleTrail } from "../lib/navigation";
import { mediaUrl, seoConfig } from "../lib/site";
import LikeButton from "../components/LikeButton.astro";
import ArticleToc from "../components/ArticleToc.astro";
import ArticleTocInline from "../components/ArticleTocInline.astro";
import JourneyProgress from "../components/JourneyProgress.astro";
import NextRead from "../components/NextRead.astro";
import { articleHeadings } from "../lib/article-headings";
import { getEntry } from "astro:content";
import { renderArticleMarkdown } from "@tomokichi/contracts";
import ArticleKnowledge from "../components/ArticleKnowledge.astro";
import ShareButton from "../components/ShareButton.astro";
import CopyLinkButton from "../components/CopyLinkButton.astro";
import { ChevronLeftIcon, ChevronRightIcon } from "../components/TravelIcons";
import WebMcpTools from "../components/WebMcpTools.astro";
import ExperienceChips from "../components/ExperienceChips.astro";
import SeriesMusic from "../components/SeriesMusic.astro";
import { seriesMusicOf } from "../lib/series-music";
import StoryRail from "../components/StoryRail.astro";
import PlaceStories from "../components/PlaceStories.astro";
import { EXPERIENCE_COPY, experienceHref } from "../lib/experiences";
import { snapshot } from "../lib/content";

interface Props {
  view: ArticleView;
  route: Route;
}

const { view, route } = Astro.props;
const { article, revision, cover, author } = view;
const body = (await getEntry("articles", article.slug))?.body;
const headings = articleHeadings(body === undefined ? null : renderArticleMarkdown(body));
const adPlan = buildAdPlan(
  snapshot.monetization?.find((c) => c.articleId === article.id),
  revision.bodyMarkdown,
  {
    placements: process.env.MONETIZATION_PLACEMENTS_ENABLED !== "false",
    experiments: process.env.AD_EXPERIMENTS_ENABLED !== "false",
  },
);

const affiliates = buildAffiliatePlan(
  snapshot.monetization?.find((c) => c.articleId === article.id),
  revision.bodyMarkdown,
  process.env.AFFILIATE_ENABLED !== "false",
);

// `mediaUrl` is already absolute (the media domain), so it must not be run
// through `absoluteUrl` as well — that produced `https://site/https://media/…`
// on every share card. `check:seo` now fails on that shape.
const coverUrl = cover ? mediaUrl(cover.asset.storageKey) : null;
const metadata = buildArticleMetadata(seoConfig, {
  article,
  revision,
  route,
  coverImageUrl: coverUrl,
  authorName: author?.name ?? null,
});
const trail = articleTrail(article.id, route);

const jsonLd = [
  buildArticleJsonLd(seoConfig, {
    article,
    revision,
    route,
    description: metadata.description,
    coverImageUrl: coverUrl,
    author: author ? { name: author.name, url: author.url } : null,
    about: [...view.places, ...view.locations].map((entry) =>
      "place" in entry ? entry.place : entry.location,
    ),
  }),
  buildBreadcrumbJsonLd(seoConfig, trail),
];

const related = content.relatedTo(article.id, 3);
const placeStories = content.placeStoriesFor(article.id);
// Two more ways on from a story — how it felt, and where it happened — each
// skipping what the rails before it already offer.
const shown = new Set([article.id, ...related.map((item) => item.article.id)]);
const sameFeeling = content.sharingExperience(article.id, 3, shown);
for (const item of sameFeeling) shown.add(item.article.id);
const country = content.countryOf(article.id);
const samePlace = content.inSameCountry(article.id, 3, shown);
const countryRoute = country ? content.routes.canonicalFor("location", country.id) : undefined;
const countryName = country ? content.locations.nameOf(country.id, "ja") : null;
const leadExperience = article.experienceTags[0];
const published = article.publishedAt?.slice(0, 10);
const updated = publicModifiedAt(article, revision).slice(0, 10);
const travel =
  article.travelStartDate &&
  (article.travelEndDate && article.travelEndDate !== article.travelStartDate
    ? `${article.travelStartDate} 〜 ${article.travelEndDate}`
    : article.travelStartDate);
const readingMinutes = Math.max(
  1,
  Math.ceil(
    revision.bodyMarkdown.replace(/\{\{monetization:[^}\n]*\}\}/g, "").replace(/\s/g, "").length /
      500,
  ),
);
const locationLinks = view.locations.flatMap(({ location }) => {
  const locationRoute = content.routes.canonicalFor("location", location.id);
  return locationRoute
    ? [{ name: content.locations.nameOf(location.id, "ja"), path: locationRoute.path }]
    : [];
});
// The overview above the body already links the first three places; the
// taxonomy row repeated them right below, pushing the article further down.
const extraLocationLinks = locationLinks.slice(3);
const articleViews = content.publicArticles().flatMap((item) => {
  if (item.kind !== "article") return [];
  const itemView = content.viewOf(item.id);
  return itemView ? [itemView] : [];
});
const currentIndex = articleViews.findIndex((item) => item.article.id === article.id);
const previousArticle = currentIndex >= 0 ? articleViews[currentIndex + 1] : undefined;
const nextArticle = currentIndex > 0 ? articleViews[currentIndex - 1] : undefined;
// A trip told in episodes: where this one sits, and which comes next.
// A journey also holds the guides written from the trip; the episodes are the
// members that are also in the travel-diary series.
const ownCollections = content.collectionsOf(article.id);
const diary = ownCollections.find((item) => item.kind === "series" && item.slug === "travel-diary");
const journey = diary ? ownCollections.find((item) => item.kind === "journey") : undefined;
const diaryIds = new Set(diary ? content.membersOf(diary.id).map((item) => item.article.id) : []);
const journeyMembers = journey
  ? content.membersOf(journey.id).filter((item) => diaryIds.has(item.article.id))
  : [];
const episode = journeyMembers.findIndex((item) => item.article.id === article.id) + 1;
const journeyRoute = journey ? content.routes.canonicalFor("journey", journey.id) : undefined;
// The one card to go on to after the story: the trip's next episode, then the
// articles the author linked (the last link first, since closing links are
// usually the next step), then the related ones.
const viewByPath = new Map(articleViews.map((item) => [item.route.path, item]));
const linkedFromBody = [...revision.bodyMarkdown.matchAll(/\]\(([^)\s]+)\)/g)]
  .flatMap((match) => {
    try {
      const path = new URL(match[1]!, `https://tomokichidiary.com${view.route.path}`).pathname;
      const linked = viewByPath.get(path.replace(/\/+$/, ""));
      return linked ? [linked] : [];
    } catch {
      return [];
    }
  })
  .toReversed();
const nextEpisode = episode > 0 ? journeyMembers[episode] : undefined;
const nextReadCandidates = [
  ...(nextEpisode ? [{ view: nextEpisode, label: `この旅の続き・第${episode + 1}回` }] : []),
  ...linkedFromBody.map((item) => ({ view: item, label: "この記事で紹介した記事" })),
  ...related.map((item) => ({ view: item, label: "あわせて読みたい" })),
]
  .filter(
    (item, index, all) =>
      item.view.article.id !== article.id &&
      all.findIndex((other) => other.view.article.id === item.view.article.id) === index,
  )
  .slice(0, 1);
const knowledge = content.knowledgeOf(article.id);
const seriesMusic = seriesMusicOf(content.collectionsOf(article.id));
const knowledgeCatalog = buildKnowledgeCatalog(snapshot);
---

<BaseLayout metadata={metadata} jsonLd={jsonLd} width="wide">
  <WebMcpTools catalog={knowledgeCatalog} articleId={article.id} />
  <AdAssignment plan={adPlan} />
  <article
    class="article-page"
    data-ad-layout={adPlan.layout}
    data-ad-key={adPlan.marker?.key ?? "article-end"}
    data-ad-key-a={adPlan.markerA?.key}
  >
    <Breadcrumbs trail={trail} />
    <header class="article-hero">
      <div class="article-hero__content">
        {view.categories.length > 0 && <p class="eyebrow">{view.categories[0]?.name}</p>}
        <h1>{revision.title}</h1>
        <ExperienceChips tags={article.experienceTags} />
        <p class="article-hero__summary">{revision.summary}</p>
        <div class="article-hero__meta">
          {published && (
            <span>
              公開 <time datetime={published}>{published}</time>
            </span>
          )}
          {updated !== published && (
            <span>
              更新 <time datetime={updated}>{updated}</time>
            </span>
          )}
          <span>読了 約{readingMinutes}分</span>
        </div>
      </div>
      {cover && (
        <div class="article-hero__media">
          <Picture
            storageKey={cover.asset.storageKey}
            alt={cover.usage.alt}
            sizes="(max-width: 46rem) 92vw, (max-width: 1184px) calc(100vw - 64px), 1120px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )}
    </header>

    <div class="article-intro">
      <div class="article-author">
        <span class="article-author__mark" aria-hidden="true">
          旅
        </span>
        <div>
          <small>WRITTEN BY</small>
          <strong>{author?.name ?? "ともきち"}</strong>
        </div>
      </div>
      {travel || locationLinks.length > 0 ? (
        <dl class="article-overview">
          {travel && (
            <div>
              <dt>旅した時期</dt>
              <dd>{travel.replaceAll("-", ".")}</dd>
            </div>
          )}
          {locationLinks.length > 0 && (
            <div>
              <dt>場所</dt>
              <dd>
                {locationLinks.slice(0, 3).map((location) => (
                  <a href={location.path}>{location.name}</a>
                ))}
              </dd>
            </div>
          )}
          <div class="article-overview__reading">
            <dt>読了</dt>
            <dd>約{readingMinutes}分</dd>
          </div>
        </dl>
      ) : (
        <p>{revision.summary}</p>
      )}
      <LikeButton articleId={article.id} title={revision.title} path={route.path} />
    </div>

    {journey && episode > 0 && journeyMembers.length > 1 && (
      <JourneyProgress
        title={journey.title}
        path={journeyRoute?.path ?? null}
        episode={episode}
        total={journeyMembers.length}
      />
    )}

    {seriesMusic.length > 0 && <SeriesMusic entries={seriesMusic} pageType="article" />}

    <div class="article-layout">
      <div class="article-main">
        {(view.categories.length + view.tags.length > 0 || extraLocationLinks.length > 0) && (
          <div class="article-taxonomy">
            {extraLocationLinks.map((location) => (
              <a href={location.path}>⌖ {location.name}</a>
            ))}
            {view.categories.map((category) => (
              <span>{category.name}</span>
            ))}
            {view.tags.slice(0, 5).map((tag) => (
              <span>#{tag.name}</span>
            ))}
          </div>
        )}
        <ArticleTocInline headings={headings} />
        {knowledge && <ArticleKnowledge view={knowledge} />}
        {affiliates.length > 0 && !view.embeds.some((embed) => embed.type === "notice") && (
          <p class="notice">
            この記事には広告・アフィリエイトリンクが含まれます。
            <a href="/legal/affiliates">紹介の方針</a>
          </p>
        )}
        <ArticleBody
          slug={article.slug}
          embeds={view.embeds}
          path={view.route.path}
          adPlan={adPlan}
          affiliates={affiliates}
        />
        {affiliates
          .filter((p) => p.position === "article_end")
          .map((p) => (
            <AffiliateBlock placement={p} />
          ))}
        {placeStories.length > 0 && <PlaceStories views={placeStories} />}
        {adPlan.end && <ArticleAd unit={adPlan.end.unit} variant={adPlan.end.variant} />}
        <NextRead candidates={nextReadCandidates} />
        {/* The articles sharing this one's tags and places come first: a reader
            who just finished is looking for the next thing on the same subject
            (the experience and country rails below drift further away). */}
        {related.length > 0 && (
          <section
            class="article-related article-related--inline"
            aria-labelledby="related-heading"
          >
            <p class="eyebrow">KEEP EXPLORING</p>
            <h2 id="related-heading">次に読みたい旅の記録</h2>
            <ul class="card-grid">
              {related.map((item) => (
                <ArticleCard view={item} level={3} />
              ))}
            </ul>
          </section>
        )}
        <footer class="article-endnote">
          <div>
            <strong>最後まで読んでいただき、ありがとうございます。</strong>
            <p>この記録が、次の旅の小さなきっかけになればうれしいです。</p>
          </div>
          <LikeButton articleId={article.id} title={revision.title} path={route.path} />
        </footer>
        <div class="article-share">
          <div>
            <small>SHARE THE JOURNEY</small>
            <strong>旅のワクワクを、誰かにも。</strong>
          </div>
          <div class="article-share__actions">
            <CopyLinkButton url={metadata.canonical} title={revision.title} />
            <ShareButton title={revision.title} text={revision.summary} url={metadata.canonical} />
          </div>
        </div>
        {(previousArticle || nextArticle) && (
          <nav class="post-navigation" aria-label="前後の記事">
            {previousArticle ? (
              <a
                href={previousArticle.route.path}
                class="post-navigation__card post-navigation__card--previous"
              >
                <span>
                  <ChevronLeftIcon /> 前の記事
                </span>
                <strong>{previousArticle.revision.title}</strong>
              </a>
            ) : (
              <span />
            )}
            {nextArticle ? (
              <a
                href={nextArticle.route.path}
                class="post-navigation__card post-navigation__card--next"
              >
                <span>
                  次の記事 <ChevronRightIcon />
                </span>
                <strong>{nextArticle.revision.title}</strong>
              </a>
            ) : (
              <span />
            )}
          </nav>
        )}
      </div>
      <div class="article-sidebar">
        <ArticleToc />
        <aside class="article-facts">
          <p class="eyebrow">TRIP NOTES</p>
          {article.experienceTags.length > 0 && (
            <div>
              <small>この旅は</small>
              <ExperienceChips tags={article.experienceTags} />
            </div>
          )}
          {travel && (
            <div>
              <small>旅した時期</small>
              <strong>{travel.replaceAll("-", ".")}</strong>
            </div>
          )}
          {locationLinks[0] && <a href={locationLinks[0].path}>この旅先の記事を見る →</a>}
        </aside>
      </div>
    </div>
  </article>

  {(sameFeeling.length > 0 || samePlace.length > 0) && (
    <section class="section story-trail" aria-labelledby="story-trail-heading">
      <p class="eyebrow">STORY TRAIL</p>
      <h2 id="story-trail-heading">この旅の話の、その先へ</h2>
      <div class="story-trail__rails">
        {sameFeeling.length > 0 && leadExperience && (
          <StoryRail
            title="同じ気持ちになれる旅の話"
            note={`「${EXPERIENCE_COPY[leadExperience].label}」をもっと`}
            views={sameFeeling}
            more={{ href: experienceHref(leadExperience), label: "この気分の旅をすべて見る" }}
          />
        )}
        {samePlace.length > 0 && countryName && (
          <StoryRail
            title={`${countryName}の旅の話`}
            note="同じ土地で書いたもの"
            views={samePlace}
            more={
              countryRoute
                ? { href: countryRoute.path, label: `${countryName}の記事をすべて見る` }
                : null
            }
          />
        )}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  import { mountReaderMeasurement } from "../lib/readerMeasurement";
  import { markRead } from "../lib/readMarks";
  mountReaderMeasurement();
  // Read means the last paragraph came into view.
  const last = document.querySelector(".article-content > :last-child");
  if (last && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      markRead(location.pathname);
      observer.disconnect();
    });
    observer.observe(last);
  }
</script>
