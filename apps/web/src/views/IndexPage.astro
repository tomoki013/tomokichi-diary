---
import type { Route } from "@tomokichi/domain";
import { buildBreadcrumbJsonLd, buildPageMetadata } from "@tomokichi/seo";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { content } from "../lib/content";
import Picture from "../components/Picture.astro";
import { mediaUrl, seoConfig, siteDescription } from "../lib/site";
import WorldMap from "../components/WorldMap.astro";
import { visitedContinents } from "../lib/destinations";
import { bestEpisodes } from "../lib/editorial";
import { EXPERIENCES } from "../lib/experiences";
import { SearchIcon, XIcon } from "../components/TravelIcons";

interface Props {
  route: Route;
}

const { route } = Astro.props;
const articles = content.articleViews();

const PAGES: Record<string, { title: string; description: string }> = {
  "/": { title: seoConfig.siteName, description: siteDescription },
  "/posts": {
    title: "記事一覧",
    description: `公開しているすべての記事${articles.length}件を新しい順に掲載しています。`,
  },
  "/destination": {
    title: "旅先から探す",
    description: "訪れた国と都市ごとに、観光情報や移動手段、費用の記録をまとめています。",
  },
  "/collections": {
    title: "コレクション",
    description: "テーマごとの連載と、旅程ごとの記録をまとめています。",
  },
  "/gallery": { title: "ギャラリー", description: "旅先で撮影した写真をまとめています。" },
  "/sitemap": { title: "サイトマップ", description: "サイト内のすべてのページの一覧です。" },
};

const page = PAGES[route.path] ?? { title: seoConfig.siteName, description: siteDescription };
const metadata = buildPageMetadata(seoConfig, {
  title: page.title,
  description: page.description,
  route,
  noindex: route.noindex,
});

const trail =
  route.path === "/"
    ? []
    : [
        { name: "ホーム", route: { path: "/" } as Route },
        { name: page.title, route },
      ];

const continents = visitedContinents();

const collections = (kind: "series" | "journey") =>
  content.snapshot.collections
    .filter((collection) => collection.kind === kind)
    .flatMap((collection) => {
      const hub = content.routes.canonicalFor(kind, collection.id);
      const members = content.membersOf(collection.id);
      const cover =
        content.snapshot.media.find((media) => media.id === collection.coverMediaId) ??
        members.find((member) => member.cover)?.cover?.asset ??
        null;
      return hub && members.length > 0
        ? [{ collection, path: hub.path, count: members.length, cover }]
        : [];
    });

const galleryImages = [
  ...new Map(
    articles.flatMap((view) =>
      view.media
        .filter((item) => item.usage.role !== "og" && item.asset?.storageKey)
        .map((item) => {
          const primary = view.locations[0]?.location;
          const country = primary ? content.locations.countryOf(primary.id) : null;
          return [
            item.asset.storageKey,
            {
              ...item,
              articleTitle: view.revision.title,
              articleSummary: view.revision.summary,
              articlePath: view.route.path,
              country: country ? content.locations.nameOf(country.id, "ja") : "旅の景色",
            },
          ] as const;
        }),
    ),
  ).values(),
];
const galleryCountries = [...new Set(galleryImages.map((item) => item.country))]
  .map((name) => ({ name, count: galleryImages.filter((item) => item.country === name).length }))
  .toSorted((a, b) => b.count - a.count);

const countryCount = continents.reduce((total, continent) => total + continent.countries.length, 0);
const cityCount = continents.reduce(
  (total, continent) =>
    total +
    continent.countries.reduce((countryTotal, country) => countryTotal + country.cities.length, 0),
  0,
);

const mediaByStorageKey = (storageKey: string) =>
  content.snapshot.media.find((media) => media.storageKey === storageKey) ?? null;
const articleCountForLocation = (locationId: string) =>
  articles.filter((view) => view.locations.some(({ location }) => location.id === locationId))
    .length;
const cityDestinations = continents.flatMap((continent) =>
  continent.countries.flatMap((country) => country.cities.map((city) => ({ ...city, country }))),
);

const recentJourneys = [
  {
    country: "CHINA",
    title: "Shanghai",
    tagline: "進化し続ける、もうひとつの未来",
    path: "/destination/china/shanghai",
    city: continents
      .flatMap((continent) => continent.countries)
      .flatMap((country) => country.cities)
      .find((city) => city.name === "上海"),
    cover: mediaByStorageKey("images/China/the-night-view-of-the-bund.jpg"),
  },
  {
    country: "EGYPT",
    title: "Cairo & Beyond",
    tagline: "時を超えて、なお美しいもの",
    path: "/destination/egypt/cairo",
    city: continents
      .flatMap((continent) => continent.countries)
      .flatMap((country) => country.cities)
      .find((city) => city.name === "カイロ"),
    cover: mediaByStorageKey("images/Egypt/the-three-great-pyramids-of-giza-with-sunset.jpg"),
  },
  {
    country: "TÜRKİYE",
    title: "Cappadocia",
    tagline: "空にゆれる、やさしい朝",
    path: "/destination/turkey/cappadocia",
    city: continents
      .flatMap((continent) => continent.countries)
      .flatMap((country) => country.cities)
      .find((city) => city.name === "カッパドキア"),
    cover: mediaByStorageKey("images/Turkey/balloons-in-cappadocia.jpg"),
  },
].map((journey) => ({
  ...journey,
  count: journey.city ? articleCountForLocation(journey.city.id) : 0,
}));
const titleFromSlug = (slug: string) =>
  slug
    .split("-")
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");
const latestTravelView = articles
  .filter(
    (view) =>
      view.article.travelStartDate &&
      view.locations.some(({ location }) => location.type === "city"),
  )
  .toSorted(
    (a, b) =>
      (b.article.travelStartDate ?? "").localeCompare(a.article.travelStartDate ?? "") ||
      (b.article.publishedAt ?? "").localeCompare(a.article.publishedAt ?? ""),
  )[0];
const latestCityLocation = latestTravelView?.locations.find(
  ({ location }) => location.type === "city",
)?.location;
const latestCity = latestCityLocation
  ? cityDestinations.find((city) => city.id === latestCityLocation.id)
  : undefined;
const featuredJourney =
  latestTravelView && latestCity
    ? {
        slug: latestCity.country.slug,
        path: latestCity.path,
        title: titleFromSlug(latestCity.slug),
        country: titleFromSlug(latestCity.country.slug),
        count: articleCountForLocation(latestCity.id),
        cover: latestTravelView.cover
          ? {
              storageKey: latestTravelView.cover.asset.storageKey,
              alt: latestTravelView.cover.usage.alt,
            }
          : latestCity.country.cover
            ? {
                storageKey: latestCity.country.cover.asset.storageKey,
                alt: latestCity.country.cover.usage.alt,
              }
            : null,
      }
    : {
        slug: "china",
        path: recentJourneys[0]!.path,
        title: recentJourneys[0]!.title,
        country: "China",
        count: recentJourneys[0]!.count,
        cover: recentJourneys[0]!.cover
          ? { storageKey: recentJourneys[0]!.cover.storageKey, alt: "上海の夜景" }
          : null,
      };
/** How many cards the archive reveals per page. Every card is in the HTML
 * already, so this only decides how much of it is shown at once. */
const ARCHIVE_PAGE_SIZE = 24;

// The same story the home page leads with, so the archive opens on an episode
// rather than on whichever article happened to be published last.
const archiveLead = bestEpisodes().find(({ view }) => view.cover);
const archiveFeatured = archiveLead?.view ?? articles.find((view) => view.cover) ?? articles[0];
const archiveExperiences = EXPERIENCES.map((experience) => ({
  ...experience,
  count: articles.filter((view) => view.article.experienceTags.includes(experience.tag)).length,
})).filter((experience) => experience.count > 0);
// The featured article stays in the list as well as in the banner above it.
// Holding it back made the archive claim a different total from the masthead,
// and left that one article unreachable through the search and filters.
const archiveArticles = articles;
const archiveCategories = [
  ...new Set(archiveArticles.flatMap((view) => view.categories.map((item) => item.name))),
]
  .map((name) => ({
    name,
    count: archiveArticles.filter((view) => view.categories.some((item) => item.name === name))
      .length,
  }))
  .toSorted((a, b) => b.count - a.count)
  .slice(0, 10);
const archiveCountries = continents
  .flatMap((continent) => continent.countries)
  .filter((country) => country.count > 0)
  .toSorted((a, b) => b.count - a.count);
const archiveSearchText = (view: (typeof articles)[number]) => {
  const locations = view.locations.map(({ location }) =>
    content.locations.nameOf(location.id, "ja"),
  );
  return [
    view.revision.title,
    view.revision.summary,
    ...view.categories.map((item) => item.name),
    ...view.tags.map((item) => item.name),
    ...locations,
  ]
    .join(" ")
    .toLocaleLowerCase("ja");
};
const archiveCategoryText = (view: (typeof articles)[number]) =>
  view.categories.map((item) => item.name.toLocaleLowerCase("ja")).join("|");
const archiveCountryText = (view: (typeof articles)[number]) =>
  [
    ...new Set(
      view.locations.flatMap(({ location }) => {
        const country = content.locations.countryOf(location.id);
        return country ? [content.locations.nameOf(country.id, "ja").toLocaleLowerCase("ja")] : [];
      }),
    ),
  ].join("|");

const sitemapGroups = [
  { label: "記事", routes: content.routes.renderable().filter((r) => r.targetType === "article") },
  { label: "旅先", routes: content.routes.renderable().filter((r) => r.targetType === "location") },
  {
    label: "シリーズ・旅の記録",
    routes: content.routes
      .renderable()
      .filter((r) => r.targetType === "series" || r.targetType === "journey"),
  },
  { label: "その他", routes: content.routes.renderable().filter((r) => r.targetType === "static") },
];

const labelOf = (target: Route): string => {
  switch (target.targetType) {
    case "article":
      return content.titleOf((target.targetId ?? "") as never) || target.path;
    case "location":
      return content.locations.nameOf((target.targetId ?? "") as never, "ja");
    case "series":
    case "journey":
      return content.collection((target.targetId ?? "") as never)?.title ?? target.path;
    default:
      return (
        PAGES[target.path]?.title ??
        (content.titleOf((target.targetId ?? "") as never) || target.path)
      );
  }
};
---

<BaseLayout metadata={metadata} jsonLd={[buildBreadcrumbJsonLd(seoConfig, trail)]}>
  {route.path !== "/destination" && <Breadcrumbs trail={trail} />}
  {
    route.path !== "/" &&
      route.path !== "/posts" &&
      route.path !== "/collections" &&
      route.path !== "/destination" &&
      route.path !== "/gallery" &&
      route.path !== "/sitemap" && (
        <header class="page-header">
          <h1>{page.title}</h1>
          <p>{page.description}</p>
        </header>
      )
  }

  {
    route.path === "/posts" && (
      <div class="posts-archive">
        <header class="posts-archive__masthead">
          <div>
            <p class="eyebrow">TOMOKICHI TRAVEL BLOG</p>
            <h1>
              旅の記録と、
              <br />
              次の旅に役立つこと。
            </h1>
          </div>
          <div class="posts-archive__lead">
            <p>
              実際に歩いた街、心に残った景色、旅先で困ったこと。写真とともに、自分の言葉で綴っています。
            </p>
            <span>
              <strong>{articles.length}</strong> posts
            </span>
            <nav aria-label="ブログの探し方">
              <a href="/destination">旅先から探す</a>
              <a href="/collections">まとまりで読む</a>
            </nav>
          </div>
        </header>

        {archiveFeatured && archiveFeatured.cover && (
          <a class="posts-feature" href={archiveFeatured.route.path}>
            <Picture
              storageKey={archiveFeatured.cover.asset.storageKey}
              alt={archiveFeatured.cover.usage.alt}
              sizes="(max-width: 760px) 100vw, 1100px"
              loading="eager"
              fetchpriority="high"
            />
            <span class="posts-feature__shade" />
            <span class="posts-feature__copy">
              <small>{archiveLead ? "BEST EPISODE" : "FEATURED BLOG"}</small>
              <strong>
                {archiveLead?.episode.featuredTitle ?? archiveFeatured.revision.title}
              </strong>
              <span>{archiveLead?.episode.hook ?? archiveFeatured.revision.summary}</span>
              <b>
                この旅を読む <span aria-hidden="true">→</span>
              </b>
            </span>
          </a>
        )}

        <section class="posts-discovery" aria-labelledby="all-stories-heading">
          <div class="posts-discovery__heading">
            <div>
              <p class="eyebrow">EXPLORE THE BLOG</p>
              <h2 id="all-stories-heading">旅のブログを探す</h2>
            </div>
            <p>
              <span data-archive-count>{archiveArticles.length}</span>件の旅
            </p>
          </div>
          <div class="posts-filter">
            <div class="posts-filter__primary">
              <label class="posts-filter__search">
                <SearchIcon />
                <span class="sr-only">記事を検索</span>
                <input
                  type="search"
                  placeholder="国・都市・空港・気になる体験から探す"
                  data-archive-search
                />
              </label>
              <div class="posts-filter__selects">
                <label>
                  <span>旅先</span>
                  <select data-archive-country>
                    <option value="all">すべての国</option>
                    {archiveCountries.map((country) => (
                      <option value={country.name.toLocaleLowerCase("ja")}>
                        {country.name}（{country.count}）
                      </option>
                    ))}
                  </select>
                </label>
                <label>
                  <span>並び順</span>
                  <select data-archive-sort>
                    <option value="newest">新しい順</option>
                    <option value="oldest">古い順</option>
                    <option value="title">タイトル順</option>
                  </select>
                </label>
              </div>
            </div>
            {archiveExperiences.length > 0 && (
              <div class="posts-filter__moods">
                <p id="archive-mood-label">気分で選ぶ</p>
                <div class="posts-filter__mood-list" aria-labelledby="archive-mood-label">
                  <button class="is-active" type="button" data-archive-experience="all">
                    どれでも
                  </button>
                  {archiveExperiences.map((experience) => (
                    <button
                      type="button"
                      data-archive-experience={experience.tag}
                      data-label={experience.label}
                      style={`--exp-hue: ${experience.hue}`}
                    >
                      <span aria-hidden="true">{experience.mark}</span>
                      {experience.label}
                      <small>{experience.count}</small>
                    </button>
                  ))}
                </div>
              </div>
            )}
            <div class="posts-filter__chips" aria-label="カテゴリで絞り込む">
              <button class="is-active" type="button" data-archive-filter="all">
                すべて
              </button>
              {archiveCategories.map((category) => (
                <button type="button" data-archive-filter={category.name.toLocaleLowerCase("ja")}>
                  {category.name}
                  <small>{category.count}</small>
                </button>
              ))}
            </div>
            <div class="posts-filter__footer">
              <p data-archive-summary>すべての記事を表示中</p>
              <button type="button" data-archive-reset>
                条件をリセット
              </button>
            </div>
          </div>
          <div class="posts-results" id="results">
            <ul class="card-grid posts-grid" data-article-list>
              {archiveArticles.map((view, index) => (
                <ArticleCard
                  view={view}
                  eager={index < 3}
                  level={3}
                  variant="archive"
                  searchText={archiveSearchText(view)}
                  categoryText={archiveCategoryText(view)}
                  countryText={archiveCountryText(view)}
                  experienceText={view.article.experienceTags.join("|")}
                />
              ))}
            </ul>
            <p class="posts-empty" data-archive-empty hidden>
              まだ記録のない旅先です。別の条件でも探してみてください。
            </p>
            <footer class="posts-results__footer">
              <p data-archive-page-status aria-live="polite">
                1–{Math.min(ARCHIVE_PAGE_SIZE, archiveArticles.length)} / {archiveArticles.length}件
              </p>
              <nav
                class="posts-pagination"
                data-archive-pagination
                data-page-size={ARCHIVE_PAGE_SIZE}
                aria-label="記事一覧のページ"
              />
            </footer>
          </div>
        </section>
      </div>
    )
  }

  {
    route.path === "/destination" && (
      <div class="destination-index">
        <header class="destination-intro">
          <div class="destination-intro__side destination-intro__side--left" aria-hidden="true">
            <span>PLACES</span>
            <span>PEOPLE</span>
            <span>STORIES</span>
            <span>A MORE OPEN YOU</span>
            <i />
          </div>
          <div class="destination-intro__copy">
            <p class="destination-intro__eyebrow">旅先からブログを読む</p>
            <h1 id="destination-map-heading">Explore the world.</h1>
            <p class="destination-intro__subtitle">これまで歩いた街と、そこで見た景色。</p>
            <p class="destination-intro__stats">
              {countryCount} Countries <span>·</span> {cityCount} Cities
            </p>
          </div>
          <div class="destination-intro__side destination-intro__side--right" aria-hidden="true">
            <i />
            <span>TRAVEL</span>
            <span>SLOWER</span>
            <span>SEE DEEPER</span>
            <span>LIVE RICHER</span>
          </div>
        </header>

        <section class="destination-map-section" aria-labelledby="destination-map-heading">
          <div class="destination-map-frame">
            <div class="destination-map-note destination-map-note--left" aria-hidden="true">
              <span>Good</span>
              <span>Places</span>
              <span>Better People</span>
              <i />
            </div>
            <WorldMap
              countries={continents.flatMap((continent) => continent.countries)}
              featured={featuredJourney}
            />
            <div class="destination-map-note destination-map-note--right" aria-hidden="true">
              <b>＋</b>
              <span>SAME PLANET</span>
              <span>DIFFERENT STORIES</span>
            </div>
          </div>
        </section>

        <section class="destination-recent" aria-labelledby="destination-recent-heading">
          <header class="destination-recent__heading">
            <div>
              <h2 id="destination-recent-heading">Recent Journeys</h2>
              <p>旅のつづきを、ここから。</p>
            </div>
            <a href="/posts">
              View all stories <span aria-hidden="true">→</span>
            </a>
          </header>
          <div class="destination-journey-grid">
            {recentJourneys.map((journey, index) => (
              <a class="destination-journey-card" href={journey.path}>
                {journey.cover && (
                  <Picture
                    storageKey={journey.cover.storageKey}
                    alt=""
                    sizes="(max-width: 760px) 100vw, 33vw"
                    loading={index === 0 ? "eager" : "lazy"}
                  />
                )}
                <span class="destination-journey-card__shade" />
                <span class="destination-journey-card__copy">
                  <small>{journey.country}</small>
                  <strong>{journey.title}</strong>
                  <span>{journey.tagline}</span>
                  <b>
                    {journey.count} stories <i aria-hidden="true" />
                  </b>
                </span>
              </a>
            ))}
          </div>
        </section>

        <section class="destination-directory" aria-labelledby="destination-directory-heading">
          <div class="destination-section-heading">
            <div>
              <small>国・都市から選ぶ</small>
              <h2 id="destination-directory-heading">訪れた場所のすべて</h2>
            </div>
            <p>
              <span data-destination-count>{countryCount}</span>か国を掲載しています。
            </p>
          </div>
          <label class="destination-search">
            <SearchIcon />
            <span class="sr-only">国または都市を検索</span>
            <input type="search" placeholder="国・都市名で絞り込む" data-destination-search />
          </label>
          <nav class="destination-tabs" aria-label="大陸で絞り込む">
            <button class="is-active" type="button" data-destination-filter="all">
              すべて
            </button>
            {continents.map((continent) => (
              <button type="button" data-destination-filter={continent.name}>
                {continent.name}
              </button>
            ))}
          </nav>
          <div class="destination-continents">
            {continents.map((continent) => (
              <section class="destination-continent" data-continent={continent.name}>
                <header>
                  <h3>{continent.name}</h3>
                  <span>{continent.countries.length}か国</span>
                </header>
                <div class="destination-country-grid">
                  {continent.countries.map((country, index) => (
                    <a
                      class="destination-country"
                      href={country.path}
                      data-destination-country
                      data-search={`${country.name} ${country.cities.map((city) => city.name).join(" ")}`.toLocaleLowerCase(
                        "ja",
                      )}
                    >
                      <span class="destination-country__media">
                        {country.cover ? (
                          <Picture
                            storageKey={country.cover.asset.storageKey}
                            alt={`${country.name}の旅`}
                            sizes="(max-width: 760px) 50vw, 280px"
                            loading={index < 4 ? "eager" : "lazy"}
                          />
                        ) : (
                          <span class="destination-country__placeholder" />
                        )}
                        <b>{country.name}</b>
                      </span>
                      <span class="destination-country__body">
                        <span>{country.count}本のブログ</span>
                        <small>
                          {country.cities
                            .slice(0, 3)
                            .map((city) => city.name)
                            .join("、") || "旅の記録を見る"}
                        </small>
                        <i>詳しく見る&nbsp; →</i>
                      </span>
                    </a>
                  ))}
                </div>
              </section>
            ))}
          </div>
          <p class="destination-empty" data-destination-empty hidden>
            一致する旅先はまだありません。別の名前でも探してみてください。
          </p>
        </section>
      </div>
    )
  }

  {
    route.path === "/collections" && (
      <div class="collections-page">
        <header class="collections-hero">
          <div class="collections-hero__copy">
            <p>CURATED TRAVEL STORIES</p>
            <h1>
              旅の記憶を、
              <br />
              ひとつの物語として。
            </h1>
            <span>
              時系列でたどる旅程と、心に残った景色を集めたテーマ。気分に合う入口から、ブログを続けて読めます。
            </span>
            <div>
              <b>
                {collections("journey").length}
                <small>旅程</small>
              </b>
              <b>
                {collections("series").length}
                <small>テーマ</small>
              </b>
              <b>
                {articles.length}
                <small>ブログ</small>
              </b>
            </div>
          </div>
          <div class="collections-hero__visual" aria-hidden="true">
            {collections("journey")
              .slice(0, 3)
              .map(
                (entry, index) =>
                  entry.cover && (
                    <Picture
                      storageKey={entry.cover.storageKey}
                      alt={entry.collection.title}
                      sizes="(max-width: 760px) 40vw, 260px"
                      loading={index === 0 ? "eager" : "lazy"}
                    />
                  ),
              )}
            <span>
              Stories
              <br />
              worth keeping.
            </span>
          </div>
        </header>

        <nav class="collections-jump" aria-label="コレクション内メニュー">
          <a href="#journey-collections-heading">
            旅程から読む <span>→</span>
          </a>
          <a href="#series-collections-heading">
            テーマから読む <span>→</span>
          </a>
        </nav>

        <section
          class="collections-group collections-group--journey"
          aria-labelledby="journey-collections-heading"
        >
          <div class="collections-group__heading">
            <div>
              <small>旅程コレクション</small>
              <h2 id="journey-collections-heading">旅を順番にたどる</h2>
            </div>
            <p>出発から帰着まで、時系列でまとまった旅の記録です。</p>
          </div>
          <div class="journey-collection-grid">
            {collections("journey").map((entry, index) => (
              <a class="journey-collection-card" href={entry.path}>
                {entry.cover && (
                  <Picture
                    storageKey={entry.cover.storageKey}
                    alt={entry.collection.title}
                    sizes="(max-width: 760px) 100vw, 520px"
                    loading={index < 2 ? "eager" : "lazy"}
                  />
                )}
                <span class="journey-collection-card__shade" />
                <span class="journey-collection-card__copy">
                  <small>
                    {entry.collection.startDate
                      ? `${entry.collection.startDate.replaceAll("-", ".")} — ${entry.collection.endDate?.replaceAll("-", ".") ?? ""}`
                      : "旅の記録"}
                  </small>
                  <strong>{entry.collection.title}</strong>
                  <span>{entry.collection.description}</span>
                  <b>{entry.count}本の記事</b>
                </span>
              </a>
            ))}
          </div>
        </section>

        <section class="collections-group" aria-labelledby="series-collections-heading">
          <div class="collections-group__heading">
            <div>
              <small>テーマコレクション</small>
              <h2 id="series-collections-heading">好きな景色から読む</h2>
            </div>
            <p>夕陽、建築、街並み。心が動いた瞬間をテーマ別に集めました。</p>
          </div>
          <div class="series-collection-grid">
            {collections("series").map((entry, index) => (
              <a class="series-collection-card" href={entry.path}>
                {entry.cover && (
                  <Picture
                    storageKey={entry.cover.storageKey}
                    alt={entry.collection.title}
                    sizes="(max-width: 760px) 50vw, 320px"
                    loading={index < 3 ? "eager" : "lazy"}
                  />
                )}
                <span>
                  <small>
                    {String(index + 1).padStart(2, "0")} /{" "}
                    {String(collections("series").length).padStart(2, "0")}
                  </small>
                  <strong>{entry.collection.title}</strong>
                  <span>{entry.collection.description}</span>
                  <b>{entry.count}本</b>
                </span>
              </a>
            ))}
          </div>
        </section>
      </div>
    )
  }

  {
    route.path === "/gallery" && (
      <div class="gallery-page">
        <header class="gallery-hero">
          <div>
            <p class="eyebrow">PHOTO JOURNAL</p>
            <h1>
              旅の途中で、
              <br />
              心が止まった瞬間。
            </h1>
            <p>
              街の光、建築の輪郭、食卓の色。記事に残した写真を、ここでは言葉より少し自由に眺められます。
            </p>
            <span>
              <strong>{galleryImages.length}</strong> photographs
            </span>
          </div>
          <div class="gallery-hero__mosaic" aria-hidden="true">
            {galleryImages.slice(0, 3).map((item, index) => (
              <Picture
                storageKey={item.asset.storageKey}
                alt={item.usage.alt || item.articleTitle}
                sizes="(max-width: 760px) 50vw, 300px"
                loading={index === 0 ? "eager" : "lazy"}
              />
            ))}
          </div>
        </header>

        <section class="gallery-browser" aria-labelledby="gallery-all-heading">
          <header>
            <div>
              <p class="eyebrow">ALL PHOTOGRAPHS</p>
              <h2 id="gallery-all-heading">すべての旅の写真</h2>
            </div>
            <p>
              <span data-gallery-count>{galleryImages.length}</span>枚を表示中
            </p>
          </header>
          <div class="gallery-filters" aria-label="国で絞り込む">
            <button class="is-active" type="button" data-gallery-filter="all">
              すべて <small>{galleryImages.length}</small>
            </button>
            {galleryCountries.map((country) => (
              <button type="button" data-gallery-filter={country.name}>
                {country.name} <small>{country.count}</small>
              </button>
            ))}
          </div>
          <ul class="gallery-wall" data-gallery-wall>
            {galleryImages.map((item, index) => (
              <li
                data-gallery-item
                data-country={item.country}
                data-search={`${item.country} ${item.articleTitle} ${item.usage.alt}`.toLocaleLowerCase(
                  "ja",
                )}
              >
                <button
                  type="button"
                  data-gallery-open
                  data-src={mediaUrl(item.asset.storageKey)}
                  data-alt={item.usage.alt}
                  data-title={item.usage.alt || item.articleTitle}
                  data-article={item.articleTitle}
                  data-summary={item.articleSummary}
                  data-place={item.country}
                  data-path={item.articlePath}
                >
                  <Picture
                    storageKey={item.asset.storageKey}
                    alt={item.usage.alt}
                    sizes="(max-width: 760px) 50vw, 360px"
                    loading={index < 8 ? "eager" : "lazy"}
                  />
                  <span>
                    <small>{item.country}</small>
                    <strong>{item.usage.alt || item.articleTitle}</strong>
                  </span>
                </button>
              </li>
            ))}
          </ul>
          <p class="gallery-empty" data-gallery-empty hidden>
            この地域の写真はまだありません。
          </p>
        </section>

        <div class="gallery-lightbox" data-gallery-lightbox hidden>
          <button
            class="gallery-lightbox__backdrop"
            type="button"
            data-gallery-close
            aria-label="写真を閉じる"
          />
          <figure role="dialog" aria-modal="true" aria-label="写真の拡大表示">
            <button type="button" data-gallery-close aria-label="写真を閉じる">
              <XIcon />
            </button>
            <img data-gallery-lightbox-image src="" alt="" />
            <figcaption>
              <small data-gallery-lightbox-country>PHOTO JOURNAL</small>
              <strong data-gallery-lightbox-title />
              <p data-gallery-lightbox-summary />
              <a data-gallery-lightbox-link href="/posts">
                この写真の記事を読む<span aria-hidden="true">→</span>
              </a>
            </figcaption>
          </figure>
        </div>
      </div>
    )
  }

  {
    route.path === "/sitemap" && (
      <div class="sitemap-page">
        <header class="sitemap-page__header">
          <p class="eyebrow">SITE DIRECTORY</p>
          <h1>サイトマップ</h1>
          <p>旅の記事、旅先、コレクション、サイト案内を一覧から探せます。</p>
        </header>
        <div class="sitemap-page__groups">
          {sitemapGroups.map((group) => (
            <section class="sitemap-group" aria-labelledby={`sitemap-${group.label}`}>
              <header>
                <h2 id={`sitemap-${group.label}`}>{group.label}</h2>
                <span>{group.routes.length}</span>
              </header>
              <ul>
                {group.routes.map((target) => (
                  <li>
                    <a href={target.path}>{labelOf(target)}</a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    )
  }
  <script>
    /**
     * Filter state belongs in the query string: every list on this page can be
     * linked to in the state the reader is looking at. Values equal to their
     * default are dropped so a pristine list has a clean URL.
     */
    const setUrlParams = (
      entries: [string, string, string][],
      mode: "push" | "replace" = "push",
    ) => {
      const params = new URLSearchParams(location.search);
      for (const [key, value, fallback] of entries) {
        if (value === fallback || value === "") params.delete(key);
        else params.set(key, value);
      }
      const search = params.toString();
      // The fragment is how a search lands on the results rather than the top
      // of the page, so it survives every rewrite.
      const next = `${location.pathname}${search ? `?${search}` : ""}${location.hash}`;
      if (next === `${location.pathname}${location.search}${location.hash}`) return;
      history[mode === "push" ? "pushState" : "replaceState"](null, "", next);
    };
    const urlParam = (key: string, fallback = "") =>
      new URLSearchParams(location.search).get(key)?.trim() || fallback;

    const archiveSearch = document.querySelector<HTMLInputElement>("[data-archive-search]");
    const archiveFilters = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-archive-filter]"),
    ];
    const archiveCards = [
      ...document.querySelectorAll<HTMLElement>("[data-article-list] > [data-search]"),
    ];
    const archiveGrid = document.querySelector<HTMLElement>("[data-article-list]");
    const archiveExperienceButtons = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-archive-experience]"),
    ];
    const archiveCountry = document.querySelector<HTMLSelectElement>("[data-archive-country]");
    const archiveSort = document.querySelector<HTMLSelectElement>("[data-archive-sort]");
    const archiveReset = document.querySelector<HTMLButtonElement>("[data-archive-reset]");
    const archiveSummary = document.querySelector<HTMLElement>("[data-archive-summary]");
    const archivePagination = document.querySelector<HTMLElement>("[data-archive-pagination]");
    const archivePageStatus = document.querySelector<HTMLElement>("[data-archive-page-status]");
    const archiveCount = document.querySelector<HTMLElement>("[data-archive-count]");
    const archiveEmpty = document.querySelector<HTMLElement>("[data-archive-empty]");
    const archivePageSize = Number(archivePagination?.dataset.pageSize) || 12;

    /**
     * Every part of the archive's state lives in the query string, so a
     * filtered, sorted, paginated view is a URL you can share, bookmark and
     * come back to. The header search modal and the home search box hand over
     * the same `q` parameter.
     */
    const ARCHIVE_DEFAULTS = {
      q: "",
      experience: "all",
      category: "all",
      country: "all",
      sort: "newest",
      page: "1",
    };
    let activeArchiveFilter = ARCHIVE_DEFAULTS.category;
    let activeExperience = ARCHIVE_DEFAULTS.experience;
    const markExperience = () =>
      archiveExperienceButtons.forEach((button) => {
        const active = (button.dataset.archiveExperience ?? "all") === activeExperience;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    let archivePage = 1;

    const readArchiveUrl = () => {
      const params = new URLSearchParams(location.search);
      return {
        q: (params.get("q") ?? "").trim(),
        experience: params.get("experience") ?? ARCHIVE_DEFAULTS.experience,
        category: params.get("category") ?? ARCHIVE_DEFAULTS.category,
        country: params.get("country") ?? ARCHIVE_DEFAULTS.country,
        sort: params.get("sort") ?? ARCHIVE_DEFAULTS.sort,
        page: Math.max(1, Number(params.get("page")) || 1),
      };
    };

    const writeArchiveUrl = (mode: "push" | "replace") =>
      setUrlParams(
        [
          ["q", archiveSearch?.value.trim() ?? "", ARCHIVE_DEFAULTS.q],
          ["experience", activeExperience, ARCHIVE_DEFAULTS.experience],
          ["category", activeArchiveFilter, ARCHIVE_DEFAULTS.category],
          ["country", archiveCountry?.value ?? "all", ARCHIVE_DEFAULTS.country],
          ["sort", archiveSort?.value ?? "newest", ARCHIVE_DEFAULTS.sort],
          ["page", String(archivePage), ARCHIVE_DEFAULTS.page],
        ],
        mode,
      );

    /** Selecting a value the page does not offer would blank the control. */
    const selectIfPresent = (select: HTMLSelectElement | null, value: string) => {
      if (!select) return;
      const exists = [...select.options].some((option) => option.value === value);
      select.value = exists ? value : "all";
    };

    const applyArchiveUrl = () => {
      const state = readArchiveUrl();
      if (archiveSearch) archiveSearch.value = state.q;
      selectIfPresent(archiveCountry, state.country);
      if (archiveSort) archiveSort.value = state.sort;
      activeArchiveFilter = archiveFilters.some(
        (button) => (button.dataset.archiveFilter ?? "all") === state.category,
      )
        ? state.category
        : ARCHIVE_DEFAULTS.category;
      archiveFilters.forEach((button) =>
        button.classList.toggle(
          "is-active",
          (button.dataset.archiveFilter ?? "all") === activeArchiveFilter,
        ),
      );
      activeExperience = archiveExperienceButtons.some(
        (button) => (button.dataset.archiveExperience ?? "all") === state.experience,
      )
        ? state.experience
        : ARCHIVE_DEFAULTS.experience;
      markExperience();
      archivePage = state.page;
    };

    const renderPagination = (total: number) => {
      if (!archivePagination) return;
      archivePagination.replaceChildren();
      const pages = Math.ceil(total / archivePageSize);
      archivePagination.hidden = pages <= 1;
      if (pages <= 1) return;

      const goToPage = (page: number) => {
        archivePage = page;
        updateArchive(false, "push");
        document
          .querySelector(".posts-results")
          ?.scrollIntoView({ behavior: "smooth", block: "start" });
      };

      const stepButton = (label: string, page: number, className: string, disabled: boolean) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = className;
        button.textContent = label;
        button.disabled = disabled;
        button.addEventListener("click", () => goToPage(page));
        return button;
      };

      // The numbered list is the desktop affordance; narrower screens get the
      // "6 / 42" counter instead, and CSS decides which one is shown.
      const pageList = document.createElement("div");
      pageList.className = "posts-pagination__pages";
      for (let page = 1; page <= pages; page += 1) {
        if (pages > 7 && page > 2 && page < pages - 1 && Math.abs(page - archivePage) > 1) {
          if (page === 3 || page === pages - 2) {
            const separator = document.createElement("span");
            separator.textContent = "…";
            pageList.append(separator);
          }
          continue;
        }
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = String(page);
        if (page === archivePage) button.setAttribute("aria-current", "page");
        button.addEventListener("click", () => goToPage(page));
        pageList.append(button);
      }

      const status = document.createElement("span");
      status.className = "posts-pagination__status";
      status.textContent = `${archivePage} / ${pages}`;

      archivePagination.append(
        stepButton(
          "← 前へ",
          Math.max(1, archivePage - 1),
          "posts-pagination__prev",
          archivePage === 1,
        ),
        pageList,
        status,
        stepButton(
          "次へ →",
          Math.min(pages, archivePage + 1),
          "posts-pagination__next",
          archivePage === pages,
        ),
      );
    };

    const updateArchive = (resetPage = true, urlMode: "push" | "replace" | "none" = "push") => {
      if (resetPage) archivePage = 1;
      const archiveQuery = archiveSearch?.value.trim().toLocaleLowerCase("ja") ?? "";
      let visible = 0;
      const matchedCards = archiveCards.filter((card) => {
        const haystack = card.dataset.search ?? "";
        const categories = (card.dataset.category ?? "").split("|");
        const countries = (card.dataset.country ?? "").split("|");
        const experiences = (card.dataset.experience ?? "").split("|");
        const matches =
          (!archiveQuery || haystack.includes(archiveQuery)) &&
          (activeExperience === "all" || experiences.includes(activeExperience)) &&
          (activeArchiveFilter === "all" || categories.includes(activeArchiveFilter)) &&
          (!archiveCountry ||
            archiveCountry.value === "all" ||
            countries.includes(archiveCountry.value));
        if (matches) visible += 1;
        return matches;
      });
      const sorted = archiveCards.toSorted((a, b) => {
        if (archiveSort?.value === "oldest")
          return (a.dataset.published ?? "").localeCompare(b.dataset.published ?? "");
        if (archiveSort?.value === "title")
          return (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "", "ja");
        return (b.dataset.published ?? "").localeCompare(a.dataset.published ?? "");
      });
      if (archiveGrid) archiveGrid.append(...sorted);
      archiveCards.forEach((card) => {
        card.hidden = true;
      });
      const matchedSet = new Set(matchedCards);
      const sortedMatches = sorted.filter((card) => matchedSet.has(card));
      const pageCount = Math.max(1, Math.ceil(visible / archivePageSize));
      archivePage = Math.min(archivePage, pageCount);
      const pageStart = (archivePage - 1) * archivePageSize;
      sortedMatches.slice(pageStart, pageStart + archivePageSize).forEach((card) => {
        card.hidden = false;
      });
      renderPagination(visible);
      if (archivePageStatus) {
        const rangeStart = visible === 0 ? 0 : pageStart + 1;
        const rangeEnd = Math.min(pageStart + archivePageSize, visible);
        archivePageStatus.textContent = `${rangeStart}–${rangeEnd} / ${visible}件`;
      }
      if (archiveCount) archiveCount.textContent = String(visible);
      if (archiveEmpty) archiveEmpty.hidden = visible !== 0;
      if (archiveSummary) {
        const conditions = [
          archiveQuery && `「${archiveQuery}」`,
          activeExperience !== "all" &&
            `「${
              archiveExperienceButtons.find(
                (button) => button.dataset.archiveExperience === activeExperience,
              )?.dataset.label ?? activeExperience
            }」な旅`,
          activeArchiveFilter !== "all" && activeArchiveFilter,
          archiveCountry?.value !== "all" &&
            archiveCountry?.selectedOptions[0]?.text.replace(/（.*）/, ""),
        ].filter(Boolean);
        archiveSummary.textContent =
          conditions.length > 0 ? `${conditions.join("・")}で絞り込み中` : "すべての記事を表示中";
      }
      // Written after the page has been clamped, so the URL never names a
      // page the current filters do not have.
      if (urlMode !== "none") writeArchiveUrl(urlMode);
    };

    archiveSearch?.addEventListener("input", () => updateArchive(true, "replace"));
    archiveCountry?.addEventListener("change", () => updateArchive());
    archiveSort?.addEventListener("change", () => updateArchive());
    archiveFilters.forEach((button) =>
      button.addEventListener("click", () => {
        activeArchiveFilter = button.dataset.archiveFilter ?? "all";
        archiveFilters.forEach((item) => item.classList.toggle("is-active", item === button));
        updateArchive();
      }),
    );
    archiveExperienceButtons.forEach((button) =>
      button.addEventListener("click", () => {
        activeExperience = button.dataset.archiveExperience ?? "all";
        markExperience();
        updateArchive();
      }),
    );
    archiveReset?.addEventListener("click", () => {
      if (archiveSearch) archiveSearch.value = "";
      if (archiveCountry) archiveCountry.value = "all";
      if (archiveSort) archiveSort.value = "newest";
      activeArchiveFilter = "all";
      activeExperience = "all";
      markExperience();
      archiveFilters.forEach((item) =>
        item.classList.toggle("is-active", item.dataset.archiveFilter === "all"),
      );
      updateArchive();
    });

    if (archiveCards.length > 0) {
      applyArchiveUrl();
      // `replace` rather than `none`: a hand-written or stale URL gets tidied
      // into the canonical form on arrival instead of lingering.
      updateArchive(false, "replace");
      addEventListener("popstate", () => {
        applyArchiveUrl();
        updateArchive(false, "none");
      });
    }

    const destinationSearch = document.querySelector<HTMLInputElement>("[data-destination-search]");
    const destinationFilters = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-destination-filter]"),
    ];
    const destinationCountries = [
      ...document.querySelectorAll<HTMLElement>("[data-destination-country]"),
    ];
    const destinationContinents = [...document.querySelectorAll<HTMLElement>("[data-continent]")];
    const destinationCount = document.querySelector<HTMLElement>("[data-destination-count]");
    const destinationEmpty = document.querySelector<HTMLElement>("[data-destination-empty]");
    let activeDestination = "all";
    const writeDestinationUrl = (mode: "push" | "replace") =>
      setUrlParams(
        [
          ["q", destinationSearch?.value.trim() ?? "", ""],
          ["area", activeDestination, "all"],
        ],
        mode,
      );
    const updateDestinations = (mode: "push" | "replace" | "none" = "push") => {
      const destinationQuery = destinationSearch?.value.trim().toLocaleLowerCase("ja") ?? "";
      let visible = 0;
      destinationCountries.forEach((country) => {
        const continent = country.closest<HTMLElement>("[data-continent]")?.dataset.continent ?? "";
        const matches =
          (activeDestination === "all" || activeDestination === continent) &&
          (!destinationQuery || (country.dataset.search ?? "").includes(destinationQuery));
        country.hidden = !matches;
        if (matches) visible += 1;
      });
      destinationContinents.forEach((continent) => {
        continent.hidden = ![
          ...continent.querySelectorAll<HTMLElement>("[data-destination-country]"),
        ].some((country) => !country.hidden);
      });
      if (destinationCount) destinationCount.textContent = String(visible);
      if (destinationEmpty) destinationEmpty.hidden = visible !== 0;
      if (mode !== "none") writeDestinationUrl(mode);
    };
    const applyDestinationUrl = () => {
      if (destinationSearch) destinationSearch.value = urlParam("q");
      const area = urlParam("area", "all");
      activeDestination = destinationFilters.some(
        (button) => (button.dataset.destinationFilter ?? "all") === area,
      )
        ? area
        : "all";
      destinationFilters.forEach((button) =>
        button.classList.toggle(
          "is-active",
          (button.dataset.destinationFilter ?? "all") === activeDestination,
        ),
      );
    };
    destinationSearch?.addEventListener("input", () => updateDestinations("replace"));
    destinationFilters.forEach((button) =>
      button.addEventListener("click", () => {
        activeDestination = button.dataset.destinationFilter ?? "all";
        destinationFilters.forEach((item) => item.classList.toggle("is-active", item === button));
        updateDestinations();
      }),
    );
    if (destinationCountries.length > 0) {
      applyDestinationUrl();
      updateDestinations("replace");
      addEventListener("popstate", () => {
        applyDestinationUrl();
        updateDestinations("none");
      });
    }

    const galleryFilters = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-gallery-filter]"),
    ];
    const galleryItems = [...document.querySelectorAll<HTMLElement>("[data-gallery-item]")];
    const galleryCount = document.querySelector<HTMLElement>("[data-gallery-count]");
    const galleryEmpty = document.querySelector<HTMLElement>("[data-gallery-empty]");
    const galleryLightbox = document.querySelector<HTMLElement>("[data-gallery-lightbox]");
    const galleryImage = galleryLightbox?.querySelector<HTMLImageElement>(
      "[data-gallery-lightbox-image]",
    );
    const galleryTitle = galleryLightbox?.querySelector<HTMLElement>(
      "[data-gallery-lightbox-title]",
    );
    const galleryCountry = galleryLightbox?.querySelector<HTMLElement>(
      "[data-gallery-lightbox-country]",
    );
    const gallerySummary = galleryLightbox?.querySelector<HTMLElement>(
      "[data-gallery-lightbox-summary]",
    );
    const galleryLink = galleryLightbox?.querySelector<HTMLAnchorElement>(
      "[data-gallery-lightbox-link]",
    );
    const setGalleryLightbox = (open: boolean) => {
      if (!galleryLightbox) return;
      galleryLightbox.hidden = !open;
      void galleryLightbox.offsetHeight;
      galleryLightbox.classList.toggle("is-open", open);
      document.dispatchEvent(
        new CustomEvent("site:overlay-change", { detail: { key: "gallery-lightbox", open } }),
      );
    };
    const applyGalleryFilter = (filter: string, mode: "push" | "replace" | "none") => {
      const known =
        filter === "all" ||
        galleryFilters.some((button) => button.dataset.galleryFilter === filter);
      const active = known ? filter : "all";
      let visible = 0;
      galleryItems.forEach((item) => {
        const matches = active === "all" || item.dataset.country === active;
        item.hidden = !matches;
        if (matches) visible += 1;
      });
      galleryFilters.forEach((button) =>
        button.classList.toggle("is-active", (button.dataset.galleryFilter ?? "all") === active),
      );
      if (galleryCount) galleryCount.textContent = String(visible);
      if (galleryEmpty) galleryEmpty.hidden = visible !== 0;
      if (mode !== "none") setUrlParams([["country", active, "all"]], mode);
    };
    galleryFilters.forEach((button) =>
      button.addEventListener("click", () =>
        applyGalleryFilter(button.dataset.galleryFilter ?? "all", "push"),
      ),
    );
    if (galleryItems.length > 0) {
      applyGalleryFilter(urlParam("country", "all"), "replace");
      addEventListener("popstate", () => applyGalleryFilter(urlParam("country", "all"), "none"));
    }
    document.querySelectorAll<HTMLButtonElement>("[data-gallery-open]").forEach((button) =>
      button.addEventListener("click", () => {
        if (galleryImage) {
          galleryImage.src = button.dataset.src ?? "";
          galleryImage.alt = button.dataset.alt ?? "";
        }
        if (galleryTitle) galleryTitle.textContent = button.dataset.title ?? "";
        if (galleryCountry) galleryCountry.textContent = button.dataset.place ?? "PHOTO JOURNAL";
        if (gallerySummary) gallerySummary.textContent = button.dataset.summary ?? "";
        if (galleryLink) galleryLink.href = button.dataset.path ?? "/posts";
        setGalleryLightbox(true);
      }),
    );
    galleryLightbox
      ?.querySelectorAll<HTMLButtonElement>("[data-gallery-close]")
      .forEach((button) => button.addEventListener("click", () => setGalleryLightbox(false)));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && galleryLightbox && !galleryLightbox.hidden)
        setGalleryLightbox(false);
    });
  </script>
</BaseLayout>
