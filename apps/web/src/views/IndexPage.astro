---
import type { Route } from "@tomokichi/domain";
import { buildBreadcrumbJsonLd, buildPageMetadata, buildWebSiteJsonLd } from "@tomokichi/seo";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { content } from "../lib/content";
import Picture from "../components/Picture.astro";
import { SIZES } from "../lib/images";
import { seoConfig, siteDescription } from "../lib/site";
import WorldMap from "../components/WorldMap.astro";
import { SearchIcon } from "../components/TravelIcons";

interface Props {
  route: Route;
}

const { route } = Astro.props;
const articles = content.publicArticles().flatMap((article) => {
  if (article.kind !== "article") return [];
  const view = content.viewOf(article.id);
  return view ? [view] : [];
});

const PAGES: Record<string, { title: string; description: string }> = {
  "/": { title: seoConfig.siteName, description: siteDescription },
  "/posts": {
    title: "記事一覧",
    description: `公開しているすべての記事${articles.length}件を新しい順に掲載しています。`,
  },
  "/destination": {
    title: "旅先から探す",
    description: "訪れた国と都市ごとに、観光情報や移動手段、費用の記録をまとめています。",
  },
  "/collections": {
    title: "コレクション",
    description: "テーマごとの連載と、旅程ごとの記録をまとめています。",
  },
  "/gallery": { title: "ギャラリー", description: "旅先で撮影した写真をまとめています。" },
  "/sitemap": { title: "サイトマップ", description: "サイト内のすべてのページの一覧です。" },
};

const page = PAGES[route.path] ?? { title: seoConfig.siteName, description: siteDescription };
const metadata = buildPageMetadata(seoConfig, {
  title: page.title,
  description: page.description,
  route,
  noindex: route.noindex,
});

const trail =
  route.path === "/"
    ? []
    : [
        { name: "ホーム", route: { path: "/" } as Route },
        { name: page.title, route },
      ];

// Continents group the country list rather than having pages of their own:
// they sat at the same URL depth as the countries they contain.
const continents = content.locations
  .roots()
  .map((root) => ({
    name: content.locations.nameOf(root.id, "ja"),
    countries: content.locations.children(root.id).flatMap((country) => {
      const hub = content.routes.canonicalFor("location", country.id);
      const countryArticles = articles.filter((view) =>
        content.relations.locations.some(
          (relation) =>
            relation.articleId === view.article.id &&
            content.locations.countryOf(relation.locationId)?.id === country.id,
        ),
      );
      return hub
        ? [
            {
              id: country.id,
              slug: country.slug,
              name: content.locations.nameOf(country.id, "ja"),
              path: hub.path,
              count: countryArticles.length,
              cover: countryArticles.find((view) => view.cover)?.cover ?? null,
              cities: content.locations.descendants(country.id)
                .filter((place) => place.type === "city")
                .flatMap((place) => {
                  const cityRoute = content.routes.canonicalFor("location", place.id);
                  return cityRoute ? [{ name: content.locations.nameOf(place.id, "ja"), path: cityRoute.path }] : [];
                }),
            },
          ]
        : [];
    }),
  }))
  .filter((continent) => continent.countries.length > 0);

const collections = (kind: "series" | "journey") =>
  content.snapshot.collections
    .filter((collection) => collection.kind === kind)
    .flatMap((collection) => {
      const hub = content.routes.canonicalFor(kind, collection.id);
      const members = content.membersOf(collection.id);
      const cover = content.snapshot.media.find((media) => media.id === collection.coverMediaId) ?? members.find((member) => member.cover)?.cover?.asset ?? null;
      return hub && members.length > 0
        ? [{ collection, path: hub.path, count: members.length, cover }]
        : [];
    });

const galleryImages = articles
  .flatMap((view) => view.media.filter((item) => item.usage.role !== "og"))
  .slice(0, 60);

const countryCount = continents.reduce((total, continent) => total + continent.countries.length, 0);
const featuredStories = articles
  .filter((view) => view.cover)
  .reduce<typeof articles>((stories, view) => {
    const country = content.relations.locations
      .filter((relation) => relation.articleId === view.article.id)
      .map((relation) => content.locations.countryOf(relation.locationId))
      .find(Boolean);
    const usedCountries = new Set(
      stories.flatMap((story) =>
        content.relations.locations
          .filter((relation) => relation.articleId === story.article.id)
          .map((relation) => content.locations.countryOf(relation.locationId)?.id)
          .filter(Boolean),
      ),
    );
    if (!country || usedCountries.has(country.id)) return stories;
    return [...stories, view];
  }, [])
  .slice(0, 4);

const popularDestinations = continents
  .flatMap((continent) => continent.countries)
  .filter((country) => country.cover && country.count > 0)
  .toSorted((a, b) => b.count - a.count)
  .slice(0, 4);

const homeArticleLead = articles.find((view) => view.cover) ?? articles[0];
const homeArticleSide = articles
  .filter((view) => view.article.id !== homeArticleLead?.article.id && view.cover)
  .slice(0, 4);
const homeFeaturedIds = new Set([homeArticleLead?.article.id, ...homeArticleSide.map((view) => view.article.id)]);
const homeLatest = articles.filter((view) => !homeFeaturedIds.has(view.article.id)).slice(0, 8);
const homeStoryLabel = (view: (typeof articles)[number]) => {
  const primary = view.locations[0]?.location;
  return primary ? content.locations.nameOf(primary.id, "ja") : (view.categories[0]?.name ?? "旅行日記");
};

const archiveFeatured = articles.find((view) => view.cover) ?? articles[0];
const archiveArticles = articles.filter((view) => view.article.id !== archiveFeatured?.article.id);
const archiveCategories = [...new Set(archiveArticles.flatMap((view) => view.categories.map((item) => item.name)))]
  .map((name) => ({ name, count: archiveArticles.filter((view) => view.categories.some((item) => item.name === name)).length }))
  .toSorted((a, b) => b.count - a.count)
  .slice(0, 10);
const archiveCountries = continents
  .flatMap((continent) => continent.countries)
  .filter((country) => country.count > 0)
  .toSorted((a, b) => b.count - a.count);
const archiveSearchText = (view: (typeof articles)[number]) => {
  const locations = view.locations.map(({ location }) => content.locations.nameOf(location.id, "ja"));
  return [view.revision.title, view.revision.summary, ...view.categories.map((item) => item.name), ...view.tags.map((item) => item.name), ...locations]
    .join(" ")
    .toLocaleLowerCase("ja");
};
const archiveCategoryText = (view: (typeof articles)[number]) => view.categories.map((item) => item.name.toLocaleLowerCase("ja")).join("|");
const archiveCountryText = (view: (typeof articles)[number]) => [...new Set(view.locations.flatMap(({ location }) => {
  const country = content.locations.countryOf(location.id);
  return country ? [content.locations.nameOf(country.id, "ja").toLocaleLowerCase("ja")] : [];
}))].join("|");

const sitemapGroups = [
  { label: "記事", routes: content.routes.renderable().filter((r) => r.targetType === "article") },
  { label: "旅先", routes: content.routes.renderable().filter((r) => r.targetType === "location") },
  {
    label: "シリーズ・旅の記録",
    routes: content.routes
      .renderable()
      .filter((r) => r.targetType === "series" || r.targetType === "journey"),
  },
  { label: "その他", routes: content.routes.renderable().filter((r) => r.targetType === "static") },
];

const labelOf = (target: Route): string => {
  switch (target.targetType) {
    case "article":
      return content.titleOf((target.targetId ?? "") as never) || target.path;
    case "location":
      return content.locations.nameOf((target.targetId ?? "") as never, "ja");
    case "series":
    case "journey":
      return content.collection((target.targetId ?? "") as never)?.title ?? target.path;
    default:
      return (
        PAGES[target.path]?.title ??
        (content.titleOf((target.targetId ?? "") as never) || target.path)
      );
  }
};
---

<BaseLayout
  metadata={metadata}
  jsonLd={[
    route.path === "/" ? buildWebSiteJsonLd(seoConfig) : null,
    buildBreadcrumbJsonLd(seoConfig, trail),
  ]}
>
  <Breadcrumbs trail={trail} />
  {
    route.path !== "/" && route.path !== "/posts" && route.path !== "/collections" && route.path !== "/destination" && (
      <header class="page-header">
        <h1>{page.title}</h1>
        <p>{page.description}</p>
      </header>
    )
  }

  {
    route.path === "/" && (
      <div class="home">
        {featuredStories.length > 0 && (
          <section class="home-hero" aria-labelledby="home-title">
            <div class="home-hero__slides" data-hero-carousel>
              {featuredStories.map((story, index) => {
                const cover = story.cover!;
                const country = content.relations.locations
                  .filter((relation) => relation.articleId === story.article.id)
                  .map((relation) => content.locations.countryOf(relation.locationId))
                  .find(Boolean);
                return (
                  <div
                    class:list={["home-hero__slide", index === 0 && "is-active"]}
                    data-hero-slide
                    aria-hidden={index === 0 ? "false" : "true"}
                  >
                    <Picture
                      storageKey={cover.asset.storageKey}
                      alt={cover.usage.alt}
                      sizes="(max-width: 760px) 100vw, 1100px"
                      loading={index === 0 ? "eager" : "lazy"}
                      fetchpriority={index === 0 ? "high" : "auto"}
                    />
                    <a class="home-hero__feature" href={story.route.path}>
                      <span class="eyebrow">
                        {country ? content.locations.nameOf(country.id, "ja") : "TRAVEL STORY"}
                      </span>
                      <strong>{story.revision.title}</strong>
                      <span>{story.revision.summary}</span>
                      <small>続きを読む&nbsp; →</small>
                    </a>
                  </div>
                );
              })}
            </div>
            <div class="home-hero__shade" />
            <div class="home-hero__intro">
              <p class="eyebrow">TOMOKICHI'S TRAVEL DIARY</p>
              <h1 id="home-title">
                次の冒険は、
                <br />
                どこへ？
              </h1>
              <p>
                世界を旅した記憶と体験、
                <br />
                そして次の旅のインスピレーションを。
              </p>
              <a class="button button--light" href="/posts">
                旅の記録を読む <span aria-hidden="true">→</span>
              </a>
            </div>
            <div class="home-hero__controls" aria-label="注目記事スライド">
              <button type="button" data-hero-prev aria-label="前の記事">
                ←
              </button>
              <div class="home-hero__dots">
                {featuredStories.map((_, index) => (
                  <button
                    type="button"
                    class:list={[index === 0 && "is-active"]}
                    data-hero-dot={index}
                    aria-label={`${index + 1}枚目を表示`}
                    aria-current={index === 0 ? "true" : undefined}
                  />
                ))}
              </div>
              <button type="button" data-hero-next aria-label="次の記事">
                →
              </button>
            </div>
          </section>
        )}

        <section class="home-discovery" aria-label="旅行日記を探す">
          <form action="/posts" method="get" role="search"><label class="sr-only" for="home-search">行き先・キーワードで検索</label><input id="home-search" name="q" type="search" placeholder="行き先・キーワードで検索" /><button type="submit" aria-label="検索"><SearchIcon /></button></form>
          <div><span>Popular</span>{continents.flatMap((continent) => continent.countries).slice(0, 6).map((country) => <a href={country.path}>{country.name}</a>)}</div>
          <a href="/destination">地図から探す&nbsp; →</a>
        </section>

        {homeArticleLead && homeArticleLead.cover && <section class="home-featured-stories" aria-labelledby="home-featured-heading">
          <div class="section-heading"><div><p class="eyebrow">EDITOR'S SELECTION</p><h2 id="home-featured-heading">まず読んでほしい旅行日記</h2><p>景色の記憶と、次の旅で役立つ実体験を選びました。</p></div><a href="/posts">すべての記事&nbsp; →</a></div>
          <div class="home-featured-stories__layout">
            <a class="home-lead-story" href={homeArticleLead.route.path}>
              <Picture storageKey={homeArticleLead.cover.asset.storageKey} alt={homeArticleLead.cover.usage.alt} sizes="(max-width: 760px) 100vw, 680px" loading="eager" />
              <span class="home-lead-story__shade"></span><span class="home-lead-story__copy"><small>{homeStoryLabel(homeArticleLead)}</small><strong>{homeArticleLead.revision.title}</strong><span>{homeArticleLead.revision.summary}</span><b>この日記を読む&nbsp; →</b></span>
            </a>
            <div class="home-side-stories">{homeArticleSide.map((story, index) => <a href={story.route.path}>{story.cover && <Picture storageKey={story.cover.asset.storageKey} alt={story.cover.usage.alt} sizes="(max-width: 760px) 35vw, 180px" loading={index < 2 ? "eager" : "lazy"} />}<span><small>{homeStoryLabel(story)}　{story.article.publishedAt?.slice(0, 10).replaceAll("-", ".")}</small><strong>{story.revision.title}</strong><b>読む&nbsp; →</b></span></a>)}</div>
          </div>
        </section>}

        <section class="home-section" aria-labelledby="latest-heading">
          <div class="section-heading">
            <div>
              <p class="eyebrow">LATEST BLOG</p>
              <h2 id="latest-heading">新着の旅行日記</h2>
            </div>
            <a href="/posts">
              すべての記事 <span aria-hidden="true">→</span>
            </a>
          </div>
          <ul class="card-grid home-card-grid">
            {homeLatest.map((view, index) => (
              <ArticleCard view={view} eager={index < 3} level={3} />
            ))}
          </ul>
        </section>

        <section class="home-explore" aria-labelledby="destinations-heading">
          <div class="section-heading">
            <div>
              <p class="eyebrow">EXPLORE THE WORLD</p>
              <h2 id="destinations-heading">地図から旅先を探す</h2>
              <p>
                {countryCount}の国と地域、{articles.length}本の実体験を記録しています。
              </p>
            </div>
            <a href="/destination">
              すべての旅先 <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="home-explore__grid">
            <WorldMap countries={continents.flatMap((continent) => continent.countries)} />

            <div class="popular-destinations">
              <div class="popular-destinations__title">
                <p class="eyebrow">POPULAR PLACES</p>
                <h3>人気の旅先</h3>
              </div>
              {popularDestinations.map((country, index) => (
                <a class="popular-place" href={country.path}>
                  <span class="popular-place__rank">0{index + 1}</span>
                  {country.cover && (
                    <Picture
                      storageKey={country.cover.asset.storageKey}
                      alt={country.cover.usage.alt}
                      sizes="96px"
                    />
                  )}
                  <span class="popular-place__copy">
                    <strong>{country.name}</strong>
                    <small>{country.count}件のブログ</small>
                  </span>
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </div>
        </section>

        <section class="home-journeys" aria-labelledby="home-journeys-heading">
          <div class="section-heading"><div><p class="eyebrow">JOURNEY COLLECTIONS</p><h2 id="home-journeys-heading">ひとつの旅を、順番にたどる</h2><p>出発から帰るまで。旅の流れに沿って読める旅行日記です。</p></div><a href="/collections">旅のまとまりを見る&nbsp; →</a></div>
          <div>{collections("journey").slice(0, 3).map((entry, index) => <a href={entry.path}>{entry.cover && <Picture storageKey={entry.cover.storageKey} alt={entry.collection.title} sizes="(max-width: 760px) 88vw, 380px" loading={index === 0 ? "eager" : "lazy"} />}<span class="home-journey-card__shade"></span><span class="home-journey-card__copy"><small>{entry.collection.startDate?.replaceAll("-", ".") ?? "旅の記録"}</small><strong>{entry.collection.title}</strong><span>{entry.collection.description}</span><b>{entry.count}本を順番に読む&nbsp; →</b></span></a>)}</div>
        </section>

        <section class="home-closing" aria-label="テーマとこのブログについて">
          <div class="home-themes"><div class="section-heading"><div><p class="eyebrow">TRAVEL THEMES</p><h2>好きな景色から読む</h2></div><a href="/collections">すべて見る&nbsp; →</a></div><div>{collections("series").slice(0, 3).map((entry) => <a href={entry.path}>{entry.cover && <Picture storageKey={entry.cover.storageKey} alt={entry.collection.title} sizes="(max-width: 760px) 45vw, 220px" />}<span><strong>{entry.collection.title}</strong><small>{entry.count}本の記録</small></span></a>)}</div></div>
          <aside class="home-author-card" aria-labelledby="home-about-heading"><Picture storageKey="images/Introduce/introduce.jpg" alt="旅先に立つともきち" sizes="(max-width: 760px) 100vw, 360px" /><div><p class="eyebrow">ABOUT THIS DIARY</p><h2 id="home-about-heading">はじめまして、<br />ともきちです。</h2><p>旅先で本当に役立ったこと、思いがけず心に残った景色を、自分の言葉と写真で記録しています。</p><a href="/about">このブログについて&nbsp; →</a></div></aside>
        </section>
      </div>
    )
  }

  {
    route.path === "/posts" && (
      <div class="posts-archive">
        <header class="posts-archive__masthead">
          <div>
            <p class="eyebrow">TRAVEL BLOG FOR YOUR NEXT JOURNEY</p>
            <h1>次の旅が、<br />ここから動き出す。</h1>
          </div>
          <div class="posts-archive__lead">
            <p>実際に歩いて、迷って、心が動いた旅の記録。行き先を決める前から、旅はもう始まっています。</p>
            <span><strong>{articles.length}</strong> posts</span>
          </div>
        </header>

        {archiveFeatured && archiveFeatured.cover && (
          <a class="posts-feature" href={archiveFeatured.route.path}>
            <Picture
              storageKey={archiveFeatured.cover.asset.storageKey}
              alt={archiveFeatured.cover.usage.alt}
              sizes="(max-width: 760px) 100vw, 1100px"
              loading="eager"
              fetchpriority="high"
            />
            <span class="posts-feature__shade"></span>
            <span class="posts-feature__copy">
              <small>FEATURED JOURNEY</small>
              <strong>{archiveFeatured.revision.title}</strong>
              <span>{archiveFeatured.revision.summary}</span>
              <b>この旅を読む <span aria-hidden="true">→</span></b>
            </span>
          </a>
        )}

        <section class="posts-discovery" aria-labelledby="all-stories-heading">
          <div class="posts-discovery__heading">
            <div><p class="eyebrow">EXPLORE THE BLOG</p><h2 id="all-stories-heading">旅のブログを探す</h2></div>
            <p><span data-archive-count>{archiveArticles.length}</span>件の旅</p>
          </div>
          <div class="posts-filter">
            <div class="posts-filter__primary">
              <label class="posts-filter__search">
                <SearchIcon />
                <span class="sr-only">記事を検索</span>
                <input type="search" placeholder="国・都市・空港・気になる体験から探す" data-archive-search />
              </label>
              <div class="posts-filter__selects">
                <label><span>旅先</span><select data-archive-country><option value="all">すべての国</option>{archiveCountries.map((country) => <option value={country.name.toLocaleLowerCase("ja")}>{country.name}（{country.count}）</option>)}</select></label>
                <label><span>並び順</span><select data-archive-sort><option value="newest">新しい順</option><option value="oldest">古い順</option><option value="title">タイトル順</option></select></label>
              </div>
            </div>
            <div class="posts-filter__chips" aria-label="カテゴリで絞り込む">
              <button class="is-active" type="button" data-archive-filter="all">すべて</button>
              {archiveCategories.map((category) => <button type="button" data-archive-filter={category.name.toLocaleLowerCase("ja")}>{category.name}<small>{category.count}</small></button>)}
            </div>
            <div class="posts-filter__footer"><p data-archive-summary>すべての記事を表示中</p><button type="button" data-archive-reset>条件をリセット</button></div>
          </div>
          <ul class="card-grid posts-grid" data-article-list>
            {archiveArticles.map((view, index) => (
              <ArticleCard view={view} eager={index < 3} level={3} variant="archive" searchText={archiveSearchText(view)} categoryText={archiveCategoryText(view)} countryText={archiveCountryText(view)} />
            ))}
          </ul>
          <p class="posts-empty" data-archive-empty hidden>まだ記録のない旅先です。別の条件でも探してみてください。</p>
          <nav class="posts-pagination" data-archive-pagination aria-label="記事一覧のページ"></nav>
        </section>
      </div>
    )
  }

  {
    route.path === "/destination" && (
      <div class="destination-index">
        <header class="destination-masthead">
          <div class="destination-masthead__copy">
            <p>旅先からブログを読む</p>
            <h1>心が向いた場所から、<br />次の旅を始めよう。</h1>
            <p>地図を眺める。国を選ぶ。街の記録を読む。まだ行き先が決まっていない時間も、旅の一部です。</p>
            <dl><div><dt>訪れた国</dt><dd>{countryCount}<small>か国</small></dd></div><div><dt>旅の記録</dt><dd>{articles.length}<small>本</small></dd></div><div><dt>地域</dt><dd>{continents.length}<small>エリア</small></dd></div></dl>
          </div>
          <div class="destination-masthead__mosaic" aria-hidden="true">
            {popularDestinations.slice(0, 3).map((country, index) => country.cover && <Picture storageKey={country.cover.asset.storageKey} alt="" sizes="(max-width: 760px) 50vw, 280px" loading={index === 0 ? "eager" : "lazy"} />)}
            <span>Where<br />to next?</span>
          </div>
        </header>

        <section class="destination-map-section" aria-labelledby="destination-map-heading">
          <div class="destination-section-heading"><div><small>地図から選ぶ</small><h2 id="destination-map-heading">世界を眺めて、気になる国へ</h2></div><p>オレンジのピンを選ぶと、その国のブログへ移動します。</p></div>
          <WorldMap countries={continents.flatMap((continent) => continent.countries)} />
        </section>

        <section class="destination-directory" aria-labelledby="destination-directory-heading">
          <div class="destination-section-heading"><div><small>国・都市から選ぶ</small><h2 id="destination-directory-heading">訪れた場所のすべて</h2></div><p><span data-destination-count>{countryCount}</span>か国を掲載しています。</p></div>
          <label class="destination-search"><SearchIcon /><span class="sr-only">国または都市を検索</span><input type="search" placeholder="国・都市名で絞り込む" data-destination-search /></label>
          <nav class="destination-tabs" aria-label="大陸で絞り込む"><button class="is-active" type="button" data-destination-filter="all">すべて</button>{continents.map((continent) => <button type="button" data-destination-filter={continent.name}>{continent.name}</button>)}</nav>
          <div class="destination-continents">
            {continents.map((continent) => (
              <section class="destination-continent" data-continent={continent.name}>
                <header><h3>{continent.name}</h3><span>{continent.countries.length}か国</span></header>
                <div class="destination-country-grid">
                  {continent.countries.map((country, index) => (
                    <a class="destination-country" href={country.path} data-destination-country data-search={`${country.name} ${country.cities.map((city) => city.name).join(" ")}`.toLocaleLowerCase("ja")}>
                      <span class="destination-country__media">
                        {country.cover ? <Picture storageKey={country.cover.asset.storageKey} alt={`${country.name}の旅`} sizes="(max-width: 760px) 50vw, 280px" loading={index < 4 ? "eager" : "lazy"} /> : <span class="destination-country__placeholder"></span>}
                        <b>{country.name}</b>
                      </span>
                      <span class="destination-country__body"><span>{country.count}本のブログ</span><small>{country.cities.slice(0, 3).map((city) => city.name).join("、") || "旅の記録を見る"}</small><i>詳しく見る&nbsp; →</i></span>
                    </a>
                  ))}
                </div>
              </section>
            ))}
          </div>
          <p class="destination-empty" data-destination-empty hidden>一致する旅先はまだありません。別の名前でも探してみてください。</p>
        </section>
      </div>
    )
  }

  {
    route.path === "/collections" && (
      <div class="collections-page">
        <header class="collections-hero">
          <p>旅のまとまりから読む</p>
          <h1>一つの旅を、<br />最初から最後まで。</h1>
          <div><span>{collections("journey").length}の旅程</span><span>{collections("series").length}のテーマ</span><span>{articles.length}本のブログ</span></div>
        </header>

        <section class="collections-group collections-group--journey" aria-labelledby="journey-collections-heading">
          <div class="collections-group__heading"><div><small>旅程コレクション</small><h2 id="journey-collections-heading">旅を順番にたどる</h2></div><p>出発から帰着まで、時系列でまとまった旅の記録です。</p></div>
          <div class="journey-collection-grid">
            {collections("journey").map((entry, index) => (
              <a class="journey-collection-card" href={entry.path}>
                {entry.cover && <Picture storageKey={entry.cover.storageKey} alt={entry.collection.title} sizes="(max-width: 760px) 100vw, 520px" loading={index < 2 ? "eager" : "lazy"} />}
                <span class="journey-collection-card__shade"></span>
                <span class="journey-collection-card__copy">
                  <small>{entry.collection.startDate ? `${entry.collection.startDate.replaceAll("-", ".")} — ${entry.collection.endDate?.replaceAll("-", ".") ?? ""}` : "旅の記録"}</small>
                  <strong>{entry.collection.title}</strong>
                  <span>{entry.collection.description}</span>
                  <b>{entry.count}本の記事</b>
                </span>
              </a>
            ))}
          </div>
        </section>

        <section class="collections-group" aria-labelledby="series-collections-heading">
          <div class="collections-group__heading"><div><small>テーマコレクション</small><h2 id="series-collections-heading">好きな景色から読む</h2></div><p>夕陽、建築、街並み。心が動いた瞬間をテーマ別に集めました。</p></div>
          <div class="series-collection-grid">
            {collections("series").map((entry, index) => (
              <a class="series-collection-card" href={entry.path}>
                {entry.cover && <Picture storageKey={entry.cover.storageKey} alt={entry.collection.title} sizes="(max-width: 760px) 50vw, 320px" loading={index < 3 ? "eager" : "lazy"} />}
                <span><small>{String(index + 1).padStart(2, "0")} / {String(collections("series").length).padStart(2, "0")}</small><strong>{entry.collection.title}</strong><span>{entry.collection.description}</span><b>{entry.count}本</b></span>
              </a>
            ))}
          </div>
        </section>
      </div>
    )
  }

  {
    route.path === "/gallery" && (
      <ul class="gallery">
        {galleryImages.map((item, index) => (
          <li>
            <Picture
              storageKey={item.asset.storageKey}
              alt={item.usage.alt}
              sizes={SIZES.gallery}
              loading={index < 8 ? "eager" : "lazy"}
            />
          </li>
        ))}
      </ul>
    )
  }

  {
    route.path === "/sitemap" &&
      sitemapGroups.map((group) => (
        <section class="section">
          <h2>{group.label}</h2>
          <ul>
            {group.routes.map((target) => (
              <li>
                <a href={target.path}>{labelOf(target)}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
  }
  <script>
    const query = new URLSearchParams(location.search).get("q")?.trim().toLocaleLowerCase("ja");
    if (query) {
      document.querySelectorAll<HTMLElement>("[data-article-list] > li").forEach((card) => {
        card.hidden = !card.textContent?.toLocaleLowerCase("ja").includes(query);
      });
    }

    const carousel = document.querySelector<HTMLElement>("[data-hero-carousel]");
    if (carousel) {
      const slides = [...carousel.querySelectorAll<HTMLElement>("[data-hero-slide]")];
      const hero = carousel.closest<HTMLElement>(".home-hero");
      const dots = [...(hero?.querySelectorAll<HTMLButtonElement>("[data-hero-dot]") ?? [])];
      let active = 0;
      let timer = 0;

      const show = (next: number) => {
        active = (next + slides.length) % slides.length;
        slides.forEach((slide, index) => {
          const current = index === active;
          slide.classList.toggle("is-active", current);
          slide.setAttribute("aria-hidden", String(!current));
        });
        dots.forEach((dot, index) => {
          dot.classList.toggle("is-active", index === active);
          if (index === active) dot.setAttribute("aria-current", "true");
          else dot.removeAttribute("aria-current");
        });
      };

      const stop = () => window.clearInterval(timer);
      const start = () => {
        stop();
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          timer = window.setInterval(() => show(active + 1), 6500);
        }
      };

      hero?.querySelector("[data-hero-prev]")?.addEventListener("click", () => {
        show(active - 1);
        start();
      });
      hero?.querySelector("[data-hero-next]")?.addEventListener("click", () => {
        show(active + 1);
        start();
      });
      dots.forEach((dot, index) =>
        dot.addEventListener("click", () => {
          show(index);
          start();
        }),
      );
      hero?.addEventListener("mouseenter", stop);
      hero?.addEventListener("mouseleave", start);
      hero?.addEventListener("focusin", stop);
      hero?.addEventListener("focusout", start);
      start();
    }

    const archiveSearch = document.querySelector<HTMLInputElement>("[data-archive-search]");
    const archiveFilters = [...document.querySelectorAll<HTMLButtonElement>("[data-archive-filter]")];
    const archiveCards = [...document.querySelectorAll<HTMLElement>("[data-article-list] > [data-search]")];
    const archiveGrid = document.querySelector<HTMLElement>("[data-article-list]");
    const archiveCountry = document.querySelector<HTMLSelectElement>("[data-archive-country]");
    const archiveSort = document.querySelector<HTMLSelectElement>("[data-archive-sort]");
    const archiveReset = document.querySelector<HTMLButtonElement>("[data-archive-reset]");
    const archiveSummary = document.querySelector<HTMLElement>("[data-archive-summary]");
    const archivePagination = document.querySelector<HTMLElement>("[data-archive-pagination]");
    const archiveCount = document.querySelector<HTMLElement>("[data-archive-count]");
    const archiveEmpty = document.querySelector<HTMLElement>("[data-archive-empty]");
    let activeArchiveFilter = "all";
    let archivePage = Math.max(1, Number(new URLSearchParams(location.search).get("page") ?? 1));
    const archivePageSize = 12;
    const renderPagination = (total: number) => {
      if (!archivePagination) return;
      archivePagination.replaceChildren();
      const pages = Math.ceil(total / archivePageSize);
      archivePagination.hidden = pages <= 1;
      if (pages <= 1) return;
      archivePage = Math.min(archivePage, pages);
      const addButton = (label: string, page: number, current = false, disabled = false) => {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = label;
        button.disabled = disabled;
        if (current) button.setAttribute("aria-current", "page");
        button.addEventListener("click", () => {
          archivePage = page;
          updateArchive(false);
          document.querySelector(".posts-discovery")?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
        archivePagination.append(button);
      };
      addButton("前へ", Math.max(1, archivePage - 1), false, archivePage === 1);
      for (let page = 1; page <= pages; page += 1) {
        if (pages > 7 && page > 2 && page < pages - 1 && Math.abs(page - archivePage) > 1) {
          if (page === 3 || page === pages - 2) {
            const separator = document.createElement("span"); separator.textContent = "…"; archivePagination.append(separator);
          }
          continue;
        }
        addButton(String(page), page, page === archivePage);
      }
      addButton("次へ", Math.min(pages, archivePage + 1), false, archivePage === pages);
    };
    const updateArchive = (resetPage = true) => {
      if (resetPage) archivePage = 1;
      const archiveQuery = archiveSearch?.value.trim().toLocaleLowerCase("ja") ?? "";
      let visible = 0;
      const matchedCards = archiveCards.filter((card) => {
        const haystack = card.dataset.search ?? "";
        const categories = (card.dataset.category ?? "").split("|");
        const countries = (card.dataset.country ?? "").split("|");
        const matches = (!archiveQuery || haystack.includes(archiveQuery)) && (activeArchiveFilter === "all" || categories.includes(activeArchiveFilter)) && (!archiveCountry || archiveCountry.value === "all" || countries.includes(archiveCountry.value));
        if (matches) visible += 1;
        return matches;
      });
      const sorted = archiveCards.toSorted((a, b) => {
        if (archiveSort?.value === "oldest") return (a.dataset.published ?? "").localeCompare(b.dataset.published ?? "");
        if (archiveSort?.value === "title") return (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "", "ja");
        return (b.dataset.published ?? "").localeCompare(a.dataset.published ?? "");
      });
      if (archiveGrid) archiveGrid.append(...sorted);
      archiveCards.forEach((card) => { card.hidden = true; });
      const matchedSet = new Set(matchedCards);
      const sortedMatches = sorted.filter((card) => matchedSet.has(card));
      sortedMatches.slice((archivePage - 1) * archivePageSize, archivePage * archivePageSize).forEach((card) => { card.hidden = false; });
      renderPagination(visible);
      if (archiveCount) archiveCount.textContent = String(visible);
      if (archiveEmpty) archiveEmpty.hidden = visible !== 0;
      if (archiveSummary) {
        const conditions = [archiveQuery && `「${archiveQuery}」`, activeArchiveFilter !== "all" && activeArchiveFilter, archiveCountry?.value !== "all" && archiveCountry?.selectedOptions[0]?.text.replace(/（.*）/, "")].filter(Boolean);
        archiveSummary.textContent = conditions.length > 0 ? `${conditions.join("・")}で絞り込み中` : "すべての記事を表示中";
      }
    };
    if (archiveSearch && query) archiveSearch.value = query;
    archiveSearch?.addEventListener("input", () => updateArchive());
    archiveCountry?.addEventListener("change", () => updateArchive());
    archiveSort?.addEventListener("change", () => updateArchive());
    archiveFilters.forEach((button) => button.addEventListener("click", () => {
      activeArchiveFilter = button.dataset.archiveFilter ?? "all";
      archiveFilters.forEach((item) => item.classList.toggle("is-active", item === button));
      updateArchive();
    }));
    archiveReset?.addEventListener("click", () => {
      if (archiveSearch) archiveSearch.value = "";
      if (archiveCountry) archiveCountry.value = "all";
      if (archiveSort) archiveSort.value = "newest";
      activeArchiveFilter = "all";
      archiveFilters.forEach((item) => item.classList.toggle("is-active", item.dataset.archiveFilter === "all"));
      updateArchive();
    });
    if (archiveCards.length > 0) updateArchive(false);

    const destinationSearch = document.querySelector<HTMLInputElement>("[data-destination-search]");
    const destinationFilters = [...document.querySelectorAll<HTMLButtonElement>("[data-destination-filter]")];
    const destinationCountries = [...document.querySelectorAll<HTMLElement>("[data-destination-country]")];
    const destinationContinents = [...document.querySelectorAll<HTMLElement>("[data-continent]")];
    const destinationCount = document.querySelector<HTMLElement>("[data-destination-count]");
    const destinationEmpty = document.querySelector<HTMLElement>("[data-destination-empty]");
    let activeDestination = "all";
    const updateDestinations = () => {
      const destinationQuery = destinationSearch?.value.trim().toLocaleLowerCase("ja") ?? "";
      let visible = 0;
      destinationCountries.forEach((country) => {
        const continent = country.closest<HTMLElement>("[data-continent]")?.dataset.continent ?? "";
        const matches = (activeDestination === "all" || activeDestination === continent) && (!destinationQuery || (country.dataset.search ?? "").includes(destinationQuery));
        country.hidden = !matches;
        if (matches) visible += 1;
      });
      destinationContinents.forEach((continent) => { continent.hidden = ![...continent.querySelectorAll<HTMLElement>("[data-destination-country]")].some((country) => !country.hidden); });
      if (destinationCount) destinationCount.textContent = String(visible);
      if (destinationEmpty) destinationEmpty.hidden = visible !== 0;
    };
    destinationSearch?.addEventListener("input", updateDestinations);
    destinationFilters.forEach((button) => button.addEventListener("click", () => {
      activeDestination = button.dataset.destinationFilter ?? "all";
      destinationFilters.forEach((item) => item.classList.toggle("is-active", item === button));
      updateDestinations();
    }));
  </script>
</BaseLayout>
