---
import type { LocationId, Route } from "@tomokichi/domain";
import { listPublicArticles } from "@tomokichi/domain";
import { buildBreadcrumbJsonLd, buildPageMetadata } from "@tomokichi/seo";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { content, now } from "../lib/content";
import { locationTrail } from "../lib/navigation";
import { heroVariantOf } from "../lib/hero-variation";
import { mediaUrl, seoConfig } from "../lib/site";
import Picture from "../components/Picture.astro";

interface Props {
  route: Route;
}

const { route } = Astro.props;
const locationId = (route.targetId ?? "") as LocationId;
const location = content.locations.get(locationId);
const name = content.locations.nameOf(locationId, "ja");

const descendants = content.locations.descendantIds(locationId);
const articles = listPublicArticles({
  articles: content.snapshot.articles,
  relations: content.relations,
  filter: { locationId, locationDescendants: descendants },
  now,
});
const views = articles.flatMap((article) => {
  const view = content.viewOf(article.id);
  return view ? [view] : [];
});

const children = content.locations.children(locationId).flatMap((child) => {
  const hub = content.routes.canonicalFor("location", child.id);
  const childIds = new Set([child.id, ...content.locations.descendantIds(child.id)]);
  const childViews = views.filter((view) =>
    content.relations.locations.some(
      (relation) => relation.articleId === view.article.id && childIds.has(relation.locationId),
    ),
  );
  return hub
    ? [
        {
          name: content.locations.nameOf(child.id, "ja"),
          path: hub.path,
          count: childViews.length,
          cover: childViews.find((view) => view.cover)?.cover ?? null,
        },
      ]
    : [];
});

const ancestors = content.locations.ancestors(locationId);
const parent = ancestors.at(-1);
const parentRoute = parent ? content.routes.canonicalFor("location", parent.id) : null;
const parentName = parent ? content.locations.nameOf(parent.id, "ja") : null;
const siblings = location?.parentId
  ? content.locations
      .children(location.parentId)
      .flatMap((sibling) => {
        if (sibling.id === locationId) return [];
        const siblingRoute = content.routes.canonicalFor("location", sibling.id);
        return siblingRoute
          ? [{ name: content.locations.nameOf(sibling.id, "ja"), path: siblingRoute.path }]
          : [];
      })
      .slice(0, 6)
  : [];
const photoLocations = new Set([locationId, ...descendants]);
const localPhotoViews = views.filter((view) => {
  const primary = content.primaryLocationOf(view.article.id);
  return primary && photoLocations.has(primary.id);
});
const diaryViews = localPhotoViews.filter((view) =>
  content.collectionsOf(view.article.id).some((item) => item.slug === "travel-diary"),
);
const visibleArticles = new Set(localPhotoViews.map((view) => view.article.id));
const journeyCovers = content.snapshot.collections
  .filter((collection) => collection.kind === "journey" && collection.coverMediaId)
  .flatMap((collection) => {
    const asset = content.snapshot.media.find((media) => media.id === collection.coverMediaId);
    if (!asset) return [];
    const relatedMembers = content
      .membersOf(collection.id)
      .filter((view) => visibleArticles.has(view.article.id));
    if (relatedMembers.length === 0) return [];
    const coverUse = relatedMembers.find((view) => view.cover?.asset.id === asset.id)?.cover;
    if (!coverUse) return [];
    return [
      {
        asset,
        alt: coverUse?.usage.alt ?? `${name}を旅したときの風景`,
        relatedCount: relatedMembers.length,
        startDate: collection.startDate ?? "",
      },
    ];
  })
  .toSorted((a, b) => b.relatedCount - a.relatedCount || b.startDate.localeCompare(a.startDate));
const journeyCover = journeyCovers[0];
const heroCover = journeyCover
  ? { asset: journeyCover.asset, usage: { alt: journeyCover.alt } }
  : (diaryViews.toReversed().find((view) => view.cover)?.cover ??
    localPhotoViews.find((view) => view.cover)?.cover ??
    null);
const heroPhotos = [
  ...(heroCover ? [heroCover] : []),
  ...[...diaryViews, ...localPhotoViews].flatMap((view) => (view.cover ? [view.cover] : [])),
]
  .filter(
    (photo, index, all) =>
      all.findIndex((candidate) => candidate.asset.storageKey === photo.asset.storageKey) === index,
  )
  .slice(0, 3);
const heroVariant = heroVariantOf(route.path);
const locationKind =
  location?.type === "country" ? "国" : location?.type === "city" ? "街" : "地域";

const trail = locationTrail(route);
const metadata = buildPageMetadata(seoConfig, {
  title: `${name}の記事`,
  description: `${name}に関する記事を${views.length}件掲載しています。実際に訪れた体験をもとにした観光情報や移動手段、費用の記録をまとめています。`,
  route,
  imageUrl: heroCover ? mediaUrl(heroCover.asset.storageKey) : null,
  noindex: route.noindex,
});
---

<BaseLayout metadata={metadata} jsonLd={[buildBreadcrumbJsonLd(seoConfig, trail)]}>
  <div class="location-page">
    <Breadcrumbs trail={trail} />
    <header
      class:list={[
        "location-hero",
        `location-hero--variant-${heroVariant}`,
        !heroCover && "location-hero--plain",
      ]}
    >
      <div class="location-hero__art" role="group" aria-label={`${name}の旅の写真`}>
        {heroPhotos.map((photo, index) => (
          <figure class:list={["location-hero__frame", `location-hero__frame--${index}`]}>
            <Picture
              storageKey={photo.asset.storageKey}
              alt={photo.usage.alt}
              sizes="(max-width: 760px) 100vw, 1200px"
              loading="eager"
              fetchpriority={index === 0 ? "high" : "auto"}
            />
            {index === 0 && (
              <figcaption class="location-hero__photo-note">
                <small>FIELD NOTES</small>
                <strong>{name}</strong>
              </figcaption>
            )}
          </figure>
        ))}
        {heroPhotos.length === 0 && (
          <div class="location-hero__media-placeholder" aria-hidden="true">
            A PLACE TO REMEMBER
          </div>
        )}
        <span class="location-hero__art-mark" aria-hidden="true">
          {locationKind} <i>✳</i> TRAVEL NOTES
        </span>
      </div>
      <div class="location-hero__content">
        <p class="location-hero__eyebrow">
          <span>DESTINATION</span>
          <i aria-hidden="true"></i>
          <span>{parentName ?? `旅した${locationKind}`}</span>
        </p>
        <h1>{name}</h1>
        <p>
          {name}
          で実際に歩いて見つけた景色、移動、食事。旅の前にも、旅を思い出すときにも役立つ記録をまとめました。
        </p>
        <dl>
          <div>
            <dt>TRAVEL STORIES</dt>
            <dd>
              {views.length}
              <small>本</small>
            </dd>
          </div>
          {children.length > 0 && (
            <div>
              <>
                <dt>{location?.type === "country" ? "PLACES VISITED" : "AREAS"}</dt>
                <dd>
                  {children.length}
                  <small>か所</small>
                </dd>
              </>
            </div>
          )}
        </dl>
        {views.length > 0 && (
          <a class="location-hero__link" href="#location-stories-title">
            旅の記録を読む <span aria-hidden="true">↓</span>
          </a>
        )}
      </div>
    </header>

    {children.length > 0 && (
      <section class="location-areas" aria-labelledby="location-areas-title">
        <header>
          <>
            <div>
              <>
                <small>{location?.type === "country" ? "街を選ぶ" : "エリアを選ぶ"}</small>
                <h2 id="location-areas-title">{name}を、もう少し近くから。</h2>
              </>
            </div>
            <p>気になる場所を選んで、現地での記録へ。</p>
          </>
        </header>
        <div class="location-area-grid">
          {children.map((child, index) => (
            <a
              class:list={["location-area-card", !child.cover && "location-area-card--plain"]}
              href={child.path}
            >
              {child.cover && (
                <Picture
                  storageKey={child.cover.asset.storageKey}
                  alt={`${child.name}の旅`}
                  sizes="(max-width: 760px) 50vw, 360px"
                  loading={index < 2 ? "eager" : "lazy"}
                />
              )}
              <span />
              <div>
                <strong>{child.name}</strong>
                <small>{child.count}本のブログ</small>
                <b>この街を見る&nbsp; →</b>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="location-stories" aria-labelledby="location-stories-title">
      <header>
        <div>
          <small>実際に歩いた記録</small>
          <h2 id="location-stories-title">{name}の旅ブログ</h2>
        </div>
        <p>
          <span>{views.length}</span>本の記事
        </p>
      </header>
      {views.length > 0 ? (
        <ul class="card-grid location-story-grid">
          {views.map((view, index) => (
            <ArticleCard
              view={view}
              eager={index < 2 && children.length === 0}
              level={3}
              variant="archive"
            />
          ))}
        </ul>
      ) : (
        <div class="location-no-stories">
          <>
            <h3>この場所の記録は、これから。</h3>
            <p>旅の景色と言葉を準備しています。ほかの旅先も覗いてみてください。</p>
            <a href="/destination">地図へ戻る</a>
          </>
        </div>
      )}
    </section>

    {(parentRoute || siblings.length > 0) && (
      <nav class="location-next" aria-label="周辺の旅先">
        <>
          <div>
            <>
              <small>もう少し旅を続ける</small>
              <h2>近くの旅先も見る</h2>
            </>
          </div>
          <div>
            {parentRoute && <a href={parentRoute.path}>{parentName}に戻る</a>}
            {siblings.map((sibling) => (
              <a href={sibling.path}>{sibling.name}</a>
            ))}
          </div>
        </>
      </nav>
    )}
    {location === undefined && <p>この地域の情報は準備中です。</p>}
  </div>
</BaseLayout>
