---
import type { ArticleId } from "@tomokichi/domain";
import { apiUrl } from "../lib/site";

interface Props {
  articleId: ArticleId;
  compact?: boolean;
  /** Kept with the reader's liked list, so it can be shown without another fetch. */
  title?: string;
  path?: string;
}

const { articleId, compact = false, title, path } = Astro.props;
---

<button
  class:list={["like-button", compact && "like-button--compact"]}
  type="button"
  data-like-button
  data-article-id={articleId}
  data-api-url={apiUrl}
  data-title={title}
  data-path={path}
  aria-pressed="false"
  aria-label="この記事にいいねする"
>
  <span class="like-button__heart" aria-hidden="true">
    ♡
  </span>
  <span class="like-button__label">いいね</span>
  <output class="like-button__count skeleton" aria-label="いいね数" data-like-count>
    —
  </output>
</button>

<script>
  import { visitorId } from "../lib/like-visitor";
  import { forget, onShelfChange, remember, shelf } from "../lib/my-trips";

  const allButtons = () => [...document.querySelectorAll<HTMLButtonElement>("[data-like-button]")];
  /** A page can show the same story twice (header and end of article, a card). */
  const sameStory = (button: HTMLButtonElement) =>
    allButtons().filter((other) => other.dataset.articleId === button.dataset.articleId);

  function paint(button: HTMLButtonElement, state: { count: number; liked: boolean }) {
    button.setAttribute("aria-pressed", String(state.liked));
    button.setAttribute(
      "aria-label",
      state.liked ? "この記事のいいねを取り消す" : "この記事にいいねする",
    );
    const heart = button.querySelector<HTMLElement>(".like-button__heart");
    const count = button.querySelector<HTMLOutputElement>(".like-button__count");
    if (heart) heart.textContent = state.liked ? "♥" : "♡";
    if (count) {
      // A row of zeroes says nothing; the number appears once there is one.
      count.textContent = state.count > 0 ? new Intl.NumberFormat("ja-JP").format(state.count) : "";
      count.classList.remove("skeleton");
    }
  }

  function render(button: HTMLButtonElement, state: { count: number; liked: boolean }) {
    for (const each of sameStory(button)) {
      each.dataset.loaded = "true";
      paint(each, state);
    }
    // The server's answer is the truth; the shelf follows it.
    const { path, title } = button.dataset;
    if (path && title) {
      if (state.liked) remember("liked", path, title);
      else forget("liked", path);
    }
  }

  function settle(button: HTMLButtonElement, text: string) {
    const count = button.querySelector<HTMLOutputElement>(".like-button__count");
    if (!count) return;
    count.textContent = text;
    count.classList.remove("skeleton");
  }

  /**
   * A listing page can carry a hundred cards, and fetching every count on load
   * meant a hundred requests before the reader had scrolled anywhere. Counts
   * are loaded when their button first comes into view instead.
   */
  function load(button: HTMLButtonElement) {
    if (button.dataset.loaded) return;
    button.dataset.loaded = "true";
    const endpoint = `${button.dataset.apiUrl}/v1/likes/${button.dataset.articleId}`;
    fetch(`${endpoint}?visitorId=${encodeURIComponent(visitorId())}`)
      .then((response) => (response.ok ? response.json() : Promise.reject(new Error("failed"))))
      .then((state) => render(button, state))
      .catch(() => settle(button, ""));
  }

  const buttons = allButtons().filter((button) => !button.dataset.ready);

  const observer =
    "IntersectionObserver" in window
      ? new IntersectionObserver(
          (entries, self) =>
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              self.unobserve(entry.target);
              load(entry.target as HTMLButtonElement);
            }),
          { rootMargin: "200px" },
        )
      : null;

  buttons.forEach((button) => {
    button.dataset.ready = "true";
    if (observer) observer.observe(button);
    else load(button);

    button.addEventListener("click", async () => {
      if (button.disabled) return;
      button.disabled = true;
      const endpoint = `${button.dataset.apiUrl}/v1/likes/${button.dataset.articleId}`;
      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ visitorId: visitorId() }),
        });
        if (!response.ok) throw new Error("like request failed");
        render(button, await response.json());
      } finally {
        button.disabled = false;
      }
    });
  });

  /*
   * A like or unlike in another tab changes the shelf here too. Buttons whose
   * story moved on or off the shelf ask the server again for the fresh count;
   * the rest are left alone. Changes made in this tab already match.
   */
  if (buttons.length > 0 && !document.documentElement.dataset.likeSync) {
    document.documentElement.dataset.likeSync = "true";
    onShelfChange(() => {
      const liked = new Set(shelf("liked").map((entry) => entry.path));
      const seen = new Set<string>();
      for (const button of allButtons()) {
        const { articleId, path } = button.dataset;
        if (!button.dataset.loaded || !articleId || !path || seen.has(articleId)) continue;
        seen.add(articleId);
        if (liked.has(path) !== (button.getAttribute("aria-pressed") === "true")) {
          sameStory(button).forEach((each) => delete each.dataset.loaded);
          load(button);
        }
      }
    });
  }
</script>
