---
import Picture from "../Picture.astro";
import { content } from "../../lib/content";

interface Props {
  /** Photos already on the page (the hero), so the strip does not repeat them. */
  exclude?: ReadonlySet<string>;
}

const { exclude = new Set<string>() } = Astro.props;

/**
 * One photo per story from the trips that moved the author most. Covers are
 * the photos the author chose to stand for a story, so they carry the
 * atmosphere better than whatever happens to come second in the body.
 */
const seen = new Set(exclude);
const photos = [...content.withExperience("unforgettable"), ...content.withExperience("moving")]
  .flatMap((view) => {
    const photo = view.cover;
    if (!photo || seen.has(photo.asset.storageKey)) return [];
    seen.add(photo.asset.storageKey);
    // A roundup spanning several countries has no single place to name.
    const countries = new Set(
      view.locations.flatMap(({ location }) => content.locations.countryOf(location.id)?.id ?? []),
    );
    const country = countries.size === 1 ? content.countryOf(view.article.id) : null;
    return [
      {
        photo,
        path: view.route.path,
        title: view.revision.title,
        place: country ? content.locations.nameOf(country.id, "ja") : null,
      },
    ];
  })
  .slice(0, 9);
// The wide photo takes a 2×2 block of a four-column grid, so 5 or 9 photos
// fill whole rows; anything in between leaves a hole in the last one.
const shown = photos.slice(0, photos.length >= 9 ? 9 : 5);
---

{
  shown.length >= 5 && (
    <section class="home-gallery" aria-labelledby="home-gallery-title">
      <header class="section-heading">
        <div>
          <p class="eyebrow">PHOTO JOURNAL</p>
          <h2 id="home-gallery-title">写真で、旅の空気を</h2>
          <p>言葉より先に伝わるもの。気になった一枚から、その旅の話へ。</p>
        </div>
        <a href="/gallery">ギャラリーをもっと見る&nbsp; →</a>
      </header>
      <ul class="home-gallery__mosaic">
        {shown.map((item, index) => (
          <li class:list={[index === 0 && "is-wide"]}>
            <a href={item.path}>
              <Picture
                storageKey={item.photo.asset.storageKey}
                alt={item.photo.usage.alt}
                sizes={
                  index === 0 ? "(max-width: 760px) 100vw, 560px" : "(max-width: 760px) 50vw, 280px"
                }
              />
              <span class="home-gallery__caption">
                {item.place && <small>{item.place}</small>}
                <span>{item.title}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
