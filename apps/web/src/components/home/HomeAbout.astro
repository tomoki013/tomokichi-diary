---
import Picture from "../Picture.astro";
---

<aside class="home-about" aria-labelledby="home-about-title">
  <div class="home-about__photo">
    <Picture
      storageKey="images/Introduce/introduce.jpg"
      alt="旅先に立つともきち"
      sizes="(max-width: 760px) 80vw, 360px"
    />
    <span class="home-about__tape" aria-hidden="true"></span>
  </div>

  <div class="home-about__copy">
    <p class="eyebrow">ABOUT THIS DIARY</p>
    <h2 id="home-about-title">はじめまして、ともきちです。</h2>
    <p>
      好きなのは、歴史を感じる建築と、その土地の空気を一変させる夕陽を眺める時間。有名な観光地だけでなく、現地のカフェや裏路地で、その土地の日常に溶け込む旅をしています。
    </p>
    <ul class="home-about__stance" aria-label="このブログの書き方">
      <li>自分の足で行った場所だけを書く</li>
      <li>うまくいかなかったことも、そのまま書く</li>
      <li>景色の感動と、次の旅に役立つことをセットで</li>
    </ul>
    <a href="/about">このブログについて&nbsp; →</a>
  </div>

  {/* The diary's mascot: a doodle, so it reads as a margin sketch, not a logo. */}
  <div class="home-about__buddy" aria-hidden="true">
    <p class="home-about__bubble">次はどこ行く？</p>
    <svg viewBox="0 0 120 100" width="120" height="100">
      <g
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M30 42c-9-2-15 8-12 20 2 7 7 7 10 2"></path>
        <path d="M90 42c9-2 15 8 12 20-2 7-7 7-10 2"></path>
        <path d="M30 40c0-14 13-22 30-22s30 8 30 22c0 17-12 30-30 30S30 57 30 40z"></path>
        <path d="M52 56c3 3 13 3 16 0"></path>
        <path d="M60 52v4"></path>
        <path d="M38 70c-4 6-6 14-5 22M82 70c4 6 6 14 5 22"></path>
        <path d="M44 86c10 5 22 5 32 0"></path>
      </g>
      <ellipse cx="60" cy="49" rx="5" ry="3.6" fill="currentColor"></ellipse>
      <circle cx="47" cy="40" r="3" fill="currentColor"></circle>
      <circle cx="73" cy="40" r="3" fill="currentColor"></circle>
      <path
        d="M56 62c1 5 7 5 8 0"
        fill="var(--buddy-tongue, #e98b7a)"
        stroke="currentColor"
        stroke-width="1.6"></path>
    </svg>
  </div>
</aside>
