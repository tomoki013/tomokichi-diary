---
import Picture from "../../Picture.astro";
import type { DiscoveryItem } from "../../../lib/home-discovery";

interface Props {
  items: readonly DiscoveryItem[];
}

/**
 * 発見: pages of a field notebook on graph paper. Each story is an entry —
 * a taped-in photo, the title, and the same labelled rows on every page so
 * entries compare at a glance. A row only exists when the article has it.
 */
const { items } = Astro.props;
---

<ol class="look-notebook">
  {items.map((item, index) => (
    <li class="look-notebook__entry">
      <p class="look-notebook__no">観察メモ {String(index + 1).padStart(2, "0")}</p>
      <h4>
        <a href={item.path} data-discovery-article={item.slug}>
          {item.title}
        </a>
      </h4>
      {item.cover && (
        <span class="look-notebook__photo">
          <Picture storageKey={item.cover.storageKey} alt={item.cover.alt} sizes="6rem" />
        </span>
      )}
      <dl>
        {item.place && (
          <div>
            <dt>地域</dt>
            <dd>{item.place}</dd>
          </div>
        )}
        {item.travelMonth && (
          <div>
            <dt>時期</dt>
            <dd>{item.travelMonth}</dd>
          </div>
        )}
      </dl>
    </li>
  ))}
</ol>
