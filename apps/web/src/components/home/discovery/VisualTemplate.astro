---
import Picture from "../../Picture.astro";
import type { DiscoveryItem } from "../../../lib/home-discovery";

interface Props {
  items: readonly DiscoveryItem[];
}

/**
 * Template A: photos first. One large print to fall into, the rest as a
 * contact sheet beside it. An article without a cover still gets a card, just
 * a written one.
 */
const { items } = Astro.props;
const [lead, ...rest] = items;
---

<div class="discovery-visual">
  {lead && (
    <article class:list={["discovery-visual__lead", !lead.cover && "is-text"]}>
      {lead.cover && (
        <span class="discovery-visual__print">
          <Picture
            storageKey={lead.cover.storageKey}
            alt={lead.cover.alt}
            sizes="(max-width: 46rem) 92vw, 44rem"
          />
        </span>
      )}
      <div class="discovery-visual__caption">
        {lead.place && <p class="discovery-place">{lead.place}</p>}
        <h4>
          <a href={lead.path} data-discovery-article={lead.slug}>
            {lead.title}
          </a>
        </h4>
        <p class="discovery-visual__summary">{lead.summary}</p>
      </div>
    </article>
  )}
  {rest.length > 0 && (
    <ul class="discovery-visual__grid">
      {rest.map((item) => (
        <li class:list={["discovery-visual__tile", !item.cover && "is-text"]}>
          {item.cover && (
            <span class="discovery-visual__print">
              <Picture
                storageKey={item.cover.storageKey}
                alt={item.cover.alt}
                sizes="(max-width: 46rem) 46vw, 18rem"
              />
            </span>
          )}
          <div class="discovery-visual__caption">
            {item.place && <p class="discovery-place">{item.place}</p>}
            <h4>
              <a href={item.path} data-discovery-article={item.slug}>
                {item.title}
              </a>
            </h4>
            {!item.cover && <p class="discovery-visual__summary">{item.summary}</p>}
          </div>
        </li>
      ))}
    </ul>
  )}
</div>
