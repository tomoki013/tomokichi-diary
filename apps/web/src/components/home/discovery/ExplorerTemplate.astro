---
import Picture from "../../Picture.astro";
import { explorerFacts, type DiscoveryItem } from "../../../lib/home-discovery";

interface Props {
  items: readonly DiscoveryItem[];
}

/**
 * Template C: cards to compare side by side. Every card lists the same rows
 * in the same order (`explorerFacts`), and a row only exists when the article
 * has the data.
 */
const { items } = Astro.props;
const [featured, ...rest] = items;
---

<div class="discovery-explorer">
  {featured && (
    <article class="discovery-explorer__featured">
      {featured.cover && (
        <span class="discovery-explorer__photo">
          <Picture
            storageKey={featured.cover.storageKey}
            alt={featured.cover.alt}
            sizes="(max-width: 46rem) 92vw, 30rem"
          />
        </span>
      )}
      <div class="discovery-explorer__body">
        <p class="discovery-explorer__badge">注目</p>
        <h4>
          <a href={featured.path} data-discovery-article={featured.slug}>
            {featured.title}
          </a>
        </h4>
        <p class="discovery-explorer__summary">{featured.summary}</p>
        <dl class="discovery-facts">
          {explorerFacts(featured).map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </article>
  )}
  {rest.length > 0 && (
    <ul class="discovery-explorer__cards">
      {rest.map((item) => (
        <li class="discovery-explorer__card">
          {item.cover && (
            <span class="discovery-explorer__photo">
              <Picture
                storageKey={item.cover.storageKey}
                alt={item.cover.alt}
                sizes="(max-width: 46rem) 28vw, 14rem"
              />
            </span>
          )}
          <div class="discovery-explorer__body">
            <h4>
              <a href={item.path} data-discovery-article={item.slug}>
                {item.title}
              </a>
            </h4>
            <dl class="discovery-facts">
              {explorerFacts(item).map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </li>
      ))}
    </ul>
  )}
</div>
