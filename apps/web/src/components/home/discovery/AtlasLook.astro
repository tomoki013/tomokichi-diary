---
import Picture from "../../Picture.astro";
import { latLonLabel, type LookProps } from "../../../lib/home-discovery";

type Props = LookProps;

/**
 * 発見: field notes from places. Each photo carries a map-pin tag with where
 * it was, and each note is headed the way a field note is: the spot's real
 * latitude and longitude, and when it was seen. The first find gets a wide
 * card of its own.
 */
const { items } = Astro.props;
---

<ul class="look-atlas">
  {items.map((item) => (
    <li class="look-atlas__find">
      <span class="look-atlas__photo">
        {item.cover && (
          <Picture
            storageKey={item.cover.storageKey}
            alt={item.cover.alt}
            sizes="(max-width: 46rem) 92vw, 22rem"
          />
        )}
        {item.place && <span class="look-atlas__pin">{item.place.split(" / ")[0]}</span>}
      </span>
      <div class="look-atlas__body">
        {(item.coordinates || item.travelMonth) && (
          <p class="look-atlas__coord">
            {item.coordinates && <span>{latLonLabel(item.coordinates)}</span>}
            {item.travelMonth && <span>{item.travelMonth}</span>}
          </p>
        )}
        <h4>
          <a href={item.path} data-discovery-article={item.slug}>
            {item.title}
          </a>
        </h4>
        <p class="look-summary">{item.summary}</p>
        {item.place && <p class="look-meta">{item.place}</p>}
      </div>
    </li>
  ))}
</ul>
