---
import Picture from "../../Picture.astro";
import type { DiscoveryItem } from "../../../lib/home-discovery";

interface Props {
  items: readonly DiscoveryItem[];
}

/**
 * Template: a manga page. Each story is a panel — the photo as the art, the
 * title in a speech bubble, place and month in the narration box. A story
 * without a photo gets screentone instead of art.
 */
const { items } = Astro.props;
---

<ul class="discovery-manga">
  {items.map((item) => (
    <li class:list={["discovery-manga__panel", !item.cover && "is-tone"]}>
      {item.cover && (
        <span class="discovery-manga__art">
          <Picture
            storageKey={item.cover.storageKey}
            alt={item.cover.alt}
            sizes="(max-width: 46rem) 92vw, 28rem"
          />
        </span>
      )}
      {(item.place || item.travelMonth) && (
        <p class="discovery-manga__narration">
          {[item.place, item.travelMonth].filter(Boolean).join("・")}
        </p>
      )}
      <h4 class="discovery-manga__bubble">
        <a href={item.path} data-discovery-article={item.slug}>
          {item.title}
        </a>
      </h4>
    </li>
  ))}
</ul>
