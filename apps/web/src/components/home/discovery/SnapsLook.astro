---
import Picture from "../../Picture.astro";
import type { DiscoveryItem } from "../../../lib/home-discovery";

interface Props {
  items: readonly DiscoveryItem[];
}

/**
 * 笑える: snapshots stuck on a fridge, each a little crooked, with the
 * title in a speech bubble pointing at the photo.
 */
const { items } = Astro.props;
---

<ul class="look-snaps">
  {items.map((item) => (
    <li class:list={["look-snaps__snap", !item.cover && "is-plain"]}>
      {item.cover && (
        <span class="look-snaps__photo">
          <Picture
            storageKey={item.cover.storageKey}
            alt={item.cover.alt}
            sizes="(max-width: 46rem) 44vw, 13rem"
          />
        </span>
      )}
      <h4 class="look-snaps__bubble">
        <a href={item.path} data-discovery-article={item.slug}>
          {item.title}
        </a>
      </h4>
      {item.place && <p class="look-meta">{item.place}</p>}
    </li>
  ))}
</ul>
