---
import Picture from "../../Picture.astro";
import type { LookProps } from "../../../lib/home-discovery";

type Props = LookProps;

/**
 * これは終わった…: prints that landed askew in the rain, drained of colour.
 * Pointing at one (where there is a pointer) brings it back upright and in
 * colour. Only what these stories carry is shown: no generic list of
 * troubles that did not happen in them.
 */
const { items } = Astro.props;
---

<div class="look-storm">
  <ul class="look-storm__pile">
    {items.map((item) => (
      <li class="look-storm__print">
        <span class="look-storm__photo">
          {item.cover && (
            <Picture
              storageKey={item.cover.storageKey}
              alt={item.cover.alt}
              sizes="(max-width: 46rem) 44vw, 13rem"
            />
          )}
        </span>
        {item.place && <p class="look-meta">{item.place.split(" / ")[0]}</p>}
        <h4>
          <a href={item.path} data-discovery-article={item.slug}>
            {item.title}
          </a>
        </h4>
      </li>
    ))}
  </ul>
</div>
