---
import type { ExperienceTag } from "@tomokichi/domain";
import BoardLook from "./BoardLook.astro";
import CinemaLook from "./CinemaLook.astro";
import PulseLook from "./PulseLook.astro";
import RainLook from "./RainLook.astro";
import MangaLook from "./MangaLook.astro";
import NotebookLook from "./NotebookLook.astro";
import LettersLook from "./LettersLook.astro";
import AlbumLook from "./AlbumLook.astro";
import { EXPERIENCE_COPY, experienceHref } from "../../../lib/experiences";
import { lookFor, type DiscoveryItem, type DiscoveryLookId } from "../../../lib/home-discovery";

interface Props {
  tag: ExperienceTag;
  items: readonly DiscoveryItem[];
  /** Every story with this feeling, not just the ones shown. */
  total: number;
}

/**
 * One feeling and its stories. The header is the same for every feeling so
 * it is always clear which one is showing — its name in large type and one
 * line on what kind of trip it was. Below it, the feeling's own look.
 */
const { tag, items, total } = Astro.props;
const copy = EXPERIENCE_COPY[tag];
const look = lookFor(tag);

const LOOKS: Record<DiscoveryLookId, typeof BoardLook> = {
  board: BoardLook,
  cinema: CinemaLook,
  pulse: PulseLook,
  rain: RainLook,
  manga: MangaLook,
  notebook: NotebookLook,
  letters: LettersLook,
  album: AlbumLook,
};
const Look = LOOKS[look];
---

<div
  class:list={["home-discovery__panel", `home-discovery__panel--${look}`]}
  style={`--exp-hue: ${copy.hue}`}
  data-experience={tag}
  data-announce={`${copy.label}の旅：${copy.lead}。${total}本`}
>
  <header class="mood-hero">
    <div class="mood-hero__text">
      <h3>{copy.label}の旅</h3>
      <p class="mood-hero__lead">{copy.lead}</p>
    </div>
    <p class="mood-hero__count">{total}本</p>
  </header>

  {items.length === 0 ? (
    <p class="home-discovery__empty">
      まだこの気分の旅の話はありません。<a href="/posts">すべての旅の話</a>から探してみてください。
    </p>
  ) : (
    <>
      <div class="home-discovery__look">
        <Look items={items} />
      </div>
      <a class="home-discovery__more" href={experienceHref(tag)}>
        {copy.label}の旅をもっと読む（{total}本）
      </a>
    </>
  )}
</div>
