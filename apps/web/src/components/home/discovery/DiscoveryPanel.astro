---
import type { ExperienceTag } from "@tomokichi/domain";
import Picture from "../../Picture.astro";
import { EXPERIENCE_COPY, experienceHref } from "../../../lib/experiences";
import type { DiscoveryItem } from "../../../lib/home-discovery";

interface Props {
  tag: ExperienceTag;
  items: readonly DiscoveryItem[];
  /** Every story with this feeling, not just the ones shown. */
  total: number;
}

/**
 * One feeling and its stories. The feeling has to read at a glance — its
 * colour, its name in large type and one line on what kind of trip it was — and
 * the stories underneath share one plain layout built for a phone: the first
 * large with its photo, the rest as rows with a thumbnail.
 */
const { tag, items, total } = Astro.props;
const copy = EXPERIENCE_COPY[tag];
const [lead, ...rest] = items;
const meta = (item: DiscoveryItem) => [item.place, item.travelMonth].filter(Boolean).join("　");
---

<div
  class="home-discovery__panel"
  style={`--exp-hue: ${copy.hue}`}
  data-experience={tag}
  data-announce={`${copy.label}の旅：${copy.lead}。${total}本`}
>
  <header class="mood-hero">
    <span class="mood-hero__mark" aria-hidden="true">
      {copy.mark}
    </span>
    <div class="mood-hero__text">
      <h3>{copy.label}の旅</h3>
      <p class="mood-hero__lead">{copy.lead}</p>
    </div>
    <p class="mood-hero__count">{total}本</p>
  </header>

  {!lead ? (
    <p class="home-discovery__empty">
      まだこの気分の旅の話はありません。<a href="/posts">すべての旅の話</a>から探してみてください。
    </p>
  ) : (
    <>
      <div class="mood-stories">
        <article class="mood-story mood-story--lead">
          {lead.cover && (
            <span class="mood-story__photo">
              <Picture
                storageKey={lead.cover.storageKey}
                alt={lead.cover.alt}
                sizes="(max-width: 46rem) 92vw, 30rem"
              />
            </span>
          )}
          <div class="mood-story__body">
            <h4>
              <a href={lead.path} data-discovery-article={lead.slug}>
                {lead.title}
              </a>
            </h4>
            <p class="mood-story__summary">{lead.summary}</p>
            {meta(lead) && <p class="mood-story__meta">{meta(lead)}</p>}
          </div>
        </article>
        {rest.length > 0 && (
          <ul class="mood-stories__rows">
            {rest.map((item) => (
              <li class="mood-story mood-story--row">
                {item.cover && (
                  <span class="mood-story__thumb">
                    <Picture storageKey={item.cover.storageKey} alt="" sizes="6rem" />
                  </span>
                )}
                <div class="mood-story__body">
                  <h4>
                    <a href={item.path} data-discovery-article={item.slug}>
                      {item.title}
                    </a>
                  </h4>
                  {meta(item) && <p class="mood-story__meta">{meta(item)}</p>}
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>
      <a class="home-discovery__more" href={experienceHref(tag)}>
        {copy.label}の旅をもっと読む（{total}本）&nbsp;→
      </a>
    </>
  )}
</div>
