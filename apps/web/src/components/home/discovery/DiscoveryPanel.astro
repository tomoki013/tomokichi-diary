---
import type { ExperienceTag } from "@tomokichi/domain";
import BoardScene from "./BoardScene.astro";
import CinemaScene from "./CinemaScene.astro";
import PulseScene from "./PulseScene.astro";
import CollapseScene from "./CollapseScene.astro";
import GachaScene from "./GachaScene.astro";
import LensScene from "./LensScene.astro";
import LettersScene from "./LettersScene.astro";
import DevelopScene from "./DevelopScene.astro";
import { EXPERIENCE_COPY, experienceHref } from "../../../lib/experiences";
import {
  templateFor,
  type DiscoveryItem,
  type DiscoveryTemplateId,
} from "../../../lib/home-discovery";

interface Props {
  tag: ExperienceTag;
  items: readonly DiscoveryItem[];
  /** Every story with this feeling, not just the ones shown. */
  total: number;
}

/**
 * One feeling on stage: a slim header, then the scene that feeling calls for.
 * The panel carries the scene id so the scene's styles and script can find it.
 */
const { tag, items, total } = Astro.props;
const copy = EXPERIENCE_COPY[tag];
const template = templateFor(tag);
const summary =
  items.length > 0 ? `${total}本のうち${items.length}本` : "まだこの気分の旅の話はありません";

const SCENES: Record<DiscoveryTemplateId, typeof BoardScene> = {
  board: BoardScene,
  cinema: CinemaScene,
  pulse: PulseScene,
  collapse: CollapseScene,
  gacha: GachaScene,
  lens: LensScene,
  letters: LettersScene,
  develop: DevelopScene,
};
const Scene = SCENES[template.id];
---

<div
  class:list={["home-discovery__panel", `home-discovery__panel--${template.id}`]}
  style={`--exp-hue: ${copy.hue}`}
  data-experience={tag}
  data-template={template.id}
  data-announce={`${copy.label}：${template.label}。${summary}`}
>
  <header class="home-discovery__head">
    <h3>
      <span aria-hidden="true">{copy.mark}</span>
      {copy.label}の旅
    </h3>
    <p class="home-discovery__meta">
      <span>{summary}</span>
    </p>
    <p class="home-discovery__cue" data-discovery-hint hidden>
      👆 {template.cue}
    </p>
  </header>

  {items.length === 0 ? (
    <p class="home-discovery__empty">
      別の気分を選ぶか、<a href="/posts">すべての旅の話</a>から探してみてください。
    </p>
  ) : (
    <>
      <Scene items={items} />
      <a class="home-discovery__more" href={experienceHref(tag)}>
        「{copy.label}」の記事をもっと読む（{total}本）&nbsp;→
      </a>
    </>
  )}
</div>
