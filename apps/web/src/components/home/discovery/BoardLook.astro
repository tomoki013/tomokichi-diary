---
import Picture from "../../Picture.astro";
import type { DiscoveryItem } from "../../../lib/home-discovery";

interface Props {
  items: readonly DiscoveryItem[];
}

/**
 * ワクワク: an airport departure board. Each story is a departure — month of
 * travel, the city on split-flap tiles (they clatter into place once, in
 * CSS), the country beside it and the story as the flight. Only the
 * article's own data; no flight numbers, gates or statuses are made up.
 */
const { items } = Astro.props;
const cityOf = (place: string | null) => place?.split(" / ")[0] ?? "どこかへ";
const countryOf = (place: string | null) => place?.split(" / ")[1] ?? null;
---

<div class="look-board">
  <p class="look-board__top" aria-hidden="true">
    <span>DEPARTURES</span>
    <span>出発案内</span>
  </p>
  <ol class="look-board__rows">
    {items.map((item, row) => (
      <li class="look-board__row">
        <span class="look-board__time">{item.travelMonth ?? "----.--"}</span>
        <span class="look-board__dest">
          <span class="sr-only">{cityOf(item.place)}</span>
          <span class="look-board__city" aria-hidden="true">
            {[...cityOf(item.place)].map((char, column) => (
              <span class="look-board__flap" style={`--d: ${row * 120 + column * 45}ms`}>
                {char}
              </span>
            ))}
          </span>
          {countryOf(item.place) && <small>{countryOf(item.place)}</small>}
        </span>
        <h4>
          <a href={item.path} data-discovery-article={item.slug}>
            {item.title}
          </a>
        </h4>
        {item.cover && (
          <span class="look-board__thumb">
            <Picture storageKey={item.cover.storageKey} alt="" sizes="4.5rem" />
          </span>
        )}
      </li>
    ))}
  </ol>
</div>
