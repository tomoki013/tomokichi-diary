---
import Picture from "../../Picture.astro";
import type { LookProps } from "../../../lib/home-discovery";

type Props = LookProps;

/**
 * 感動: one story in the spotlight on a dark stage — a large frame, then a
 * row of the photos the story itself carries, so the moment shows before a
 * word is read — and the rest as smaller moments beside it. This is the
 * feeling the page opens on, so it is the one most readers see.
 */
const { items } = Astro.props;
const [lead, ...rest] = items;
---

<div class="look-spotlight">
  {lead && (
    <article class="look-spotlight__lead">
      <span class="look-spotlight__photo">
        {lead.cover && (
          <Picture
            storageKey={lead.cover.storageKey}
            alt={lead.cover.alt}
            sizes="(max-width: 46rem) 92vw, 42rem"
          />
        )}
      </span>
      {lead.photos.length > 0 && (
        <span class="look-spotlight__film">
          {lead.photos.map((photo) => (
            <span>
              <Picture
                storageKey={photo.storageKey}
                alt={photo.alt}
                sizes="(max-width: 46rem) 30vw, 14rem"
              />
            </span>
          ))}
        </span>
      )}
      <div class="look-spotlight__caption">
        {(lead.place || lead.episode) && (
          <p class="look-pill">
            {[lead.place, lead.episode && `第${lead.episode.number}回`].filter(Boolean).join("・")}
          </p>
        )}
        <h4>
          <a href={lead.path} data-discovery-article={lead.slug}>
            {lead.title}
          </a>
        </h4>
        <p class="look-summary">{lead.summary}</p>
        <span class="look-arrow" aria-hidden="true"></span>
      </div>
    </article>
  )}
  {rest.length > 0 && (
    <ul class="look-spotlight__rest">
      {rest.map((item) => (
        <li>
          <span class="look-spotlight__thumb">
            {item.cover && (
              <Picture
                storageKey={item.cover.storageKey}
                alt={item.cover.alt}
                sizes="(max-width: 46rem) 44vw, 10rem"
              />
            )}
          </span>
          {item.place && <p class="look-meta">{item.place}</p>}
          <h4>
            <a href={item.path} data-discovery-article={item.slug}>
              {item.title}
            </a>
          </h4>
        </li>
      ))}
    </ul>
  )}
</div>
