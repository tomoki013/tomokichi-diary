---
import Picture from "../../Picture.astro";
import type { DiscoveryItem } from "../../../lib/home-discovery";

interface Props {
  items: readonly DiscoveryItem[];
}

/**
 * 笑える: a manga page. Each story is a panel — the photo as the art, the
 * title in a speech bubble, the city in the narration box.
 */
const { items } = Astro.props;
---

<ul class="look-manga">
  {items.map((item) => (
    <li class:list={["look-manga__panel", !item.cover && "is-tone"]}>
      {item.cover && (
        <span class="look-manga__art">
          <Picture
            storageKey={item.cover.storageKey}
            alt={item.cover.alt}
            sizes="(max-width: 46rem) 92vw, 30rem"
          />
        </span>
      )}
      {item.place && <p class="look-manga__narration">{item.place.split(" / ")[0]}</p>}
      <h4 class="look-manga__bubble">
        <a href={item.path} data-discovery-article={item.slug}>
          {item.title}
        </a>
      </h4>
    </li>
  ))}
</ul>
