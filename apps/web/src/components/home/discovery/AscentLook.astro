---
import Picture from "../../Picture.astro";
import { byTravelDate, type DiscoveryItem, type LookProps } from "../../../lib/home-discovery";

type Props = LookProps;

/**
 * 挑戦: a trail climbing up the page, one step per story, in the order the
 * trips happened. Each step is marked with when it was taken, so the climb
 * is the author's own, not a count; the latest is the summit.
 */
const items = byTravelDate<DiscoveryItem>(Astro.props.items);
---

<ol class="look-ascent">
  {items.map((item, index) => {
    const [year, month] = item.travelMonth?.split(".") ?? [];
    return (
      <li class="look-ascent__step">
        <span class="look-ascent__mark" aria-hidden="true">
          {year ? (
            <>
              <small>{year}</small>
              {Number(month)}月
            </>
          ) : (
            `${index + 1}`
          )}
        </span>
        <div class="look-ascent__body">
          <h4>
            <a href={item.path} data-discovery-article={item.slug}>
              {item.title}
            </a>
          </h4>
          {item.place && <p class="look-meta">{item.place}</p>}
        </div>
        <span class="look-ascent__thumb">
          {item.cover && (
            <Picture storageKey={item.cover.storageKey} alt={item.cover.alt} sizes="5.5rem" />
          )}
        </span>
      </li>
    );
  })}
</ol>
