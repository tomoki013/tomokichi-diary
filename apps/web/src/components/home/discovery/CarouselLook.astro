---
import Picture from "../../Picture.astro";
import type { DiscoveryItem } from "../../../lib/home-discovery";

interface Props {
  items: readonly DiscoveryItem[];
}

/**
 * ワクワク: a row of postcards to swipe through, like flicking past places
 * you could go next. Snaps one card at a time on a phone.
 */
const { items } = Astro.props;
---

<ul class="look-carousel">
  {items.map((item) => (
    <li class="look-carousel__card">
      <span class="look-carousel__photo">
        {item.cover && (
          <Picture
            storageKey={item.cover.storageKey}
            alt={item.cover.alt}
            sizes="(max-width: 46rem) 62vw, 15rem"
          />
        )}
      </span>
      <div class="look-carousel__body">
        {item.place && <p class="look-meta">{item.place}</p>}
        <h4>
          <a href={item.path} data-discovery-article={item.slug}>
            {item.title}
          </a>
        </h4>
      </div>
    </li>
  ))}
</ul>
