---
import Picture from "../../Picture.astro";
import type { DiscoveryItem } from "../../../lib/home-discovery";

interface Props {
  items: readonly DiscoveryItem[];
}

/**
 * 笑える: a capsule toy machine full of funny stories. Turn the handle, the
 * dome rattles, a capsule drops and pops open on one story. Every prize is
 * already in the page (hidden), so a draw only shows one — nothing is built
 * from strings. Without JavaScript the prizes are simply listed.
 */
const { items } = Astro.props;
const CAPSULE_HUES = [24, 350, 45, 160, 200, 265, 100, 220];
---

<div class="scene-gacha" data-gacha>
  <div class="scene-gacha__machine" data-gacha-machine hidden>
    <div class="scene-gacha__dome" aria-hidden="true">
      {CAPSULE_HUES.map((hue, index) => (
        <span class="scene-gacha__ball" style={`--hue: ${hue}; --i: ${index}`}></span>
      ))}
    </div>
    <div class="scene-gacha__body">
      <p class="scene-gacha__sign" aria-hidden="true">
        笑い話
        <br />
        ガチャ
      </p>
      <button type="button" class="scene-gacha__handle" data-gacha-turn>
        <span class="scene-gacha__knob" aria-hidden="true"></span>
        <span class="scene-gacha__label">回す</span>
      </button>
      <p class="scene-gacha__stock" aria-hidden="true">
        全{items.length}話入り
      </p>
    </div>
    <span class="scene-gacha__capsule" aria-hidden="true" data-gacha-capsule>
      <span></span>
      <span></span>
    </span>
  </div>

  <p class="scene-gacha__wait" data-gacha-wait hidden>
    ハンドルを回すと、笑える旅の話がひとつ出てきます
  </p>

  <ul class="scene-gacha__prizes" aria-live="polite">
    {items.map((item, index) => (
      <li class="scene-gacha__prize" data-gacha-prize={index}>
        {item.cover && (
          <span class="scene-gacha__photo">
            <Picture
              storageKey={item.cover.storageKey}
              alt={item.cover.alt}
              sizes="(max-width: 46rem) 92vw, 22rem"
            />
          </span>
        )}
        <div class="scene-gacha__card">
          <p class="scene-gacha__no">No.{String(index + 1).padStart(2, "0")}</p>
          <h4>
            <a href={item.path} data-discovery-article={item.slug}>
              {item.title}
            </a>
          </h4>
          <p class="scene-gacha__summary">{item.summary}</p>
          {item.place && <p class="scene-gacha__place">{item.place}</p>}
        </div>
      </li>
    ))}
  </ul>
</div>

<script>
  import { registerScene, replay } from "../../../lib/discovery-scenes";

  registerScene("gacha", (panel, motion, signal) => {
    const root = panel.querySelector<HTMLElement>("[data-gacha]");
    const machine = root?.querySelector<HTMLElement>("[data-gacha-machine]");
    const turn = root?.querySelector<HTMLButtonElement>("[data-gacha-turn]");
    const capsule = root?.querySelector<HTMLElement>("[data-gacha-capsule]");
    const wait = root?.querySelector<HTMLElement>("[data-gacha-wait]");
    if (!root || !machine || !turn || !capsule) return;
    const prizes = [...root.querySelectorAll<HTMLElement>("[data-gacha-prize]")];

    root.classList.add("is-live");
    machine.hidden = false;
    const drawn = prizes.some((prize) => prize.classList.contains("is-won"));
    if (wait) wait.hidden = drawn;

    let last = -1;
    let timer = 0;

    const reveal = (index: number) => {
      prizes.forEach((prize, i) => prize.classList.toggle("is-won", i === index));
      if (wait) wait.hidden = true;
      turn.disabled = false;
      // On a phone the prize lands under the machine; bring it into view.
      const won = prizes[index];
      if (won && won.getBoundingClientRect().bottom > innerHeight) {
        won.scrollIntoView({ block: "nearest", behavior: motion ? "smooth" : "auto" });
      }
    };

    turn.addEventListener(
      "click",
      () => {
        if (prizes.length === 0) return;
        // Never the same story twice in a row, when there is a choice.
        let index = Math.floor(Math.random() * prizes.length);
        if (prizes.length > 1 && index === last) index = (index + 1) % prizes.length;
        last = index;
        if (!motion) {
          reveal(index);
          return;
        }
        turn.disabled = true;
        prizes.forEach((prize) => prize.classList.remove("is-won"));
        capsule.style.setProperty("--hue", String((index * 47 + 24) % 360));
        replay(machine, "is-turning");
        timer = window.setTimeout(() => reveal(index), 1300);
      },
      { signal },
    );

    return () => {
      window.clearTimeout(timer);
      turn.disabled = false;
    };
  });
</script>
