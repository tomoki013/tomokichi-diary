---
import Picture from "../../Picture.astro";
import type { DiscoveryItem } from "../../../lib/home-discovery";

interface Props {
  items: readonly DiscoveryItem[];
}

/**
 * 忘れられない: a darkroom. Instant prints come out blank and slowly develop
 * under the red safelight; shake one (move over it, or tap) and it comes up
 * faster. As the last print finishes, the lights come up. Captions are
 * written from the start — only the pictures develop.
 */
const { items } = Astro.props;
---

<div class="scene-develop" data-develop>
  <p class="scene-develop__hint" aria-hidden="true" data-develop-hint hidden>
    写真を振ると（なぞる・タップ）、早く現像されます
  </p>
  <ul class="scene-develop__prints">
    {items.map((item) => (
      <li class="scene-develop__print" data-develop-print>
        <span class="scene-develop__photo">
          {item.cover ? (
            <Picture
              storageKey={item.cover.storageKey}
              alt={item.cover.alt}
              sizes="(max-width: 46rem) 44vw, 13rem"
            />
          ) : (
            <span class="scene-develop__blank" aria-hidden="true">
              ★
            </span>
          )}
        </span>
        <h4>
          <a href={item.path} data-discovery-article={item.slug}>
            {item.title}
          </a>
        </h4>
        {(item.place || item.travelMonth) && (
          <p class="scene-develop__note">
            {[item.place, item.travelMonth].filter(Boolean).join("　")}
          </p>
        )}
      </li>
    ))}
  </ul>
</div>

<script>
  import { registerScene } from "../../../lib/discovery-scenes";

  /** Seconds a print takes to develop on its own, and how much a shake speeds it. */
  const DEVELOP_S = 7;
  const SHAKE_BOOST = 5;

  registerScene("develop", (panel, motion, signal) => {
    const root = panel.querySelector<HTMLElement>("[data-develop]");
    if (!root) return;
    const prints = [...root.querySelectorAll<HTMLElement>("[data-develop-print]")];
    const hint = root.querySelector<HTMLElement>("[data-develop-hint]");

    if (!motion) {
      prints.forEach((print) => print.style.setProperty("--dev", "1"));
      panel.style.setProperty("--room", "1");
      return;
    }

    // Each visit starts a fresh batch in the dark.
    const progress = prints.map(() => 0);
    const shaking = prints.map(() => 0);
    prints.forEach((print, i) => {
      print.style.setProperty("--dev", "0");
      const shake = () => {
        shaking[i] = 600;
        print.classList.add("is-shaking");
      };
      print.addEventListener("pointermove", shake, { signal });
      print.addEventListener("pointerdown", shake, { signal });
    });
    panel.style.setProperty("--room", "0");
    if (hint) hint.hidden = false;

    let last = performance.now();
    let frame = requestAnimationFrame(function step(now) {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      let done = 0;
      prints.forEach((print, i) => {
        // A little stagger so the prints do not all come up in lockstep.
        const shake = shaking[i] ?? 0;
        const speed = (shake > 0 ? SHAKE_BOOST : 1) / (DEVELOP_S + i * 0.8);
        const value = Math.min(1, (progress[i] ?? 0) + dt * speed);
        progress[i] = value;
        shaking[i] = Math.max(0, shake - dt * 1000);
        if (shaking[i] === 0) print.classList.remove("is-shaking");
        print.style.setProperty("--dev", value.toFixed(3));
        if (value >= 1) done += 1;
      });
      const average = progress.reduce((sum, value) => sum + value, 0) / progress.length;
      panel.style.setProperty("--room", average.toFixed(3));
      if (done < prints.length) frame = requestAnimationFrame(step);
      else if (hint) hint.hidden = true;
    });

    return () => cancelAnimationFrame(frame);
  });
</script>
