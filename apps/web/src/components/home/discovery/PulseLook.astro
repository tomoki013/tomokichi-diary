---
import Picture from "../../Picture.astro";
import type { DiscoveryItem } from "../../../lib/home-discovery";

interface Props {
  items: readonly DiscoveryItem[];
}

/**
 * ハラハラ: a heart-monitor trace running across the top and hazard tape on
 * every story — tension you can see without touching anything.
 */
const { items } = Astro.props;
---

<div class="look-pulse">
  <div class="look-pulse__monitor" aria-hidden="true">
    <svg viewBox="0 0 400 60" preserveAspectRatio="none">
      <path
        pathLength="1000"
        d="M0 30 H60 L70 30 L76 12 L84 50 L92 4 L100 44 L106 30 H260 L270 30 L276 12 L284 50 L292 4 L300 44 L306 30 H400"
      ></path>
    </svg>
  </div>
  <ul class="look-pulse__cards">
    {items.map((item) => (
      <li class="look-pulse__card">
        {item.cover && (
          <span class="look-pulse__photo">
            <Picture
              storageKey={item.cover.storageKey}
              alt={item.cover.alt}
              sizes="(max-width: 46rem) 92vw, 28rem"
            />
          </span>
        )}
        <div class="look-pulse__body">
          {item.place && <p class="look-meta">{item.place}</p>}
          <h4>
            <a href={item.path} data-discovery-article={item.slug}>
              {item.title}
            </a>
          </h4>
          <p class="look-summary">{item.summary}</p>
        </div>
      </li>
    ))}
  </ul>
</div>
