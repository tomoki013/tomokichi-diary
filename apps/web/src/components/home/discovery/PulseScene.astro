---
import Picture from "../../Picture.astro";
import type { DiscoveryItem } from "../../../lib/home-discovery";

interface Props {
  items: readonly DiscoveryItem[];
}

/**
 * ハラハラ: a heart monitor pinned over the stories. Scroll down through them
 * (or point at one) and the trace races, the reading climbs toward the last
 * story and the card in view trembles.
 * The number is the *reader's* make-believe pulse — a toy, not a statistic
 * about the trip, and labelled as such for assistive tech by staying hidden.
 */
const { items } = Astro.props;
---

<div class="scene-pulse" data-pulse>
  <div class="scene-pulse__monitor" aria-hidden="true">
    <svg class="scene-pulse__trace" viewBox="0 0 400 60" preserveAspectRatio="none">
      <path d="M0 30 H60 L70 30 L76 12 L84 50 L92 4 L100 44 L106 30 H200 H260 L270 30 L276 12 L284 50 L292 4 L300 44 L306 30 H400"></path>
    </svg>
    <p class="scene-pulse__reading">
      <span>♥</span>
      <b data-pulse-bpm>72</b>
      <small>BPM</small>
    </p>
  </div>
  <ul class="scene-pulse__cards">
    {items.map((item) => (
      <li class="scene-pulse__card" data-pulse-card>
        {item.cover && (
          <span class="scene-pulse__photo">
            <Picture
              storageKey={item.cover.storageKey}
              alt={item.cover.alt}
              sizes="(max-width: 46rem) 92vw, 28rem"
            />
          </span>
        )}
        <div class="scene-pulse__body">
          {item.place && <p class="scene-pulse__place">{item.place}</p>}
          <h4>
            <a href={item.path} data-discovery-article={item.slug}>
              {item.title}
            </a>
          </h4>
          <p class="scene-pulse__summary">{item.summary}</p>
        </div>
      </li>
    ))}
  </ul>
</div>

<script>
  import { registerScene, watchCentre } from "../../../lib/discovery-scenes";

  const CALM = 72;
  const PEAK = 156;

  registerScene("pulse", (panel, motion, signal) => {
    const root = panel.querySelector<HTMLElement>("[data-pulse]");
    const reading = panel.querySelector<HTMLElement>("[data-pulse-bpm]");
    if (!root || !reading) return;
    const cards = [...root.querySelectorAll<HTMLElement>("[data-pulse-card]")];

    let bpm = CALM;
    let target = CALM;
    let frame = 0;

    // The reading eases toward its target instead of jumping, like a real monitor.
    const tick = () => {
      bpm += (target - bpm) * 0.08;
      reading.textContent = String(Math.round(bpm));
      root.style.setProperty("--beat", `${(60 / bpm).toFixed(2)}s`);
      frame = Math.abs(target - bpm) > 0.5 ? requestAnimationFrame(tick) : 0;
    };
    const aim = (value: number) => {
      target = value;
      root.classList.toggle("is-racing", value > CALM);
      if (!motion) {
        bpm = value;
        reading.textContent = String(value);
        return;
      }
      if (!frame) frame = requestAnimationFrame(tick);
    };
    // The further down the stories, the faster the heart: the last card peaks.
    const pulseFor = (card: HTMLElement) =>
      Math.round(CALM + ((cards.indexOf(card) + 1) / cards.length) * (PEAK - CALM));

    // Phone: whichever card sits in the middle of the screen sets the pulse.
    watchCentre(
      cards,
      (card, centred) => {
        if (!(card instanceof HTMLElement)) return;
        card.classList.toggle("is-centred", centred);
        if (centred) aim(pulseFor(card));
        else if (!cards.some((other) => other.classList.contains("is-centred"))) aim(CALM);
      },
      signal,
    );

    // Pointer and keyboard: the card being pointed at or focused.
    cards.forEach((card) => {
      const on = () => aim(pulseFor(card));
      const off = () => aim(CALM);
      card.addEventListener("pointerenter", (event) => event.pointerType === "mouse" && on(), {
        signal,
      });
      card.addEventListener("pointerleave", (event) => event.pointerType === "mouse" && off(), {
        signal,
      });
      card.addEventListener("focusin", on, { signal });
      card.addEventListener("focusout", off, { signal });
    });

    return () => cancelAnimationFrame(frame);
  });
</script>
