---
import type { DiscoveryItem } from "../../../lib/home-discovery";

interface Props {
  items: readonly DiscoveryItem[];
}

/**
 * 挑戦: sealed letters of challenge. Break the wax seal and the flap lifts,
 * the letter slides out and names the trip. Without JavaScript every letter
 * is already open. The numbering only tells the envelopes apart.
 */
const { items } = Astro.props;
const NUMERALS = ["一", "二", "三", "四", "五", "六", "七", "八"];
---

<div class="scene-letters" data-letters>
  <p class="scene-letters__intro" data-letters-intro hidden>
    封を切って、挑戦状を受け取ってください。
    <button type="button" class="scene-letters__all" data-letters-all>
      ぜんぶ開ける
    </button>
  </p>
  <ul class="scene-letters__stack">
    {items.map((item, index) => (
      <li class="scene-letter is-open" data-letter>
        <button
          type="button"
          class="scene-letter__seal"
          data-letter-seal
          aria-expanded="true"
          aria-controls={`letter-${item.slug}`}
          hidden
        >
          <span class="scene-letter__wax" aria-hidden="true">
            挑
          </span>
          <span class="scene-letter__open-label">
            挑戦状 其の{NUMERALS[index] ?? index + 1}を開ける
          </span>
        </button>
        <div class="scene-letter__paper" id={`letter-${item.slug}`}>
          <p class="scene-letter__to">挑戦状 其の{NUMERALS[index] ?? index + 1}</p>
          <h4>
            <a href={item.path} data-discovery-article={item.slug}>
              {item.title}
            </a>
          </h4>
          <p class="scene-letter__summary">{item.summary}</p>
          {(item.place || item.travelMonth) && (
            <p class="scene-letter__where">
              {[item.place, item.travelMonth].filter(Boolean).join("　")}
            </p>
          )}
        </div>
        <span class="scene-letter__flap" aria-hidden="true"></span>
      </li>
    ))}
  </ul>
</div>

<script>
  import { registerScene } from "../../../lib/discovery-scenes";

  const setOpen = (letter: HTMLElement, open: boolean) => {
    letter.classList.toggle("is-open", open);
    const seal = letter.querySelector<HTMLButtonElement>("[data-letter-seal]");
    seal?.setAttribute("aria-expanded", String(open));
    const paper = letter.querySelector<HTMLElement>(".scene-letter__paper");
    if (paper) paper.inert = !open;
  };

  registerScene("letters", (panel, _motion, signal) => {
    const root = panel.querySelector<HTMLElement>("[data-letters]");
    if (!root) return;
    const letters = [...root.querySelectorAll<HTMLElement>("[data-letter]")];
    const intro = root.querySelector<HTMLElement>("[data-letters-intro]");

    // First time on stage, seal everything up; afterwards keep what was opened.
    if (!root.classList.contains("is-live")) {
      root.classList.add("is-live");
      letters.forEach((letter) => setOpen(letter, false));
    }
    if (intro) intro.hidden = false;

    letters.forEach((letter) => {
      const seal = letter.querySelector<HTMLButtonElement>("[data-letter-seal]");
      if (!seal) return;
      seal.hidden = false;
      seal.addEventListener(
        "click",
        () => {
          setOpen(letter, true);
          letter.querySelector<HTMLAnchorElement>("h4 a")?.focus({ preventScroll: true });
        },
        { signal },
      );
    });

    root
      .querySelector("[data-letters-all]")
      ?.addEventListener("click", () => letters.forEach((letter) => setOpen(letter, true)), {
        signal,
      });
  });
</script>
