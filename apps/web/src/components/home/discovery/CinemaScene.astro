---
import Picture from "../../Picture.astro";
import type { DiscoveryItem } from "../../../lib/home-discovery";

interface Props {
  items: readonly DiscoveryItem[];
}

/**
 * 感動: a cinema. The lights go down, one photo fills a letterboxed screen
 * and drifts slowly closer, and the title comes up like a subtitle. A film
 * strip below (or a sideways swipe on the screen) picks the scene; it moves
 * on by itself every few seconds, with a pause button, and never on a reader
 * who asked for reduced motion.
 *
 * Without JavaScript the shots simply stack as captioned photos.
 */
const { items } = Astro.props;
---

<div class="scene-cinema" data-cinema>
  <div class="scene-cinema__screen">
    {items.map((item, index) => (
      <figure class:list={["scene-cinema__shot", index === 0 && "is-on"]} data-shot={index}>
        {item.cover && (
          <span class="scene-cinema__frame">
            <Picture
              storageKey={item.cover.storageKey}
              alt={item.cover.alt}
              sizes="(max-width: 60rem) 100vw, 60rem"
            />
          </span>
        )}
        <figcaption class="scene-cinema__subtitle">
          {item.place && <span class="scene-cinema__place">{item.place}</span>}
          <h4>
            <a href={item.path} data-discovery-article={item.slug}>
              {item.title}
            </a>
          </h4>
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="scene-cinema__controls" data-cinema-controls hidden>
    <ol class="scene-cinema__reel">
      {items.map((item, index) => (
        <li>
          <button
            type="button"
            class="scene-cinema__cut"
            data-cut={index}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            <span class="sr-only">
              シーン{index + 1}：{item.title}
            </span>
            {item.cover && (
              <span class="scene-cinema__thumb" aria-hidden="true">
                <Picture storageKey={item.cover.storageKey} alt="" sizes="7rem" />
              </span>
            )}
            <span class="scene-cinema__no" aria-hidden="true">
              SCENE {index + 1}
            </span>
          </button>
        </li>
      ))}
    </ol>
    <button type="button" class="scene-cinema__pause" data-cinema-pause aria-pressed="false">
      一時停止
    </button>
  </div>
</div>

<script>
  import { registerScene } from "../../../lib/discovery-scenes";

  const HOLD = 7000;

  registerScene("cinema", (panel, motion, signal) => {
    const root = panel.querySelector<HTMLElement>("[data-cinema]");
    if (!root) return;
    const shots = [...root.querySelectorAll<HTMLElement>("[data-shot]")];
    const cuts = [...root.querySelectorAll<HTMLButtonElement>("[data-cut]")];
    const pause = root.querySelector<HTMLButtonElement>("[data-cinema-pause]");
    root.classList.add("is-live");
    root.querySelector("[data-cinema-controls]")?.removeAttribute("hidden");

    let index = Math.max(
      0,
      shots.findIndex((shot) => shot.classList.contains("is-on")),
    );
    let paused = !motion;
    let held = false;
    let timer = 0;

    const show = (next: number) => {
      index = (next + shots.length) % shots.length;
      shots.forEach((shot, i) => {
        const on = i === index;
        shot.classList.toggle("is-on", on);
        // Off-screen shots keep their links out of the tab order.
        shot.inert = !on;
      });
      cuts.forEach((cut, i) => cut.setAttribute("aria-pressed", String(i === index)));
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (paused || held || shots.length < 2) return;
      timer = window.setTimeout(() => {
        show(index + 1);
        schedule();
      }, HOLD);
    };

    cuts.forEach((cut) =>
      cut.addEventListener(
        "click",
        () => {
          show(Number(cut.dataset.cut));
          schedule();
        },
        { signal },
      ),
    );

    if (pause) {
      if (!motion || shots.length < 2) pause.hidden = true;
      pause.addEventListener(
        "click",
        () => {
          paused = !paused;
          pause.setAttribute("aria-pressed", String(paused));
          pause.textContent = paused ? "再生" : "一時停止";
          schedule();
        },
        { signal },
      );
    }

    // Reading a subtitle should not be interrupted by the next scene.
    const hold = (value: boolean) => () => {
      held = value;
      schedule();
    };
    root.addEventListener("pointerenter", hold(true), { signal });
    root.addEventListener("pointerleave", hold(false), { signal });
    root.addEventListener("focusin", hold(true), { signal });
    root.addEventListener("focusout", hold(false), { signal });

    // Swipe the screen sideways to cut to the next or previous scene. A swipe
    // swallows the click that follows, so it never opens the story by accident.
    const screen = root.querySelector<HTMLElement>(".scene-cinema__screen");
    let startX = 0;
    let startY = 0;
    let swiped = false;
    screen?.addEventListener(
      "pointerdown",
      (event) => {
        startX = event.clientX;
        startY = event.clientY;
        swiped = false;
      },
      { signal },
    );
    screen?.addEventListener(
      "pointerup",
      (event) => {
        const dx = event.clientX - startX;
        if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(event.clientY - startY)) return;
        swiped = true;
        show(index + (dx < 0 ? 1 : -1));
        schedule();
      },
      { signal },
    );
    screen?.addEventListener(
      "click",
      (event) => {
        if (!swiped) return;
        event.preventDefault();
        event.stopPropagation();
        swiped = false;
      },
      { capture: true, signal },
    );

    show(index);
    schedule();
    return () => window.clearTimeout(timer);
  });
</script>
