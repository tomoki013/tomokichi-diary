---
import { SearchIcon } from "../TravelIcons";
import { content } from "../../lib/content";
import { EXPERIENCES, experienceHref } from "../../lib/experiences";
import { searchSuggestions } from "../../lib/search-suggestions";
import AdaptiveDiscovery from "./discovery/AdaptiveDiscovery.astro";

interface Props {
  /** Article ids featured elsewhere on the home page, passed on to the discovery area. */
  shownElsewhere?: ReadonlySet<string>;
}

/**
 * Search for a story, or pick one by how it felt. The mood tiles are the way
 * in for a reader who does not yet know where they want to go: with
 * JavaScript they reshape the stories right below them (each tile says which
 * look it brings), without it they open the filtered archive.
 */
const { shownElsewhere = new Set<string>() } = Astro.props;
const chips = EXPERIENCES.map((experience) => ({
  ...experience,
  count: content.withExperience(experience.tag).length,
})).filter((chip) => chip.count > 0);
const suggestions = searchSuggestions();
---

<section class="home-picker" id="home-stories" aria-labelledby="home-picker-title">
  <h2 id="home-picker-title">
    どんな旅の<span class="hand-underline">エピソード</span>をお探しですか？
  </h2>

  <form class="home-picker__search" action="/posts#results" method="get" role="search">
    <label class="sr-only" for="home-search">
      旅のエピソードを検索
    </label>
    <SearchIcon />
    <input id="home-search" name="q" type="search" placeholder="国・街・気になる出来事で検索" />
    <button type="submit">検索</button>
  </form>
  <ul class="home-picker__suggest" aria-label="検索の候補">
    {suggestions.map((term) => (
      <li>
        <a href={`/posts?q=${encodeURIComponent(term)}#results`}>{term}</a>
      </li>
    ))}
  </ul>

  <div class="home-picker__moods">
    <p class="home-picker__ask" id="home-picker-moods">
      <span>いまの気分は？</span>
      <small data-discovery-hint hidden>
        タップすると、すぐ下が気分に合わせて変わります
      </small>
    </p>
    <div class="home-picker__bar">
      <ul class="home-picker__tiles" aria-labelledby="home-picker-moods">
        {chips.map((chip) => (
          <li style={`--exp-hue: ${chip.hue}`}>
            <a
              class="home-picker__tile"
              href={experienceHref(chip.tag)}
              data-discovery-chip={chip.tag}
            >
              <span class="home-picker__tile-label">{chip.label}</span>
              <small>{chip.count}本</small>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Inside the same box as the bar, so the bar stays pinned over the scene. -->
    <AdaptiveDiscovery shownElsewhere={shownElsewhere} />
  </div>
</section>
