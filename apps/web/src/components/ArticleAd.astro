---
import { adsenseClient, articleAdSlot } from "../lib/site";
interface Props {
  unit?: string;
  placement?: "article_end" | "body_slot";
  slotKey?: string;
  variant?: "A" | "B" | "static";
}
const {
  unit = articleAdSlot,
  placement = "article_end",
  slotKey = "article-end",
  variant = "static",
} = Astro.props;
---

<aside
  class="article-ad"
  data-article-ad
  data-placement={placement}
  data-slot-key={slotKey}
  data-variant={variant}
  aria-label="広告"
>
  <small>広告</small>
  <div class="article-ad__space">
    {/* Not `adsbygoogle` until this slot requests: AdSense fills the first
        unprocessed `ins.adsbygoogle` on the page, so another slot's request
        would otherwise fill this one before its own placement rules ran. */}
    <ins
      class="article-ad__unit"
      style="display:inline-block;width:300px;height:250px"
      data-ad-client={adsenseClient}
      data-ad-slot={unit}
    ></ins>
  </div>
  <a href="/legal/cookies" data-ad-privacy>
    広告のプライバシー設定
  </a>
</aside>

<style>
  .article-ad {
    margin-block: 2.5rem;
    text-align: center;
  }
  .article-ad[data-placement="body_slot"] {
    margin-block: 4rem;
  }
  .article-ad small,
  .article-ad a {
    display: block;
    color: var(--ink-faint);
    font-size: 0.75rem;
  }
  .article-ad small {
    margin-bottom: 0.5rem;
  }
  .article-ad__space {
    width: 300px;
    height: 250px;
    margin: 0 auto 0.5rem;
  }
  @media (max-width: 349px) {
    .article-ad,
    html[data-ad-variant="B"] .article-ad[data-variant="B"] {
      display: none;
    }
  }
</style>

<script>
  import { mountArticleAds } from "../lib/ads";
  mountArticleAds();
</script>
