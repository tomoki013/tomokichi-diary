---
import { ShareIcon } from "./TravelIcons";

interface Props {
  title: string;
  text: string;
  url: string;
}

const { title, text, url } = Astro.props;
---

<button class="share-button" type="button" data-share-button data-title={title} data-text={text} data-url={url}>
  <ShareIcon /><span data-share-label>この旅を共有する</span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-share-button]").forEach((button) => {
    button.addEventListener("click", async () => {
      const payload = {
        title: button.dataset.title ?? document.title,
        text: button.dataset.text ?? "",
        url: button.dataset.url ?? location.href,
      };
      const label = button.querySelector<HTMLElement>("[data-share-label]");
      try {
        if (navigator.share) await navigator.share(payload);
        else {
          await navigator.clipboard.writeText(payload.url);
          if (label) label.textContent = "リンクをコピーしました";
          window.setTimeout(() => { if (label) label.textContent = "この旅を共有する"; }, 2200);
        }
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError") return;
        if (label) label.textContent = "共有できませんでした";
      }
    });
  });
</script>
