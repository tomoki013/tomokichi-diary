---
import type { AdPlan } from "../lib/monetization";
interface Props {
  plan: AdPlan;
}
const { plan } = Astro.props;
const experiment = plan.experiment;
---

{experiment && <script is:inline define:vars={{ experiment }}>
  // Assign each article view before the loader and reader measurements run.
  document.documentElement.dataset.adVariant = Math.random() < 0.5 ? "B" : "A";
  document.documentElement.dataset.adExperiment = experiment;
</script>}
