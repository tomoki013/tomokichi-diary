---
import type { KnowledgeCatalogEntry } from "@tomokichi/application";

interface Props {
  catalog: readonly KnowledgeCatalogEntry[];
  articleId: string;
}
const { catalog, articleId } = Astro.props;
const payload = JSON.stringify({ catalog, articleId }).replaceAll("<", "\\u003c");
---

<script type="application/json" id="webmcp-context" set:html={payload}></script>
<script>
  import { registerWebMcpTools } from "../lib/webmcp";
  import { trackSemanticEvent } from "../lib/analytics";
  import type { KnowledgeCatalogEntry } from "@tomokichi/application";

  const element = document.querySelector<HTMLScriptElement>("#webmcp-context");
  if (element?.textContent) {
    const context = JSON.parse(element.textContent) as {
      catalog: readonly KnowledgeCatalogEntry[];
      articleId: string;
    };
    const unregister = registerWebMcpTools(context.catalog, context.articleId);
    // Sent when the quick-answer panel is on screen, not on every article load:
    // the event was counting page views under the panel's name.
    const panel = document.querySelector(".knowledge-answer");
    if (panel && "IntersectionObserver" in globalThis) {
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        trackSemanticEvent({ name: "travel_knowledge_viewed", articleId: context.articleId });
      });
      observer.observe(panel);
    }
    globalThis.addEventListener("pagehide", unregister, { once: true });
  }
</script>
