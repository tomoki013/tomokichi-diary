---
import type { ArticleEmbed } from "@tomokichi/domain";
import CostReport from "./CostReport.astro";

interface Props {
  embed: ArticleEmbed;
}

const { embed } = Astro.props;
// Stored as plain names (["Omio"]); older payloads wrapped them as { name }.
const programs = ((embed.payload["programs"] ?? []) as (string | { name?: string })[])
  .map((program) => (typeof program === "string" ? program : program?.name))
  .filter((name): name is string => Boolean(name?.trim()));
---

{embed.type === "table" && embed.anchorKey === "cost-report" && (
  <CostReport payload={embed.payload as Parameters<typeof CostReport>[0]["payload"]} />
)}
{embed.type === "notice" && (
  <aside class="notice">
    <p>
      この記事にはプロモーションが含まれます。
      {programs.length > 0 && `（${programs.join("、")}）`}
      紹介の方針は<a href="/legal/affiliates">アフィリエイトポリシー</a>をご覧ください。
    </p>
  </aside>
)}
