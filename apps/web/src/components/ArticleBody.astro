---
import { getEntry, render } from "astro:content";
import type { ArticleEmbed } from "@tomokichi/domain";
import EmbedBlock from "./EmbedBlock.astro";
import { enhanceBodyImages } from "../lib/images";

interface Props {
  slug: string;
  embeds: readonly ArticleEmbed[];
}

const { slug, embeds } = Astro.props;
const entry = await getEntry("articles", slug);
if (!entry) throw new Error(`no exported body for article ${slug}`);

const embedByAnchor = new Map(embeds.map((embed) => [embed.anchorKey, embed]));

/**
 * `{{embed:key}}` markers survive Markdown rendering as their own paragraph.
 * Splitting on them keeps the body a single rendered document while letting
 * structured blocks be real components rather than serialised HTML.
 */
const PLACEHOLDER = /<p>\s*\{\{embed:([a-z0-9]+(?:-[a-z0-9]+)*)\}\}\s*<\/p>/g;
const html = entry.rendered?.html ?? null;
let headingIndex = 0;
const withHeadingIds = (value: string) =>
  value.replace(/<h([23])>(.*?)<\/h\1>/gi, (_match, level, inner) => {
    const text = inner.replace(/<[^>]+>/g, "").trim();
    const id = `section-${++headingIndex}-${text.replace(/\s+/g, "-").slice(0, 48)}`;
    return `<h${level} id="${id}">${inner}</h${level}>`;
  });
const segments = html === null ? null : withHeadingIds(enhanceBodyImages(html)).split(PLACEHOLDER);

const fallback = html === null ? await render(entry) : null;
const FallbackContent = fallback?.Content;
---

<div class="prose article-content">
  {
    segments === null ? (
      FallbackContent ? <FallbackContent /> : null
    ) : (
      segments.map((segment, index) =>
        index % 2 === 1 ? (
          embedByAnchor.has(segment) ? (
            <EmbedBlock embed={embedByAnchor.get(segment)!} />
          ) : null
        ) : (
          <Fragment set:html={segment} />
        ),
      )
    )
  }
</div>
