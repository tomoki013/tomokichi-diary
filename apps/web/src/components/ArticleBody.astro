---
import { getEntry, render } from "astro:content";
import type { ArticleEmbed } from "@tomokichi/domain";
import type { ArticleView } from "@tomokichi/application";
import ArticleAd from "./ArticleAd.astro";
import type { AdPlan } from "../lib/monetization";
import EmbedBlock from "./EmbedBlock.astro";
import { cardImageUrl, enhanceBodyImages } from "../lib/images";
import { enhanceAppleMusic } from "@tomokichi/contracts";
import { content } from "../lib/content";

interface Props {
  slug: string;
  adPlan?: AdPlan;
  embeds: readonly ArticleEmbed[];
  /** The article's own path, so relative links in the body resolve like a
      reader's browser resolves them rather than against the site root. */
  path: string;
}

const { slug, embeds, path, adPlan } = Astro.props;
const entry = await getEntry("articles", slug);
if (!entry) throw new Error(`no exported body for article ${slug}`);

const embedByAnchor = new Map(embeds.map((embed) => [embed.anchorKey, embed]));

/**
 * `{{embed:key}}` markers survive Markdown rendering as their own paragraph.
 * Splitting on them keeps the body a single rendered document while letting
 * structured blocks be real components rather than serialised HTML.
 */
const PLACEHOLDER = /<p>\s*\{\{((?:embed|monetization):[a-z0-9]+(?:-[a-z0-9]+)*)\}\}\s*<\/p>/g;
const html = entry.rendered?.html ?? null;
if (html === null && entry.body?.includes("{{monetization:")) {
  throw new Error(
    "MONETIZATION_INVALID: rendered HTML is required to remove private placement markers",
  );
}
let headingIndex = 0;
const escapeHtml = (value: string) =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll('"', "&quot;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;");
const ORIGIN = "https://tomokichidiary.com";
const internalCard = (href: string): string | null => {
  let pathname = href;
  try {
    // Bodies are written with links like `./other-article`, which resolve
    // against the article they sit in. Resolving them against the site root
    // produced `/other-article`, matched no route, and quietly left every one
    // of them as a bare inline link.
    pathname = new URL(href, new URL(path, ORIGIN)).pathname;
  } catch {
    return null;
  }
  const route = content.routes.find(pathname);
  if (!route || !route.targetId) return null;
  let title = "";
  let summary = "";
  let cover: ArticleView["cover"] = null;
  let label = "RELATED BLOG";
  if (route.targetType === "article") {
    const view = content.viewOf(route.targetId as never);
    if (!view || view.article.kind !== "article") return null;
    title = view.revision.title;
    summary = view.revision.summary;
    cover = view.cover;
  } else if (route.targetType === "location") {
    title = content.locations.nameOf(route.targetId as never, "ja");
    const related = content.publicArticles().flatMap((article) => {
      const view = content.viewOf(article.id);
      if (!view || article.kind !== "article") return [];
      const matches = content.relations.locations.some((relation) => {
        if (relation.articleId !== article.id) return false;
        return (
          relation.locationId === route.targetId ||
          content.locations.countryOf(relation.locationId)?.id === route.targetId
        );
      });
      return matches ? [view] : [];
    });
    cover = related.find((view) => view.cover)?.cover ?? null;
    summary = `${title}で訪れた場所、移動、心に残った景色をまとめて読む。`;
    label = "EXPLORE DESTINATION";
  } else if (route.targetType === "series" || route.targetType === "journey") {
    const collection = content.collection(route.targetId as never);
    if (!collection) return null;
    title = collection.title;
    summary = collection.description ?? "";
    cover = content.membersOf(collection.id).find((member) => member.cover)?.cover ?? null;
    label = "TRAVEL COLLECTION";
  } else {
    return null;
  }
  const image = cover
    ? `<span class="internal-link-card__media"><img src="${escapeHtml(cardImageUrl(cover.asset.storageKey))}" alt="${escapeHtml(cover.usage.alt)}" loading="lazy" decoding="async"></span>`
    : `<span class="internal-link-card__media internal-link-card__media--empty" aria-hidden="true"><span>TRAVEL<br>NOTE</span></span>`;
  return `<aside class="internal-link-card" aria-label="関連コンテンツ"><a href="${escapeHtml(route.path)}">${image}<span class="internal-link-card__copy"><small>${label}</small><strong>${escapeHtml(title)}</strong><span>${escapeHtml(summary)}</span><b>詳しく見る <span aria-hidden="true">→</span></b></span></a></aside>`;
};
const withInternalLinkCards = (value: string) =>
  value.replace(
    /<(p|li)>\s*<a href="([^"]+)"(?:\s[^>]*)?>(.*?)<\/a>\s*<\/\1>/gi,
    (match, _tag, href) => internalCard(href) ?? match,
  );
const withHeadingIds = (value: string) =>
  value.replace(/<h([23])>(.*?)<\/h\1>/gi, (_match, level, inner) => {
    const text = inner.replace(/<[^>]+>/g, "").trim();
    const id = `section-${++headingIndex}-${text.replace(/\s+/g, "-").slice(0, 48)}`;
    return `<h${level} id="${id}">${inner}</h${level}>`;
  });
const segments =
  html === null
    ? null
    : withInternalLinkCards(withHeadingIds(enhanceAppleMusic(enhanceBodyImages(html)))).split(
        PLACEHOLDER,
      );

const fallback = html === null ? await render(entry) : null;
const FallbackContent = fallback?.Content;
---

<div class="prose article-content">
  {segments === null ? (
    FallbackContent ? (
      <FallbackContent />
    ) : null
  ) : (
    segments.map((segment, index) =>
      index % 2 === 1 ? (
        segment.startsWith("monetization:") ? (
          adPlan?.marker?.key === segment.slice(13) ? (
            <ArticleAd
              unit={adPlan.marker.unit}
              placement="body_slot"
              slotKey={adPlan.marker.key}
              variant={adPlan.marker.variant}
            />
          ) : null
        ) : embedByAnchor.has(segment.slice(6)) ? (
          <EmbedBlock embed={embedByAnchor.get(segment.slice(6))!} />
        ) : null
      ) : (
        <Fragment set:html={segment.replace(/\{\{monetization:[^}\n]*\}\}/g, "")} />
      ),
    )
  )}
</div>
