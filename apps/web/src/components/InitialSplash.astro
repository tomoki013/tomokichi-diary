<div class="initial-splash" data-initial-splash role="status" aria-live="polite">
  <div class="splash-flight" aria-hidden="true">
    <svg viewBox="0 0 300 150" fill="none">
      <defs>
        <linearGradient id="splash-trail" x1="0" y1="1" x2="1" y2="0">
          <stop offset="0%" stop-color="#b9b7ad"></stop>
          <stop offset="100%" stop-color="#4c5b2d"></stop>
        </linearGradient>
      </defs>
      <path class="splash-guide" d="M20,120 C90,120 150,55 280,28"></path>
      <path class="splash-trail" d="M20,120 C90,120 150,55 280,28" pathLength="350"></path>
      <circle class="splash-start" cx="20" cy="120" r="4"></circle>
      <circle class="splash-end-glow" cx="280" cy="28" r="11"></circle>
      <circle class="splash-end" cx="280" cy="28" r="4.5"></circle>
      <g class="splash-plane">
        <path
          d="M10,0 L2,-1.2 L-2.5,-6 L-1.6,-1.4 L-7.5,-1 L-10,-3 L-8.8,-0.8 L-10.5,-0.8 L-10.5,0.8 L-8.8,0.8 L-10,3 L-7.5,1 L-1.6,1.4 L-2.5,6 L2,1.2 Z"
        ></path>
      </g>
    </svg>
  </div>
  <div class="splash-copy">
    <span>THE NEXT JOURNEY BEGINS</span>
    <strong>ともきちの旅行日記</strong>
    <small>一生モノの体験を、もっと身近に。</small>
  </div>
</div>

<script is:inline>
  (() => {
    const splash = document.querySelector("[data-initial-splash]");
    if (!(splash instanceof HTMLElement)) return;
    const key = "tomokichi-splash-seen-v2";
    try {
      if (sessionStorage.getItem(key) === "1") {
        splash.remove();
        return;
      }
      sessionStorage.setItem(key, "1");
    } catch {
      // Show the entrance once when storage is unavailable rather than blocking the page.
    }
    const started = performance.now();
    let isExiting = false;
    const exit = () => {
      if (isExiting) return;
      isExiting = true;
      const delay = Math.max(0, 1450 - (performance.now() - started));
      window.setTimeout(() => {
        splash.classList.add("is-exiting");
        window.setTimeout(() => splash.remove(), 950);
      }, delay);
    };
    if (document.readyState === "complete") exit();
    else window.addEventListener("load", exit, { once: true });
    window.setTimeout(exit, 4000);
  })();
</script>
