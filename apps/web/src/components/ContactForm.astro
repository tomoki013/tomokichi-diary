---
import { apiUrl, turnstileSiteKey } from "../lib/site";

/**
 * A plain form POST to the API: submitting needs no JavaScript, and the API
 * redirects back here with a result in the query string. Turnstile is the only
 * script on the page, and without a site key the form is not rendered at all
 * rather than shipped unprotected.
 */
/**
 * Shows the result banner after the API redirects back. Kept as a string
 * because the markup below sits inside a conditional expression, where an
 * element's children are parsed as JSX rather than as script text.
 */
const RESULT_SCRIPT = `
  var params = new URLSearchParams(location.search);
  var result = params.get("sent") ? "sent" : params.get("error");
  var message = result && document.querySelector('[data-message="' + result + '"]');
  if (message) {
    message.hidden = false;
    message.scrollIntoView({ block: "center" });
  }
  var submit = document.querySelector('[data-contact-submit]');
  var count = document.querySelector('[data-contact-count]');
  var body = document.querySelector('[data-contact-body]');
  window.contactTurnstileReady = function () {
    if (submit) submit.disabled = false;
  };
  window.contactTurnstileReset = function () {
    if (submit) submit.disabled = true;
  };
  if (body && count) {
    var updateCount = function () { count.textContent = String(body.value.length); };
    body.addEventListener('input', updateCount);
    updateCount();
  }
`;

const MESSAGES = [
  ["sent", "ok", "お問い合わせを受け付けました。ありがとうございます。"],
  ["challenge", "error", "認証に失敗しました。もう一度お試しください。"],
  ["invalid", "error", "入力内容をご確認のうえ、もう一度お試しください。"],
  ["toofast", "error", "送信間隔が短すぎます。しばらく時間をおいてからお試しください。"],
] as const;
---

{
  turnstileSiteKey === "" ? (
    <p class="notice contact-form__notice">
      現在フォームを準備中です。お急ぎの場合はメールをご利用ください。
    </p>
  ) : (
    <div>
      {MESSAGES.map(([key, tone, text]) => (
        <p class:list={["form-message", `form-message--${tone}`]} data-message={key} hidden>
          {text}
        </p>
      ))}

      <form class="contact-form" method="post" action={`${apiUrl}/v1/contact`}>
        <div class="contact-form__row">
          <label>
            <span>
              お名前 <small>必須</small>
            </span>
            <input
              type="text"
              name="name"
              required
              maxlength="100"
              autocomplete="name"
              placeholder="ともきち"
            />
          </label>
          <label>
            <span>
              メールアドレス <small>必須</small>
            </span>
            <input
              type="email"
              name="email"
              required
              maxlength="254"
              autocomplete="email"
              placeholder="you@example.com"
            />
          </label>
        </div>
        <label>
          <span>
            お問い合わせの種類 <small>必須</small>
          </span>
          <select name="subject" required>
            <option value="" selected disabled>
              選択してください
            </option>
            <option value="記事について">記事について</option>
            <option value="旅先・記事のリクエスト">旅先・記事のリクエスト</option>
            <option value="お仕事・取材の相談">お仕事・取材の相談</option>
            <option value="写真の利用について">写真の利用について</option>
            <option value="その他">その他</option>
          </select>
        </label>
        <label>
          <span>
            お問い合わせ内容 <small>必須</small>
          </span>
          <textarea
            name="body"
            rows="9"
            required
            minlength="10"
            maxlength="4000"
            placeholder="できるだけ具体的にご記入ください。"
            data-contact-body
          />
          <small class="contact-form__count">
            <span data-contact-count>0</span> / 4000
          </small>
        </label>

        {/* Not shown to anyone reading the page; only automation fills it in. */}
        <div class="honeypot" aria-hidden="true">
          <label>
            <span>Website</span>
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="contact-form__verification">
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-language="ja"
            data-action="contact"
            data-theme="light"
            data-appearance="interaction-only"
            data-callback="contactTurnstileReady"
            data-expired-callback="contactTurnstileReset"
            data-timeout-callback="contactTurnstileReset"
          />
          <p>送信ボタンを押す前に、セキュリティ確認を完了してください。</p>
        </div>
        <button type="submit" data-contact-submit disabled>
          <>
            <span>メッセージを送る</span>
            <span aria-hidden="true">→</span>
          </>
        </button>
      </form>

      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
      <script is:inline set:html={RESULT_SCRIPT} />
    </div>
  )
}
