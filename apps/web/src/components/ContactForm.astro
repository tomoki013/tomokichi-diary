---
import { CONTACT_TOPICS, contactTopicsIn, type ContactLane } from "@tomokichi/domain";
import { apiUrl, turnstileSiteKey } from "../lib/site";

interface Props {
  /**
   * Only this lane's topics. Unset lists every topic; a page of its own for
   * one lane (media enquiries, say) passes it.
   */
  lane?: ContactLane;
}

const { lane } = Astro.props;
const topics = lane ? contactTopicsIn(lane) : CONTACT_TOPICS;

/**
 * Submitted with fetch so that any failure — a refused challenge, an API error,
 * no network — is shown next to the form with what was typed still in it. The
 * plain form POST below is only the fallback for a browser without fetch; the
 * API redirects that back here with the result in the query string. Turnstile
 * is the only third-party script on the page, and without a site key the form
 * is not rendered at all rather than shipped unprotected.
 *
 * A sent message swaps the form for a thank-you note; a failure is shown
 * just above the button the reader pressed, so neither one moves the page out
 * from under them. While the request is in flight the button says so.
 *
 * `?topic=<key>` preselects a topic, so a link elsewhere on the site can open
 * the form on the right one.
 *
 * Kept as a string because the markup below sits inside a conditional
 * expression, where an element's children are parsed as JSX rather than as
 * script text.
 */
const RESULT_SCRIPT = `
  var form = document.querySelector('[data-contact-form]');
  var submit = document.querySelector('[data-contact-submit]');
  var count = document.querySelector('[data-contact-count]');
  var body = document.querySelector('[data-contact-body]');
  var challengeCode = document.querySelector('[data-challenge-code]');
  var done = document.querySelector('[data-contact-done]');
  var again = document.querySelector('[data-contact-again]');
  var label = document.querySelector('[data-contact-label]');
  var idleLabel = label ? label.textContent : '';
  var RESULTS = ['sent', 'challenge', 'invalid', 'toofast', 'unavailable', 'network', 'widget'];

  function reveal(element) {
    var box = element.getBoundingClientRect();
    if (box.top < 80 || box.bottom > window.innerHeight) {
      element.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }
  }
  function show(result) {
    var sent = result === 'sent';
    if (form) form.hidden = sent;
    if (done) done.hidden = !sent;
    document.querySelectorAll('[data-message]').forEach(function (message) {
      message.hidden = message.getAttribute('data-message') !== result;
    });
    if (sent && done) {
      reveal(done);
      done.focus({ preventScroll: true });
      return;
    }
    var message = document.querySelector('[data-message="' + result + '"]');
    if (message) reveal(message);
  }
  function setReady(ready) {
    if (submit) submit.disabled = !ready;
  }
  function setBusy(busy) {
    if (!submit || !form) return;
    if (busy) {
      submit.setAttribute('aria-busy', 'true');
      form.setAttribute('aria-busy', 'true');
    } else {
      submit.removeAttribute('aria-busy');
      form.removeAttribute('aria-busy');
    }
    if (label) label.textContent = busy ? '送信しています…' : idleLabel;
  }

  if (again && form) {
    again.addEventListener('click', function () {
      show('');
      var first = form.querySelector('input:not([tabindex])');
      if (first) first.focus();
    });
  }

  var params = new URLSearchParams(location.search);
  var initial = params.get('sent') ? 'sent' : params.get('error');
  if (initial && RESULTS.indexOf(initial) !== -1) show(initial);
  var topic = document.querySelector('[data-contact-topic]');
  var preset = params.get('topic');
  if (topic && preset && topic.querySelector('option[value="' + CSS.escape(preset) + '"]')) {
    topic.value = preset;
  }

  window.contactTurnstileReady = function () {
    setReady(true);
    // A retry that went through clears the earlier failure.
    var failed = document.querySelector('[data-message="widget"]');
    if (failed) failed.hidden = true;
  };
  window.contactTurnstileReset = function () {
    setReady(false);
  };
  // Turnstile keeps retrying by itself; the code is shown so a reader can
  // report it and the cause can be told apart (Cloudflare docs: error codes).
  window.contactTurnstileError = function (code) {
    setReady(false);
    if (challengeCode) challengeCode.textContent = String(code || 'unknown');
    show('widget');
  };

  if (body && count) {
    var updateCount = function () { count.textContent = String(body.value.length); };
    body.addEventListener('input', updateCount);
    updateCount();
  }

  if (form && submit && window.fetch && window.FormData) {
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      if (submit.disabled) return;
      // Read before the fields are dimmed, while every value is still in it.
      var data = new FormData(form);
      submit.disabled = true;
      document.querySelectorAll('[data-message]').forEach(function (message) {
        message.hidden = true;
      });
      setBusy(true);
      var controller = window.AbortController ? new AbortController() : null;
      var timer = controller ? setTimeout(function () { controller.abort(); }, 30000) : 0;
      fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
        credentials: 'omit',
        signal: controller ? controller.signal : undefined,
      })
        .then(function (response) {
          return response.json().then(
            function (data) { return data && data.result; },
            function () { return 'unavailable'; }
          );
        })
        .catch(function () { return 'network'; })
        .then(function (result) {
          clearTimeout(timer);
          setBusy(false);
          if (RESULTS.indexOf(result) === -1) result = 'unavailable';
          if (result === 'sent') {
            form.reset();
            if (body && count) count.textContent = '0';
          }
          show(result);
          // A token is spent by any submission that reached the API, so a new
          // one is needed before the next try; the ready callback re-enables
          // the button when it arrives.
          setReady(false);
          if (window.turnstile) window.turnstile.reset();
        });
    });
  }
`;

const MESSAGES = [
  ["challenge", "error", "認証に失敗しました。もう一度お試しください。"],
  ["invalid", "error", "入力内容をご確認のうえ、もう一度お試しください。"],
  ["toofast", "error", "送信間隔が短すぎます。しばらく時間をおいてからお試しください。"],
  [
    "unavailable",
    "error",
    "ただいまお問い合わせを受け付けられませんでした。時間をおいてもう一度お試しください。",
  ],
  [
    "network",
    "error",
    "送信できませんでした。通信環境をご確認のうえ、もう一度お試しください。入力内容はそのまま残っています。",
  ],
] as const;
---

{turnstileSiteKey === "" ? (
  <p class="notice contact-form__notice">
    現在フォームを準備中です。お急ぎの場合はメールをご利用ください。
  </p>
) : (
  <div>
    <div
      class="contact-done"
      data-contact-done
      tabindex="-1"
      aria-labelledby="contact-done-title"
      hidden
    >
      <span class="contact-done__mark" aria-hidden="true"></span>
      <h2 id="contact-done-title">送信しました</h2>
      <p>
        お問い合わせありがとうございます。内容を拝見して、3〜5日ほどでご入力のメールアドレスへお返事します。
      </p>
      <p class="contact-done__hint">
        しばらく届かないときは、迷惑メールのフォルダもご確認ください。
      </p>
      <button type="button" data-contact-again>
        続けてもう一件送る
      </button>
    </div>

    <form class="contact-form" method="post" action={`${apiUrl}/v1/contact`} data-contact-form>
      <div class="contact-form__row">
        <label>
          <span>
            お名前 <small>必須</small>
          </span>
          <input
            type="text"
            name="name"
            required
            maxlength="100"
            autocomplete="name"
            placeholder="ともきち"
          />
        </label>
        <label>
          <span>
            メールアドレス <small>必須</small>
          </span>
          <input
            type="email"
            name="email"
            required
            maxlength="254"
            autocomplete="email"
            placeholder="you@example.com"
          />
        </label>
      </div>
      <label>
        <span>
          お問い合わせの種類 <small>必須</small>
        </span>
        <select name="subject" required data-contact-topic>
          <option value="" selected disabled>
            選択してください
          </option>
          {topics.map((topic) => (
            <option value={topic.key}>{topic.label}</option>
          ))}
        </select>
      </label>
      <label>
        <span>
          お問い合わせ内容 <small>必須</small>
        </span>
        <textarea
          name="body"
          rows="9"
          required
          minlength="10"
          maxlength="4000"
          placeholder="できるだけ具体的にご記入ください。"
          data-contact-body
        ></textarea>
        <small class="contact-form__count">
          <span data-contact-count>0</span> / 4000
        </small>
      </label>

      {/* Not shown to anyone reading the page; only automation fills it in. */}
      <div class="honeypot" aria-hidden="true">
        <label>
          <span>Website</span>
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <div class="contact-form__messages" role="status" aria-live="polite">
        {MESSAGES.map(([key, tone, text]) => (
          <p class:list={["form-message", `form-message--${tone}`]} data-message={key} hidden>
            {text}
          </p>
        ))}
        <p class="form-message form-message--error" data-message="widget" hidden>
          セキュリティ確認を完了できませんでした（コード: <span data-challenge-code></span>
          ）。ページを再読み込みするか、時間をおいてお試しください。解決しない場合はメールでご連絡ください。
        </p>
      </div>

      <div class="contact-form__verification">
        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-language="ja"
          data-action="contact"
          data-theme="light"
          data-appearance="interaction-only"
          data-callback="contactTurnstileReady"
          data-expired-callback="contactTurnstileReset"
          data-timeout-callback="contactTurnstileReset"
          data-error-callback="contactTurnstileError"
        />
        <p>送信ボタンを押す前に、セキュリティ確認を完了してください。</p>
      </div>
      <button type="submit" data-contact-submit disabled>
        <span data-contact-label>メッセージを送る</span>
        <span aria-hidden="true">→</span>
      </button>
    </form>

    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    ></script>
    <script is:inline set:html={RESULT_SCRIPT}></script>
  </div>
)}
