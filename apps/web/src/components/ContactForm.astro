---
import { apiUrl, turnstileSiteKey } from "../lib/site";

/**
 * Submitted with fetch so that any failure — a refused challenge, an API error,
 * no network — is shown next to the form with what was typed still in it. The
 * plain form POST below is only the fallback for a browser without fetch; the
 * API redirects that back here with the result in the query string. Turnstile
 * is the only third-party script on the page, and without a site key the form
 * is not rendered at all rather than shipped unprotected.
 *
 * Kept as a string because the markup below sits inside a conditional
 * expression, where an element's children are parsed as JSX rather than as
 * script text.
 */
const RESULT_SCRIPT = `
  var form = document.querySelector('[data-contact-form]');
  var submit = document.querySelector('[data-contact-submit]');
  var count = document.querySelector('[data-contact-count]');
  var body = document.querySelector('[data-contact-body]');
  var challengeCode = document.querySelector('[data-challenge-code]');
  var RESULTS = ['sent', 'challenge', 'invalid', 'toofast', 'unavailable', 'network', 'widget'];

  function show(result) {
    document.querySelectorAll('[data-message]').forEach(function (message) {
      message.hidden = message.getAttribute('data-message') !== result;
    });
    var message = document.querySelector('[data-message="' + result + '"]');
    if (message) message.scrollIntoView({ block: 'center' });
  }
  function setReady(ready) {
    if (submit) submit.disabled = !ready;
  }

  var params = new URLSearchParams(location.search);
  var initial = params.get('sent') ? 'sent' : params.get('error');
  if (initial && RESULTS.indexOf(initial) !== -1) show(initial);

  window.contactTurnstileReady = function () {
    setReady(true);
    // A retry that went through clears the earlier failure.
    var failed = document.querySelector('[data-message="widget"]');
    if (failed) failed.hidden = true;
  };
  window.contactTurnstileReset = function () {
    setReady(false);
  };
  // Turnstile keeps retrying by itself; the code is shown so a reader can
  // report it and the cause can be told apart (Cloudflare docs: error codes).
  window.contactTurnstileError = function (code) {
    setReady(false);
    if (challengeCode) challengeCode.textContent = String(code || 'unknown');
    show('widget');
  };

  if (body && count) {
    var updateCount = function () { count.textContent = String(body.value.length); };
    body.addEventListener('input', updateCount);
    updateCount();
  }

  if (form && submit && window.fetch && window.FormData) {
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      if (submit.disabled) return;
      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      var controller = window.AbortController ? new AbortController() : null;
      var timer = controller ? setTimeout(function () { controller.abort(); }, 30000) : 0;
      fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
        credentials: 'omit',
        signal: controller ? controller.signal : undefined,
      })
        .then(function (response) {
          return response.json().then(
            function (data) { return data && data.result; },
            function () { return 'unavailable'; }
          );
        })
        .catch(function () { return 'network'; })
        .then(function (result) {
          clearTimeout(timer);
          submit.removeAttribute('aria-busy');
          if (RESULTS.indexOf(result) === -1) result = 'unavailable';
          if (result === 'sent') {
            form.reset();
            if (body && count) count.textContent = '0';
          }
          show(result);
          // A token is spent by any submission that reached the API, so a new
          // one is needed before the next try; the ready callback re-enables
          // the button when it arrives.
          setReady(false);
          if (window.turnstile) window.turnstile.reset();
        });
    });
  }
`;

const MESSAGES = [
  ["sent", "ok", "お問い合わせを受け付けました。ありがとうございます。"],
  ["challenge", "error", "認証に失敗しました。もう一度お試しください。"],
  ["invalid", "error", "入力内容をご確認のうえ、もう一度お試しください。"],
  ["toofast", "error", "送信間隔が短すぎます。しばらく時間をおいてからお試しください。"],
  [
    "unavailable",
    "error",
    "ただいまお問い合わせを受け付けられませんでした。時間をおいてもう一度お試しください。",
  ],
  [
    "network",
    "error",
    "送信できませんでした。通信環境をご確認のうえ、もう一度お試しください。入力内容はそのまま残っています。",
  ],
] as const;
---

{turnstileSiteKey === "" ? (
  <p class="notice contact-form__notice">
    現在フォームを準備中です。お急ぎの場合はメールをご利用ください。
  </p>
) : (
  <div>
    {MESSAGES.map(([key, tone, text]) => (
      <p class:list={["form-message", `form-message--${tone}`]} data-message={key} hidden>
        {text}
      </p>
    ))}
    <p class="form-message form-message--error" data-message="widget" hidden>
      セキュリティ確認を完了できませんでした（コード: <span data-challenge-code></span>
      ）。ページを再読み込みするか、時間をおいてお試しください。解決しない場合はメールでご連絡ください。
    </p>

    <form class="contact-form" method="post" action={`${apiUrl}/v1/contact`} data-contact-form>
      <div class="contact-form__row">
        <label>
          <span>
            お名前 <small>必須</small>
          </span>
          <input
            type="text"
            name="name"
            required
            maxlength="100"
            autocomplete="name"
            placeholder="ともきち"
          />
        </label>
        <label>
          <span>
            メールアドレス <small>必須</small>
          </span>
          <input
            type="email"
            name="email"
            required
            maxlength="254"
            autocomplete="email"
            placeholder="you@example.com"
          />
        </label>
      </div>
      <label>
        <span>
          お問い合わせの種類 <small>必須</small>
        </span>
        <select name="subject" required>
          <option value="" selected disabled>
            選択してください
          </option>
          <option value="記事について">記事について</option>
          <option value="旅先・記事のリクエスト">旅先・記事のリクエスト</option>
          <option value="お仕事・取材の相談">お仕事・取材の相談</option>
          <option value="写真の利用について">写真の利用について</option>
          <option value="その他">その他</option>
        </select>
      </label>
      <label>
        <span>
          お問い合わせ内容 <small>必須</small>
        </span>
        <textarea
          name="body"
          rows="9"
          required
          minlength="10"
          maxlength="4000"
          placeholder="できるだけ具体的にご記入ください。"
          data-contact-body
        ></textarea>
        <small class="contact-form__count">
          <span data-contact-count>0</span> / 4000
        </small>
      </label>

      {/* Not shown to anyone reading the page; only automation fills it in. */}
      <div class="honeypot" aria-hidden="true">
        <label>
          <span>Website</span>
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <div class="contact-form__verification">
        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-language="ja"
          data-action="contact"
          data-theme="light"
          data-appearance="interaction-only"
          data-callback="contactTurnstileReady"
          data-expired-callback="contactTurnstileReset"
          data-timeout-callback="contactTurnstileReset"
          data-error-callback="contactTurnstileError"
        />
        <p>送信ボタンを押す前に、セキュリティ確認を完了してください。</p>
      </div>
      <button type="submit" data-contact-submit disabled>
        <span>メッセージを送る</span>
        <span aria-hidden="true">→</span>
      </button>
    </form>

    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    ></script>
    <script is:inline set:html={RESULT_SCRIPT}></script>
  </div>
)}
