---
import "../styles/global.css";
import { serializeJsonLd, type JsonLd, type PageMetadata } from "@tomokichi/seo";
import { seoConfig } from "../lib/site";

interface Props {
  metadata: PageMetadata;
  jsonLd?: (JsonLd | null)[];
  /** Wide layout for listings; narrow for reading. */
  width?: "narrow" | "wide";
}

const { metadata, jsonLd = [], width = "wide" } = Astro.props;
const structuredData = jsonLd.filter((node) => node !== null);
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const primaryNav = [
  { href: "/posts", label: "記事" },
  { href: "/destination", label: "旅先" },
  { href: "/trips", label: "旅の記録" },
  { href: "/series", label: "シリーズ" },
  { href: "/about", label: "About" },
];

const footerNav = [
  { href: "/faq", label: "よくある質問" },
  { href: "/contact", label: "お問い合わせ" },
  { href: "/gallery", label: "ギャラリー" },
  { href: "/legal/privacy", label: "プライバシーポリシー" },
  { href: "/legal/terms", label: "利用規約" },
  { href: "/legal/cookies", label: "クッキーポリシー" },
  { href: "/legal/editorial-policy", label: "執筆・編集ポリシー" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <meta name="robots" content={metadata.robots} />
    <link rel="canonical" href={metadata.canonical} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={seoConfig.siteName} href="/rss.xml" />
    {
      Object.entries(metadata.openGraph).map(([property, content]) => (
        <meta property={property} content={content} />
      ))
    }
    {
      Object.entries(metadata.twitter).map(([name, content]) => (
        <meta name={name} content={content} />
      ))
    }
    {
      structuredData.map((node) => (
        <script type="application/ld+json" set:html={serializeJsonLd(node)} />
      ))
    }
  </head>
  <body>
    <div class="shell">
      <a class="skip-link" href="#main">本文へスキップ</a>
      <header class="site-header">
        <div class="wrap site-header__inner">
          <a class="site-header__brand" href="/">{seoConfig.siteName}</a>
          <nav class="site-nav" aria-label="メインナビゲーション">
            {
              primaryNav.map((item) => (
                <a
                  href={item.href}
                  aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
      </header>

      <main id="main">
        <div class:list={["wrap", width === "narrow" && "wrap--narrow"]}>
          <slot />
        </div>
      </main>

      <footer class="site-footer">
        <div class="wrap">
          <nav aria-label="フッターナビゲーション">
            {footerNav.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
          <p>© {new Date().getFullYear()} {seoConfig.siteName}</p>
        </div>
      </footer>
    </div>
  </body>
</html>
