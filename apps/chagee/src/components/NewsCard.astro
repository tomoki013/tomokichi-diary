---
import VerificationBadge from "./VerificationBadge.astro";
import { formatDate, NEWS_CATEGORY_LABEL } from "../lib/labels";
import type { News } from "../lib/types";

interface Props {
  item: News;
  compact?: boolean;
}

const { item, compact = false } = Astro.props;
---

<article class:list={["card news-card", { compact }]}>
  <a href={`/news/${item.slug}`} class="hit">
    <div class="meta">
      <time datetime={item.publishedAt}>{formatDate(item.publishedAt)}</time>
      <span class="tag plain">{NEWS_CATEGORY_LABEL[item.category]}</span>
      <VerificationBadge status={item.verificationStatus} />
    </div>
    <h3>{item.title}</h3>
    {!compact && <p class="summary">{item.summary}</p>}
  </a>
</article>

<style>
  .hit {
    display: block;
    padding: 14px 16px;
    color: inherit;
    text-decoration: none;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    font-size: 0.78rem;
    color: var(--text-sub);
  }
  h3 {
    font-size: 1.05rem;
    margin-top: 6px;
  }
  .hit:hover h3 {
    color: var(--red-ink);
    text-decoration: underline;
  }
  .summary {
    font-size: 0.88rem;
    color: var(--text-sub);
    margin-top: 6px;
    line-height: 1.7;
  }
</style>
