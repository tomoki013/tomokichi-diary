---
import { NAV, SITE } from "../lib/site";
---

<footer class="site-footer">
  <div class="skyline" aria-hidden="true">
    <svg viewBox="0 0 600 60" preserveAspectRatio="none">
      <path
        d="M0 60V44h30v-8h14v8h20V30h8v-8h6v8h8v14h26V36l10-10 10 10v8h22V20h4V8h4v12h4v24h30V34h18v10h28V28h12v16h24V38l16-14 16 14v6h22V16h10v28h30V32h20v12h18V40h10v-6h6v6h10v4h28V24l6-6 6 6v20h24V36h16v8h34V28h10v16h28v16z"
        fill="currentColor"
      ></path>
    </svg>
  </div>
  <div class="inner">
    <div class="wrap">
      <p class="name">
        {SITE.name}
        <span>（{SITE.status}）</span>
      </p>
      <p class="tagline">{SITE.tagline}</p>
      <ul class="links">
        {NAV.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
        <li>
          <a href="/about">このサイトについて</a>
        </li>
        <li>
          <a href="/policy">利用上の注意・非公式ポリシー</a>
        </li>
        <li>
          <a href="/contact">お問い合わせ</a>
        </li>
        <li>
          <a href={SITE.blogUrl}>ともきちの旅行日記</a>
        </li>
      </ul>
      <p class="disclaimer">
        {SITE.disclaimer}「CHAGEE」「霸王茶姬」の名称・商標は各権利者に帰属します。
      </p>
      <p class="copy">&copy; {SITE.publisher}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    color: var(--red-dark);
  }
  .skyline svg {
    display: block;
    width: 100%;
    height: 44px;
  }
  .inner {
    background: var(--red-dark);
    color: #f6e8e4;
    padding-block: 28px 36px;
    font-size: 0.86rem;
  }
  .name {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
  }
  .name span {
    font-size: 0.8rem;
    font-family: var(--sans);
    font-weight: 400;
    margin-left: 4px;
  }
  .tagline {
    margin-top: 6px;
    opacity: 0.9;
  }
  .links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px 16px;
    list-style: none;
    padding: 0;
    margin: 18px 0;
  }
  .links a {
    color: #fff;
    display: inline-block;
    padding-block: 8px;
  }
  .disclaimer {
    border-top: 1px solid rgb(255 255 255 / 20%);
    padding-top: 14px;
    font-size: 0.78rem;
    opacity: 0.9;
  }
  .copy {
    /* Room for the floating official-site stamp. */
    padding-bottom: 72px;
    margin-top: 10px;
    font-size: 0.75rem;
    opacity: 0.75;
  }
  @media (min-width: 720px) {
    .links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
