---
import type { Crumb } from "../lib/seo";

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav class="wrap crumbs" aria-label="パンくずリスト">
  <ol>
    <li>
      <a href="/">ホーム</a>
    </li>
    {crumbs.map((crumb, index) => (
      <li>
        {index === crumbs.length - 1 ? (
          <span aria-current="page">{crumb.name}</span>
        ) : (
          <a href={crumb.href}>{crumb.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 12px 0 0;
    font-size: 0.78rem;
    color: var(--text-sub);
  }
  .crumbs li + li::before {
    content: "/";
    margin-inline: 6px;
    color: var(--border);
  }
  .crumbs a {
    color: var(--text-sub);
  }
</style>
