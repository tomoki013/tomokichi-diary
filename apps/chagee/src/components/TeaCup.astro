---
import { TEA_TINT } from "../lib/labels";
import type { MilkType, TeaBase } from "../lib/types";

/** An original cup illustration tinted by tea base — not the brand's cup or logo. */
interface Props {
  tea: TeaBase;
  milk: MilkType;
  size?: number;
}

const { tea, milk, size = 72 } = Astro.props;
const tint = TEA_TINT[tea];
const id = `cup-${tea}-${milk}`;
---

<svg width={size} height={size * 1.25} viewBox="0 0 64 80" aria-hidden="true" class="cup">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={tint}></stop>
      <stop offset={milk === "none" ? "1" : "0.55"} stop-color={tint}></stop>
      {milk !== "none" && <stop offset="1" stop-color="#f6efe6" />}
    </linearGradient>
  </defs>
  <rect x="10" y="6" width="44" height="7" rx="3" fill="#2d211c"></rect>
  <path d="M12 15h40l-4.4 56a5 5 0 0 1-5 4.6H21.4a5 5 0 0 1-5-4.6z" fill={`url(#${id})`}></path>
  <path d="M14.6 40h34.8l-1.3 17H15.9z" fill="#b61e24"></path>
  <circle cx="32" cy="48.5" r="5.5" fill="none" stroke="#fffdfb" stroke-width="1.4"></circle>
  <path
    d="M29 48.5c1-1.4 2-1.4 3 0s2 1.4 3 0"
    stroke="#fffdfb"
    stroke-width="1.2"
    fill="none"
  ></path>
</svg>
