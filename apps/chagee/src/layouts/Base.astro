---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../lib/site";
import {
  absoluteUrl,
  breadcrumbLd,
  clampDescription,
  pageTitle,
  serializeLd,
  websiteLd,
  type Crumb,
  type PageMeta,
} from "../lib/seo";

interface Props {
  meta: PageMeta;
  crumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
}

const { meta, crumbs = [], jsonLd = [] } = Astro.props;
const title = pageTitle(meta.title);
const description = clampDescription(meta.description);
const canonical = absoluteUrl(meta.path);
const image = absoluteUrl(meta.image ?? "/og.png");
const structured = [
  ...(meta.path === "/" ? [websiteLd()] : []),
  ...(crumbs.length > 0 ? [breadcrumbLd([{ name: "ホーム", href: "/" }, ...crumbs])] : []),
  ...jsonLd,
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {meta.noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#b61e24" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} 最新情報`}
      href="/news/rss.xml"
    />
    <meta property="og:site_name" content={`${SITE.name}（非公式）`} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={meta.type ?? "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    {meta.publishedAt && <meta property="article:published_time" content={meta.publishedAt} />}
    {meta.updatedAt && <meta property="article:modified_time" content={meta.updatedAt} />}
    {structured.map((data) => (
      <script is:inline type="application/ld+json" set:html={serializeLd(data)}></script>
    ))}
  </head>
  <body>
    <a class="skip" href="#main">
      本文へスキップ
    </a>
    <Header current={meta.path} />
    <main id="main">
      {crumbs.length > 0 && <Breadcrumbs crumbs={crumbs} />}
      <slot />
    </main>
    <Footer />
  </body>
</html>
