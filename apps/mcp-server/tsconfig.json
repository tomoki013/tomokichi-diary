{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "WebWorker"],
    "types": ["@cloudflare/workers-types"],
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "operator/client.ts",
    "operator/server.ts",
    "../admin/src/lib/ad-client.ts",
    "../admin/src/lib/ad-standard.ts",
    "../admin/src/lib/ad-test.ts",
    "../admin/src/lib/draft.ts"
  ],
  // This test runs the API's own analytics handler over node:sqlite to prove the
  // MCP returns the admin's numbers unchanged; like apps/api's tests, it is
  // type-checked by vitest rather than by this Workers-only project.
  "exclude": ["src/__tests__/analytics.test.ts"]
}
