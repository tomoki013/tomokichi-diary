{
  "name": "@tomokichi/mcp-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "vite build && tsx scripts/verify-ui.ts",
    "build": "pnpm build:ui && tsc --noEmit -p tsconfig.json",
    "dev": "pnpm build:ui && wrangler dev",
    "deploy": "pnpm build:ui && wrangler deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tomokichi/application": "workspace:*",
    "agents": "^0.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "tsx": "^4.20.6",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.45.0"
  }
}
