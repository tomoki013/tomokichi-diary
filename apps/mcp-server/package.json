{
  "name": "@tomokichi/mcp-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "vite build && tsx scripts/verify-ui.ts",
    "build": "pnpm build:ui && tsc --noEmit -p tsconfig.json && tsc --noEmit -p operator",
    "build:content": "tsc --build ../../infrastructure/database/d1 && pnpm build",
    "operator": "tsx operator/main.ts",
    "dev": "pnpm build:ui && cf-wrangler dev",
    "deploy": "pnpm build:ui && cf-wrangler build && cf deploy --prebuilt",
    "deploy:built": "cf-wrangler build && cf deploy --prebuilt",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "@tomokichi/application": "workspace:*",
    "@tomokichi/contracts": "workspace:*",
    "@tomokichi/infra-d1": "workspace:*",
    "agents": "^0.30.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "cf": "1.0.0-beta.20",
    "tsx": "^4.20.6",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
