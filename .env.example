# Public site
PUBLIC_SITE_URL=https://tomokichidiary.com
# Set to false for preview and staging builds: every page becomes noindex and
# robots.txt disallows everything.
PUBLIC_INDEXABLE=true
# Media origin. Until media.tomokichidiary.com is attached to the R2 bucket,
# builds use the bucket's r2.dev URL.
PUBLIC_MEDIA_URL=https://media.tomokichidiary.com
# Pins "now" so a rebuild of the same commit is byte-identical. Optional.
PUBLIC_BUILD_TIME=

# Admin UI
VITE_API_URL=http://localhost:8787

# API (set on the Worker with `wrangler secret put`, never committed)
# ADMIN_TOKEN=
# ALLOWED_ORIGINS=https://admin.tomokichidiary.com
