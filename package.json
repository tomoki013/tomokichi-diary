{
  "name": "tomokichi-diary",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint . && eslint apps/web",
    "typecheck": "tsc --build --pretty false && tsc -p scripts --pretty false && tsc -p apps/admin --pretty false",
    "test": "vitest run",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "ci": "tsx scripts/ci.ts",
    "diagnostics": "tsx scripts/diagnostics.ts",
    "check:routes": "tsx scripts/check-routes.ts",
    "check:seo": "tsx scripts/check-seo.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:knowledge": "tsx scripts/check-knowledge.ts",
    "perf": "tsx scripts/perf.ts",
    "baseline": "tsx scripts/legacy-baseline.ts",
    "export:data": "tsx scripts/export-data.ts",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "seed:sql": "tsx scripts/seed-d1.ts",
    "db:migrate": "pnpm --filter @tomokichi/api exec wrangler d1 migrations apply tomokichi-diary --remote",
    "db:seed": "pnpm seed:sql && pnpm --filter @tomokichi/api exec wrangler d1 execute tomokichi-diary --remote --file=../../.artifacts/seed.sql",
    "deploy:web": "pnpm --filter @tomokichi/web exec wrangler deploy",
    "deploy:admin": "pnpm --filter @tomokichi/admin exec wrangler deploy",
    "deploy:api": "pnpm --filter @tomokichi/api exec wrangler deploy",
    "verify:live": "tsx scripts/verify-live.ts",
    "media:build": "tsx scripts/media-build.ts",
    "media:sync": "tsx scripts/media-sync.ts"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@tomokichi/application": "workspace:*",
    "@tomokichi/contracts": "workspace:*",
    "@tomokichi/data": "workspace:*",
    "@tomokichi/domain": "workspace:*",
    "@tomokichi/infra-d1": "workspace:*",
    "@tomokichi/infra-r2": "workspace:*",
    "@tomokichi/seo": "workspace:*",
    "@types/node": "^26.4.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "oxlint": "^1.44.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.4",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
